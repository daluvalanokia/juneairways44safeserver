@model IEnumerable<AirwaysMergeSafeServer.Models.AirCarEntry>
@{
    ViewData["Title"] = "AirCar Vehicle Registry";
    var types = new[]{"all","evtol","hybrid","gyrocopter","vtol_jet"};
}

<div class="mss-page-header">
    <div>
        <h2 class="mss-page-title">✈ AirCar Vehicle Registry</h2>
        <p class="mss-page-sub">@Model.Count() air vehicle makes &amp; models — icons, logos, and specs used by the 3D Air Scene</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <a href="/AirScene" class="btn btn-sm btn-outline-info">🌍 3D Air Scene</a>
        <a href="/AirCars/Create" class="btn btn-sm btn-success">➕ Add AirCar</a>
    </div>
</div>

<div class="d-flex gap-2 flex-wrap mb-2">
    @foreach (var t in types)
    {
        <button class="btn btn-sm @(t=="all"?"btn-primary":"btn-outline-secondary") type-filter-btn" data-type="@t">
            @(t == "all" ? "All Types" : char.ToUpper(t[0]) + t.Substring(1).Replace("_", " "))
        </button>
    }
</div>

<div class="mss-card mb-3">
    <div class="mss-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-airplane me-1"></i> AirCar Make &amp; Model Reference</span>
        <span class="text-muted small" id="countLabel">Showing @Model.Count() air cars</span>
    </div>
    <div class="table-responsive">
        <table class="table table-dark table-hover table-sm mb-0" id="airCarTable">
            <thead style="position:sticky;top:0;z-index:1;background:#0f1624;border-bottom:1px solid rgba(255,255,255,0.08)">
                <tr>
                    <th class="ps-3 text-center" style="width:5rem">Logo</th>
                    <th>Make</th>
                    <th>Model</th>
                    <th style="width:8rem">Type</th>
                    <th style="width:5rem">Size</th>
                    <th>Color Palette</th>
                    <th class="text-end" style="width:10rem">Wingspan (m)</th>
                    <th class="text-end" style="width:10rem">Max Alt (m)</th>
                    <th class="text-end" style="width:10rem">Cruise (mph)</th>
                    <th class="text-center pe-3" style="width:8rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    var typeCss = v.Type switch {
                        "evtol"      => "bg-info text-dark",
                        "hybrid"     => "bg-primary",
                        "gyrocopter" => "bg-success",
                        "vtol_jet"   => "bg-danger",
                        _            => "bg-dark"
                    };
                    var sizeCss = v.Size switch {
                        "small"  => "#22c55e",
                        "medium" => "#f59e0b",
                        "large"  => "#ef4444",
                        _        => "#94a3b8"
                    };
                    var colors = string.IsNullOrEmpty(v.ColorsJson)
                        ? new string[]{}
                        : System.Text.Json.JsonSerializer.Deserialize<string[]>(v.ColorsJson ?? "[]") ?? new string[]{};

                    <tr class="aircar-row" data-type="@v.Type">
                        <td class="ps-3 text-center align-middle">
                            <div class="d-flex flex-column align-items-center gap-1">
                                @if (!string.IsNullOrEmpty(v.BrandLogo))
                                {
                                    <img src="@v.BrandLogo" alt="@v.Make" width="36" height="36"
                                         style="border-radius:50%;flex-shrink:0" title="@v.Make @v.Model" />
                                }
                                <span style="font-size:1.1rem;line-height:1">@v.Icon</span>
                            </div>
                        </td>
                        <td class="fw-semibold align-middle">@v.Make</td>
                        <td class="align-middle">@v.Model</td>
                        <td class="align-middle">
                            <span class="badge @typeCss rounded-pill" style="font-size:.7rem;text-transform:capitalize">@v.Type.Replace("_", " ")</span>
                        </td>
                        <td class="align-middle">
                            <span class="badge rounded-pill" style="background:@sizeCss;color:#fff;font-size:.7rem">@v.Size</span>
                        </td>
                        <td class="align-middle">
                            <div class="d-flex gap-1 flex-wrap align-items-center">
                                @foreach (var c in colors)
                                {
                                    <span title="@c" style="display:inline-block;width:20px;height:20px;border-radius:50%;background:@c;
                                                 border:1.5px solid rgba(255,255,255,0.18);cursor:default;flex-shrink:0" class="color-swatch"></span>
                                }
                            </div>
                        </td>
                        <td class="text-end font-monospace small align-middle" style="color:#94a3b8">@v.WidthM.ToString("F1")</td>
                        <td class="text-end font-monospace small align-middle" style="color:#94a3b8">@v.MaxAltitudeM.ToString("F0")</td>
                        <td class="text-end font-monospace small align-middle" style="color:#94a3b8">@v.CruiseSpeedMph.ToString("F0")</td>
                        <td class="text-center align-middle pe-3">
                            <div class="d-flex gap-1 justify-content-center">
                                <a href="/AirCars/Details/@v.Id" class="btn btn-sm btn-outline-info py-0 px-1" title="Details">👁</a>
                                <a href="/AirCars/Edit/@v.Id" class="btn btn-sm btn-outline-warning py-0 px-1" title="Edit">✏</a>
                                <a href="/AirCars/Delete/@v.Id" class="btn btn-sm btn-outline-danger py-0 px-1" title="Delete">🗑</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-3">
    @{
        var byType = Model.GroupBy(v => v.Type).ToList();
        var typeIcons = new Dictionary<string,string> {
            {"evtol","✈"}, {"hybrid","🚗"}, {"gyrocopter","🚁"}, {"vtol_jet","🛩"}
        };
    }
    @foreach (var grp in byType)
    {
        var ico = typeIcons.GetValueOrDefault(grp.Key, "🛸");
        var cssClass = grp.Key switch {
            "evtol"      => "bg-info text-dark",
            "hybrid"     => "bg-primary",
            "gyrocopter" => "bg-success",
            "vtol_jet"   => "bg-danger",
            _            => "bg-dark"
        };
        <div class="col-6 col-md-4 col-lg-3">
            <div class="mss-card text-center py-3 type-summary-card" data-type="@grp.Key" style="cursor:pointer">
                <div style="font-size:2.4rem;line-height:1.1">@ico</div>
                <div class="fw-semibold mt-2" style="text-transform:capitalize">@grp.Key.Replace("_", " ")</div>
                <div class="mt-1">
                    <span class="badge @cssClass" style="font-size:.72rem">@grp.Count() models</span>
                </div>
                <div class="text-muted mt-1" style="font-size:.7rem">
                    @string.Join(" · ", grp.Select(v => v.Size).Distinct().OrderBy(s => s))
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
(function () {
    var filterBtns = document.querySelectorAll('.type-filter-btn');
    var rows       = document.querySelectorAll('.aircar-row');
    var countLabel = document.getElementById('countLabel');
    var cards      = document.querySelectorAll('.type-summary-card');

    function applyFilter(t) {
        filterBtns.forEach(function (b) {
            b.classList.toggle('btn-primary', b.dataset.type === t);
            b.classList.toggle('btn-outline-secondary', b.dataset.type !== t);
        });
        var visible = 0;
        rows.forEach(function (r) {
            var show = t === 'all' || r.dataset.type === t;
            r.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        countLabel.textContent = 'Showing ' + visible + ' air car' + (visible !== 1 ? 's' : '');
    }

    filterBtns.forEach(function (b) {
        b.addEventListener('click', function () { applyFilter(this.dataset.type); });
    });
    cards.forEach(function (c) {
        c.addEventListener('click', function () { applyFilter(this.dataset.type); });
    });
})();
</script>
}
