@model AirwaysMergeSafeServer.Models.AirCarEntry
@{
    ViewData["Title"] = $"AirCar: {Model.Make} {Model.Model}";
    var colors = string.IsNullOrEmpty(Model.ColorsJson)
        ? new string[]{}
        : System.Text.Json.JsonSerializer.Deserialize<string[]>(Model.ColorsJson ?? "[]") ?? new string[]{};
}

<div class="mss-page-header">
    <div>
        <h2 class="mss-page-title">✈ @Model.Make @Model.Model</h2>
        <p class="mss-page-sub">AirCar Registry — detailed specification</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/AirCars/Edit/@Model.Id" class="btn btn-sm btn-outline-warning">✏ Edit</a>
        <a href="/AirCars/Delete/@Model.Id" class="btn btn-sm btn-outline-danger">🗑 Delete</a>
        <a href="/AirCars" class="btn btn-sm btn-outline-secondary">← Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="mss-card text-center py-4">
            @if (!string.IsNullOrEmpty(Model.BrandLogo))
            {
                <img src="@Model.BrandLogo" alt="@Model.Make" width="96" height="96" style="border-radius:50%" />
            }
            <div style="font-size:3rem" class="mt-2">@Model.Icon</div>
            <h4 class="mt-2">@Model.Make</h4>
            <h5 class="text-muted">@Model.Model</h5>
            <div class="mt-2">
                <span class="badge bg-info text-dark">@Model.Type.Replace("_", " ")</span>
                <span class="badge bg-secondary">@Model.Size</span>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="mss-card">
            <div class="mss-card-header"><i class="bi bi-rulers me-1"></i> Technical Specifications</div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr><td class="text-muted" style="width:40%">Type</td><td class="fw-semibold">@Model.Type.Replace("_", " ")</td></tr>
                        <tr><td class="text-muted">Size</td><td class="fw-semibold">@Model.Size</td></tr>
                        <tr><td class="text-muted">Length</td><td class="fw-semibold">@Model.LengthM.ToString("F1") m</td></tr>
                        <tr><td class="text-muted">Wingspan</td><td class="fw-semibold">@Model.WidthM.ToString("F1") m</td></tr>
                        <tr><td class="text-muted">Height</td><td class="fw-semibold">@Model.HeightM.ToString("F1") m</td></tr>
                        <tr><td class="text-muted">Max Altitude</td><td class="fw-semibold">@Model.MaxAltitudeM.ToString("F0") m</td></tr>
                        <tr><td class="text-muted">Cruise Speed</td><td class="fw-semibold">@Model.CruiseSpeedMph.ToString("F0") mph</td></tr>
                        <tr><td class="text-muted">Created</td><td class="fw-semibold">@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        @if (colors.Length > 0)
        {
            <div class="mss-card mt-3">
                <div class="mss-card-header">Color Palette</div>
                <div class="card-body">
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var c in colors)
                        {
                            <span title="@c" style="display:inline-block;width:36px;height:36px;border-radius:50%;background:@c;
                                         border:2px solid rgba(255,255,255,0.18)"></span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
