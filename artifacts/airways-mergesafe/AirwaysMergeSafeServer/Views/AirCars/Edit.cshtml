@model AirwaysMergeSafeServer.Models.AirCarEntry
@{
    ViewData["Title"] = "Edit AirCar";
}

<div class="mss-page-header">
    <h2 class="mss-page-title">✏ Edit AirCar: @Model.Make @Model.Model</h2>
</div>

<div class="mss-card">
    <div class="mss-card-header"><i class="bi bi-airplane-fill me-1"></i> Edit AirCar Details</div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Make (Brand)</label>
                    <input asp-for="Make" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Model</label>
                    <input asp-for="Model" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Type</label>
                    <select asp-for="Type" class="form-select">
                        <option value="evtol">eVTOL</option>
                        <option value="hybrid">Hybrid</option>
                        <option value="gyrocopter">Gyrocopter</option>
                        <option value="vtol_jet">VTOL Jet</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Size</label>
                    <select asp-for="Size" class="form-select">
                        <option value="small">Small</option>
                        <option value="medium">Medium</option>
                        <option value="large">Large</option>
                    </select>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-2"><label class="form-label">Icon</label><input asp-for="Icon" class="form-control" maxlength="5" /></div>
                <div class="col-md-3"><label class="form-label">Colors (JSON)</label><input asp-for="ColorsJson" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label">Brand Logo</label><input asp-for="BrandLogo" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">Side View Logo</label><input asp-for="SideViewLogo" class="form-control" /></div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-3"><label class="form-label">Length (m)</label><input asp-for="LengthM" class="form-control" type="number" step="0.1" /></div>
                <div class="col-md-3"><label class="form-label">Wingspan (m)</label><input asp-for="WidthM" class="form-control" type="number" step="0.1" /></div>
                <div class="col-md-3"><label class="form-label">Height (m)</label><input asp-for="HeightM" class="form-control" type="number" step="0.1" /></div>
                <div class="col-md-3"><label class="form-label">Max Altitude (m)</label><input asp-for="MaxAltitudeM" class="form-control" type="number" step="10" /></div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-3"><label class="form-label">Cruise Speed (mph)</label><input asp-for="CruiseSpeedMph" class="form-control" type="number" step="1" /></div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-warning">💾 Save Changes</button>
                <a href="/AirCars" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
