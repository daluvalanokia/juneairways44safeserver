@model AirwaysMergeSafeServer.Models.AirCarEntry
@{
    ViewData["Title"] = "Add AirCar";
}

<div class="mss-page-header">
    <h2 class="mss-page-title">➕ Add New AirCar</h2>
    <p class="mss-page-sub">Register a new flying car / eVTOL in the AirCar Vehicle Registry</p>
</div>

<div class="mss-card">
    <div class="mss-card-header"><i class="bi bi-airplane-fill me-1"></i> AirCar Details</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Make (Brand)</label>
                    <input asp-for="Make" class="form-control" placeholder="e.g. Joby Aviation" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Model</label>
                    <input asp-for="Model" class="form-control" placeholder="e.g. S4" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Type</label>
                    <select asp-for="Type" class="form-select">
                        <option value="evtol">eVTOL</option>
                        <option value="hybrid">Hybrid</option>
                        <option value="gyrocopter">Gyrocopter</option>
                        <option value="vtol_jet">VTOL Jet</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Size</label>
                    <select asp-for="Size" class="form-select">
                        <option value="small">Small</option>
                        <option value="medium" selected>Medium</option>
                        <option value="large">Large</option>
                    </select>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-2">
                    <label class="form-label">Icon (emoji)</label>
                    <input asp-for="Icon" class="form-control" value="✈" maxlength="5" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Colors (JSON array)</label>
                    <input asp-for="ColorsJson" class="form-control" value='["#00bcd4","#ff6b35","#f5f5f5"]' />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Brand Logo (SVG data URI)</label>
                    <input asp-for="BrandLogo" class="form-control" placeholder="data:image/svg+xml;base64,..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Side View Logo (SVG data URI)</label>
                    <input asp-for="SideViewLogo" class="form-control" placeholder="data:image/svg+xml;base64,..." />
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-3">
                    <label class="form-label">Length (m)</label>
                    <input asp-for="LengthM" class="form-control" type="number" step="0.1" value="6.0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Wingspan (m)</label>
                    <input asp-for="WidthM" class="form-control" type="number" step="0.1" value="11.0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Height (m)</label>
                    <input asp-for="HeightM" class="form-control" type="number" step="0.1" value="2.5" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Max Altitude (m)</label>
                    <input asp-for="MaxAltitudeM" class="form-control" type="number" step="10" value="3000" />
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-3">
                    <label class="form-label">Cruise Speed (mph)</label>
                    <input asp-for="CruiseSpeedMph" class="form-control" type="number" step="1" value="150" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-success">➕ Create AirCar</button>
                <a href="/AirCars" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
