<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirwaysMergeSafeServer — @ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="mss-body">

@{
    var highways = ViewBag.Highways as List<AirwaysMergeSafeServer.Models.Highway>;
    var selectedHw = ViewBag.SelectedHighwayId as string ?? Context.Session.GetString("HighwayId");
    var currentCtrl   = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
    var nav = new (string Ctrl, string Icon, string Label)[]
    {
        ("dashboard",         "bi-speedometer2",     "Dashboard"),
        ("settings",          "bi-sign-intersection","Settings / Highways"),
        ("mergezones",        "bi-diagram-2",        "Merge Zones"),
        ("switchservers",     "bi-hdd-network",      "Switch Servers"),
        ("sensors",           "bi-camera-video",     "Sensor Devices"),
        ("triangulation",     "bi-triangle",         "Triangulation"),
        ("events",            "bi-activity",         "Vehicle Events"),
        ("traffic3d",         "bi-badge-3d",         "3D Traffic"),
        ("vehicles",          "bi-car-front",        "Vehicle Registry"),
        ("datainputformats",  "bi-plug",             "Data Input Formats"),
        ("users",             "bi-people",           "Users"),
        ("home",              "bi-info-circle",      "About / System Info"),
    };
}

<nav class="mss-sidebar" id="sidebar">
    <div class="mss-brand">
        <div class="mss-brand-icon"><i class="bi bi-broadcast-pin"></i></div>
        <span class="mss-brand-name">AirwaysMSS</span>
    </div>
    <div class="mss-nav">
        @foreach (var item in nav)
        {
            var active = currentCtrl == item.Ctrl ? "active" : "";
            <a href="/@(item.Ctrl == "dashboard" ? "Dashboard" : item.Ctrl == "mergezones" ? "MergeZones" : item.Ctrl == "switchservers" ? "SwitchServers" : item.Ctrl == "traffic3d" ? "Traffic3D" : item.Ctrl == "datainputformats" ? "DataInputFormats" : char.ToUpper(item.Ctrl[0]) + item.Ctrl.Substring(1))"
               class="mss-nav-item @active">
                <i class="bi @item.Icon mss-nav-icon"></i>
                <span>@item.Label</span>
            </a>
        }
    <a href="/AirScene"
       class="mss-nav-item @(currentCtrl == "airscene" ? "active" : "")">
        <i class="bi bi-wind mss-nav-icon"></i>
        <span>3D Air Scene</span>
    </a>
    <a href="/AirCars"
       class="mss-nav-item @(currentCtrl == "aircars" ? "active" : "")">
        <i class="bi bi-airplane mss-nav-icon"></i>
        <span>AirCar Registry</span>
    </a>
    @if (Context.Session.GetString("UserType") == "admin")
    {
        <a href="/DatabaseViewer"
           class="mss-nav-item @(currentCtrl == "databaseviewer" ? "active" : "")">
            <i class="bi bi-table mss-nav-icon"></i>
            <span>Database Viewer</span>
        </a>
    }
    </div>
    <div class="mss-sidebar-footer">
        <form method="post" action="/Portal/Logout" style="margin:0">
            @Html.AntiForgeryToken()
            <button type="submit" class="mss-nav-item" style="width:100%;background:none;border:none;cursor:pointer;text-align:left;padding:0">
                <i class="bi bi-box-arrow-left mss-nav-icon"></i>
                <span>Sign Out</span>
            </button>
        </form>
    </div>
</nav>

<main class="mss-main">
    <div class="mss-topbar">
        <button class="mss-sidebar-toggle d-md-none" id="sidebarToggle" aria-label="Toggle sidebar">
            <i class="bi bi-list fs-5"></i>
        </button>
        <div class="mss-live-dot"></div>
        <span class="mss-live-label">SYSTEM LIVE</span>
        <span class="text-muted small ms-2 d-none d-md-inline" id="liveClock"></span>

        @if (highways != null && highways.Any())
        {
            <form method="get" action="@("/" + (currentCtrl == "dashboard" ? "Dashboard" : currentCtrl == "mergezones" ? "MergeZones" : currentCtrl == "switchservers" ? "SwitchServers" : currentCtrl == "traffic3d" ? "Traffic3D" : currentCtrl == "datainputformats" ? "DataInputFormats" : char.ToUpper((currentCtrl ?? "d")[0]) + (currentCtrl ?? "dashboard").Substring(1)))" class="ms-auto d-flex align-items-center gap-2">
                <i class="bi bi-sign-intersection text-muted"></i>
                <select name="highwayId" class="form-select form-select-sm mss-hw-select" onchange="this.form.submit()" style="min-width:200px">
                    @foreach (var hw in highways)
                    {
                        <option value="@hw.HighwayId" selected="@(selectedHw == hw.HighwayId ? "selected" : null)">
                            @hw.Name
                        </option>
                    }
                </select>
            </form>
        }
        else
        {
            <span class="ms-auto text-muted small">@(Context.Session.GetString("FullName") ?? "Guest")</span>
        }
    </div>

    <div class="mss-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
<script src="~/js/site.js"></script>
<script>startLiveClock('liveClock');</script>
@await RenderSectionAsync("Scripts", required: false)

<!-- ══ In-App Trace Floating Panel ═════════════════════════════════ -->
<div id="inAppTracePanel" class="mss-trace-panel" style="display:none">
    <div class="mss-trace-header" onclick="toggleTracePanel()">
        <span class="mss-trace-title">
            <i class="bi bi-terminal-fill me-1"></i>In-App Trace
            <span id="mssTraceLevel" class="badge bg-secondary ms-1" style="font-size:.6rem">info</span>
        </span>
        <span class="mss-trace-toggle">
            <i class="bi bi-chevron-up" id="traceChevron"></i>
        </span>
    </div>
    <div id="mssTraceBody" class="mss-trace-body" style="display:none">
        <div id="mssTraceLines">
            <div class="mss-trace-line mss-trace-muted">No trace data yet.</div>
        </div>
        <button class="btn btn-outline-secondary btn-sm mt-1" onclick="clearTracePanel()">
            <i class="bi bi-eraser me-1"></i>Clear
        </button>
    </div>
    <div id="mssTraceTicker" class="mss-trace-ticker"></div>
</div>

<style>
.mss-trace-panel {
    position: fixed; bottom: 0; right: 0; z-index: 9999;
    width: 100vw; max-width: 100vw;
    background: rgba(17, 24, 39, 0.97);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 0;
    box-shadow: 0 -4px 24px rgba(0,0,0,0.5);
    font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
    font-size: 11px;
}
.mss-trace-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 6px 12px; cursor: pointer;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}
.mss-trace-title { color: #93c5fd; font-weight: 600; font-size: 12px; }
.mss-trace-toggle { color: rgba(255,255,255,0.5); }
.mss-trace-body {
    padding: 6px 12px; max-height: 350px; overflow-y: auto;
}
.mss-trace-line {
    padding: 3px 0; color: #cbd5e1;
    line-height: 1.5;
}
.mss-trace-line .mss-ts { color: #64748b; margin-right: 4px; }
.mss-trace-line .mss-lvl { margin-right: 4px; }
.mss-trace-line .mss-mod { color: #93c5fd; font-weight: 500; }
.mss-trace-line .mss-msg {
    color: #e2e8f0; display: block;
    padding-left: 8px; word-break: break-word;
    white-space: pre-wrap;
}
.mss-trace-line .mss-lvl-info { color: #60a5fa; }
.mss-trace-line .mss-lvl-warning { color: #fbbf24; }
.mss-trace-line .mss-lvl-error { color: #f87171; font-weight: 600; }
.mss-trace-muted { color: #64748b; font-style: italic; }
.mss-trace-ticker {
    padding: 4px 12px; min-height: 28px;
    border-top: 1px solid rgba(255,255,255,0.06);
}
.mss-trace-ticker .mss-trace-line {
    font-size: 11.5px; line-height: 1.5;
}
</style>

<script>
(function() {
    var _traceEnabled = false;
    var _traceLevel = 'info';
    var _traceExpanded = false;
    var _pollHandle = null;

    function pollTrace() {
        fetch('/Settings/TraceLatest?count=2')
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (!d || !d.enabled) {
                    document.getElementById('inAppTracePanel').style.display = 'none';
                    if (_pollHandle) { clearInterval(_pollHandle); _pollHandle = null; }
                    return;
                }
                document.getElementById('inAppTracePanel').style.display = '';
                document.getElementById('mssTraceLevel').textContent = d.level || 'info';

                // Render the ticker (last 2 lines, always visible)
                var ticker = document.getElementById('mssTraceTicker');
                var lines = d.lines || [];
                if (lines.length === 0) {
                    ticker.innerHTML = '<div class="mss-trace-line mss-trace-muted">Waiting for trace data…</div>';
                } else {
                    ticker.innerHTML = lines.map(function(l) {
                        var cls = l.level === 'ERROR' ? 'mss-lvl-error' :
                                  l.level === 'WARN'  ? 'mss-lvl-warning' : 'mss-lvl-info';
                        var mod = l.module ? '<span class="mss-mod">' + escapeHtml(l.module) + '.' + escapeHtml(l.method || '') + '</span> ' : '';
                        return '<div class="mss-trace-line">' +
                            '<div><span class="mss-ts">' + l.timestamp + '</span>' +
                            '<span class="' + cls + ' mss-lvl">[' + l.level + ']</span> ' +
                            mod + '</div>' +
                            '<span class="mss-msg">' + escapeHtml(l.message) + '</span>' +
                        '</div>';
                    }).join('');
                }

                // Also render the expanded body if open
                if (_traceExpanded) {
                    fetch('/Settings/TraceLatest?count=50')
                        .then(function(r) { return r.json(); })
                        .then(function(d2) {
                            var body = document.getElementById('mssTraceLines');
                            var allLines = d2.lines || [];
                            body.innerHTML = allLines.length === 0
                                ? '<div class="mss-trace-line mss-trace-muted">No trace data yet.</div>'
                                : allLines.map(function(l) {
                                    var cls = l.level === 'ERROR' ? 'mss-lvl-error' :
                                              l.level === 'WARN'  ? 'mss-lvl-warning' : 'mss-lvl-info';
                                    var mod = l.module ? '<span class="mss-mod">' + escapeHtml(l.module) + '.' + escapeHtml(l.method || '') + '</span> ' : '';
                                    return '<div class="mss-trace-line">' +
                                        '<div><span class="mss-ts">' + l.timestamp + '</span>' +
                                        '<span class="' + cls + ' mss-lvl">[' + l.level + ']</span> ' +
                                        mod + '</div>' +
                                        '<span class="mss-msg">' + escapeHtml(l.message) + '</span>' +
                                    '</div>';
                                }).join('');
                        }).catch(function(){});
                }
            })
            .catch(function() {
                // Network error — don't spam console
            });
    }

    function escapeHtml(s) {
        if (!s) return '';
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    // Start polling on page load
    pollTrace();
    _pollHandle = setInterval(pollTrace, 3000);

    // Expose toggle for the onclick handler
    window.toggleTracePanel = function() {
        _traceExpanded = !_traceExpanded;
        var body = document.getElementById('mssTraceBody');
        var chev = document.getElementById('traceChevron');
        body.style.display = _traceExpanded ? '' : 'none';
        chev.className = _traceExpanded ? 'bi bi-chevron-down' : 'bi bi-chevron-up';
    };

    window.clearTracePanel = function() {
        fetch('/Settings/TraceLatest?count=0').then(function() {
            document.getElementById('mssTraceLines').innerHTML =
                '<div class="mss-trace-line mss-trace-muted">Cleared.</div>';
        });
    };
})();
</script>
</body>
</html>
