        '<div><span style="color:#4ade80">Type:</span> ' + (vd.vc.category || '–') + '</div>' +
        '<div><span style="color:#4ade80">Speed:</span> ' + (vd.speedMph || 0).toFixed(1) + ' mph</div>' +
        '<div><span style="color:#4ade80">Lat/Lon:</span> ' + (vd.lat||0).toFixed(4) + ', ' + (vd.lon||0).toFixed(4) + '</div>' +
        '</div>';
}

_oc.addEventListener('click', function(e) {
    if (!_map || !_mapReady) return;
    var rect = _oc.getBoundingClientRect();
    var cx = e.clientX - rect.left, cy = e.clientY - rect.top;
    var origin = _map.getPixelOrigin();
    var closestVid = null, closestDist = 30;
    vehicleData.forEach(function(vd, vid) {
        var mapPt = _map.project([vd.lat, vd.lon], _map.getZoom());
        var sx = mapPt.x - origin.x, sy = mapPt.y - origin.y;
        var d = Math.hypot(cx - sx, cy - sy);
        if (d < closestDist) { closestDist = d; closestVid = vid; }
    });
    if (closestVid) showInspector(vehicleData.get(closestVid));
});

// ── Window resize ─────────────────────────────────────────────────────
window.addEventListener('resize', function() {
    if (_map) setTimeout(function() { if (_map) _map.invalidateSize(true); }, 50);
});

// ── Boot sequence ─────────────────────────────────────────────────────
(async function boot() {
    // 1. Init Leaflet map centred on zone GPS
    _initMap();
    _setHighwayCoords(_mapCtrLat, _mapCtrLon);

    // 2. Start 2D canvas render loop
    _renderLoop();

    // 3. Default to Top view (2D overlay + Leaflet map)
    setViewport('top');
    var topBtn = document.querySelector('#viewToggle [data-view="top"]');
    if (topBtn) {
        document.querySelectorAll('#viewToggle button').forEach(function(b) {
            b.classList.remove('active','btn-primary'); b.classList.add('btn-outline-primary');
        });
        topBtn.classList.add('active','btn-primary'); topBtn.classList.remove('btn-outline-primary');
    }

    // 4. Load pre-fetched events instantly (no waiting for first poll)
    if (_INITIAL_EVENTS && _INITIAL_EVENTS.length) loadEvents(_INITIAL_EVENTS);

    // 5. Check if sim was running (cross-tab restore)
    await _simRestoreState();

    // 6. Initial DB fetch
    await refreshScene();
})();

// ── Slow poll: 30s, live mode only ───────────────────────────────────
setInterval(function() { if (!simRunning && !feedHeld) refreshScene(); }, 30000);

</script>