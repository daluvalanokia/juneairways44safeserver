            });
        }
    }
    // Do NOT pan map, redraw bridge, or call refreshScene.
    // The animation view only updates when the Refresh button is clicked.
    console.log('[T3D] t3dServerChanged: srv=' + selectedServerId + ' — click Refresh to apply');
}


// ── Vehicle data management ───────────────────────────────────────────
function _clearVehicles() { vehicleData.clear(); }

// ── Zone GPS lookup helper ────────────────────────────────────────
// Returns a point snapped onto the highway corridor of the given zone:
//   EW highways: tight lat spread (±0.002°/220m), wide lon spread (±0.015°/1.5km)
//   NS highways: wide lat spread (±0.015°/1.5km), tight lon spread (±0.002°/220m)
function _snapToZone(zoneId) {
    var z = T3D_ZONES.find(function(zz) { return zz.zoneId === zoneId; });
    if (!z || !z.lat || !z.lon) return null;
    var hwId = z.highwayId || HW;
    // Always use the server-provided bearing — _hwBearing() now returns
    // _hwBearingDeg when it has been set from GetAnimationData response.
    var bearing = _hwBearing(hwId);
    var bearRad = bearing * Math.PI / 180;
    var cosLat = Math.cos(z.lat * Math.PI / 180);

    // Scatter along the real road bearing vector
    var along = (Math.random() - 0.5) * 0.020 * 2;   // ±1km along road
    var cross = (Math.random() - 0.5) * 0.00015 * 2;  // ±17m cross-road (1 lane)

    var dLatAlong = Math.cos(bearRad) * along;
    var dLonAlong = Math.sin(bearRad) * along / cosLat;
    var perpRad = bearRad + Math.PI / 2;
    var dLatCross = Math.cos(perpRad) * cross;
    var dLonCross = Math.sin(perpRad) * cross / cosLat;

    return {
        lat: z.lat + dLatAlong + dLatCross,
        lon: z.lon + dLonAlong + dLonCross,
        zone: z
    };
}

// ── Distance in degrees between two GPS points ────────────────────
function _gpsDist(lat1, lon1, lat2, lon2) {
    return Math.sqrt((lat1 - lat2) * (lat1 - lat2) + (lon1 - lon2) * (lon1 - lon2));
}

// ── Selected bounds: geographic limits for bridge + vehicle validation ──
// Returns {minLat, maxLat, minLon, maxLon, tight} or null if unconstrained.
//   tight = true when a specific zone/server is selected (stricter vehicle check)
function _getSelectedBounds() {
    if (!T3D_ZONES || T3D_ZONES.length === 0) return null;

    // If a specific zone is selected, compute bounds around just that zone
    if (selectedZoneId) {
        var z = T3D_ZONES.find(function(zz) { return zz.zoneId === selectedZoneId; });
        if (z && z.lat && z.lon) {
            // Buffer: ±0.06° (~6.6km) along the road, ±0.008° (~880m) across
            var alongAxis = 0.06;
            var crossAxis = 0.008;
            var isNS = !_isEWHighway(z.highwayId);
            if (isNS) {
                return {
                    minLat: z.lat - alongAxis, maxLat: z.lat + alongAxis,
                    minLon: z.lon - crossAxis, maxLon: z.lon + crossAxis,
                    tight: true, centerLat: z.lat, centerLon: z.lon
                };
            } else {
                return {
                    minLat: z.lat - crossAxis, maxLat: z.lat + crossAxis,
                    minLon: z.lon - alongAxis, maxLon: z.lon + alongAxis,
                    tight: true, centerLat: z.lat, centerLon: z.lon
                };
            }
        }
    }

    // No specific zone — compute bounds from ALL zones on the highway
    var lats = T3D_ZONES.filter(function(z) { return z.lat && z.lon; }).map(function(z) { return z.lat; });
    var lons = T3D_ZONES.filter(function(z) { return z.lat && z.lon; }).map(function(z) { return z.lon; });
    if (!lats.length) return null;

    var minLat = Math.min.apply(null, lats), maxLat = Math.max.apply(null, lats);
    var minLon = Math.min.apply(null, lons), maxLon = Math.max.apply(null, lons);

    // Expand by 15% padding so vehicles near the edge aren't clipped
    var padLat = (maxLat - minLat) * 0.15 || 0.01;
    var padLon = (maxLon - minLon) * 0.15 || 0.01;
    return {
        minLat: minLat - padLat, maxLat: maxLat + padLat,
        minLon: minLon - padLon, maxLon: maxLon + padLon,
        tight: false, centerLat: (minLat + maxLat) / 2, centerLon: (minLon + maxLon) / 2
    };
}

// ── Check if a GPS coordinate is within the selected highway/zone bounds ──
// Returns true if the point is valid, false if it should be rejected/snapped.

// ── Highway-level bounds (wider than zone bounds) ─────────────────────
// Used for clamping fallback vehicles that come from other zones on the
// same highway. Prevents cramming all vehicles into the selected zone.
function _getHighwayBounds() {
    if (!T3D_ZONES || T3D_ZONES.length === 0) return null;
    var lats = T3D_ZONES.filter(function(z) { return z.lat && z.lon; }).map(function(z) { return z.lat; });
    var lons = T3D_ZONES.filter(function(z) { return z.lat && z.lon; }).map(function(z) { return z.lon; });
    if (lats.length === 0) return null;
    var minLat = Math.min.apply(null, lats), maxLat = Math.max.apply(null, lats);
    var minLon = Math.min.apply(null, lons), maxLon = Math.max.apply(null, lons);
    // Add buffer: ±0.03° (~3.3km) beyond the outermost zones
    return {
        minLat: minLat - 0.03, maxLat: maxLat + 0.03,
        minLon: minLon - 0.03, maxLon: maxLon + 0.03
    };
}

function _isWithinHighwayBounds(lat, lon, hb) {
    if (!hb) return true;
    return lat >= hb.minLat && lat <= hb.maxLat && lon >= hb.minLon && lon <= hb.maxLon;
}

function _isWithinBounds(lat, lon) {
    var b = _getSelectedBounds();
    if (!b) return true;  // No zones loaded — accept everything
    return lat >= b.minLat && lat <= b.maxLat && lon >= b.minLon && lon <= b.maxLon;
}

// ── Snap a coordinate into the selected bounds if it's outside ──
function _clampToBounds(lat, lon) {
    var b = _getSelectedBounds();
    if (!b) return { lat: lat, lon: lon };
    return {
        lat: Math.max(b.minLat, Math.min(b.maxLat, lat)),
        lon: Math.max(b.minLon, Math.min(b.maxLon, lon))
    };
}

function loadEvents(events) {
    if (!events || !events.length) { console.log('[T3D] loadEvents: none'); return; }
    console.log('[T3D] loadEvents:', events.length, 'simRunning=' + simRunning);
    var now = Date.now();
    events.forEach(function(ev) {
        // Accept both snake_case (sim payloads) and camelCase/PascalCase (DB API)
        var vid = ev.vehicle_id || ev.vehicleId || ev.VehicleId || '';
        if (!vid) return;
        // ── Sim-mode filter: reject non-simulation vehicles ──────────────
        // When simRunning is true, only accept vehicles with IDs starting
        // with "SIM-". This prevents historical/synthetic/test vehicles
        // from polluting the sim animation scene.
        if (simRunning && vid.indexOf('SIM-') !== 0) {
            console.log('[T3D] loadEvents: REJECTED non-sim vehicle ' + vid + ' (sim is ON)');
            return;
        }
        // ── Vehicle acceptance filter ──────────────────────────────────────
        // The server (GetAnimationData) already filters by zone/server with
        // a highway-level fallback when the zone has 0 events. Do NOT re-filter
        // by zone on the client side — that rejects the fallback vehicles and
        // clears the animation. Only filter by highway (never changes within a scene).
        var evHwCheck = (ev.highway_id || ev.highwayId || ev.HighwayId || '').toUpperCase();
        if (evHwCheck && HW && evHwCheck !== HW.toUpperCase() && !simRunning) return;
        var lat = parseFloat(ev.latitude  || ev.Latitude  || 0);
        var lon = parseFloat(ev.longitude || ev.Longitude || 0);
        var spd  = parseFloat(ev.speed_mph || ev.speedMph || ev.SpeedMph || 0);
        var make = ev.vehicle_make || ev.vehicleMake || ev.VehicleMake || ev.make ||
                   (ev.classification && ev.classification.make) || '';
        var vc   = classifyVehicle(ev);

        // Resolve the zone this vehicle belongs to
        var evZoneId = ev.zone_id || ev.zoneId || ev.ZoneId || '';
        var zone = T3D_ZONES.find(function(zz) { return zz.zoneId === evZoneId; });

        // Validate GPS — check against selected highway/zone/server bounds
        var needsSnap = false;
        var selB = _getSelectedBounds();
        if (!lat || !lon || isNaN(lat) || isNaN(lon) || (lat === 0 && lon === 0)) {
            needsSnap = true;
        } else if (zone && zone.lat && zone.lon) {
            // If the GPS is more than 0.08° (~8km) from zone centre it's bogus — snap it
            var dist = _gpsDist(lat, lon, zone.lat, zone.lon);
            if (dist > 0.08) needsSnap = true;
        } else if (selB && !_isWithinBounds(lat, lon)) {
            // Outside the selected highway bounds — snap it
            needsSnap = true;
        }

        // If a specific zone is selected (tight bounds), only snap if the vehicle
        // is truly far away (>0.15°/~16km). Fallback vehicles from other zones
        // on the same highway should keep their GPS and animate naturally.
        if (!needsSnap && selB && selB.tight) {
            var zoneDist = _gpsDist(lat, lon, selB.centerLat, selB.centerLon);
            if (zoneDist > 0.15) needsSnap = true;
        }

        if (needsSnap) {
            // Try snapping to the bridge path first
            var bpSnap = _nearestOnBridgePath(lat, lon);
            if (bpSnap && bpSnap.perpDist > _bridgeRoadWidth) {
                lat = bpSnap.clampedLat;
                lon = bpSnap.clampedLon;
            } else if (zone) {
                var snapped = _snapToZone(evZoneId);
                if (snapped) {
                    lat = snapped.lat; lon = snapped.lon;
                }
            } else if (selB) {
                // Snap to the center of the selected bounds with highway-aligned jitter
                var snapped2 = _snapToZone(selectedZoneId || (T3D_ZONES[0] && T3D_ZONES[0].zoneId) || '');
                if (snapped2) { lat = snapped2.lat; lon = snapped2.lon; }
                else {
                    var clamped = _clampToBounds(_mapCtrLat, _mapCtrLon);
                    lat = clamped.lat + (Math.random() - 0.5) * 0.004;
                    lon = clamped.lon + (Math.random() - 0.5) * 0.010;
                }
            } else {
                // No zones loaded — use current map centre with tiny jitter
                lat = _mapCtrLat + (Math.random() - 0.5) * 0.008;
                lon = _mapCtrLon + (Math.random() - 0.5) * 0.020;
            }
        }

        // ── Respect sim GPS coordinates when valid ──────────────────────────
        // The InputPayloadService generates GPS from zone coordinates with
        // proper lane offsets. Only project onto the bridge path when the
        // GPS is clearly bogus (0,0 or already flagged for snap). Otherwise
        // keep the original coordinates — the sim knows where the vehicle is.
        if (needsSnap && _bridgePathCoords.length >= 2) {
            var bpClamp = _nearestOnBridgePath(lat, lon);
            if (bpClamp) {
                var laneSide = (Math.random() > 0.5) ? _bridgeRoadWidth : -_bridgeRoadWidth;
                var perpRad  = bpClamp.bearing * Math.PI / 180 + Math.PI / 2;
                var cosLat2  = Math.cos(bpClamp.lat * Math.PI / 180);
                lat = bpClamp.lat + Math.cos(perpRad) * laneSide;
                lon = bpClamp.lon + Math.sin(perpRad) * laneSide / cosLat2;
            }
        }
        // If GPS was valid (not snapped), keep original lat/lon from sim.
        // The bridge path projection was too aggressive — it moved vehicles
        // to different coordinates, ignoring the sim's lane placement.

        // Final safety: only clamp if vehicle is outside the HIGHWAY bounds
        // (not the tight zone bounds — fallback vehicles from other zones
        //  should be visible across the full highway, not crammed into one zone)
        if (selB && selB.tight) {
            // For tight (zone-selected) mode, use wider highway-level bounds for clamping
            var hwBounds = _getHighwayBounds();
            if (hwBounds && !_isWithinHighwayBounds(lat, lon, hwBounds)) {
                lat = Math.max(hwBounds.minLat, Math.min(hwBounds.maxLat, lat));
                lon = Math.max(hwBounds.minLon, Math.min(hwBounds.maxLon, lon));
            }
        } else if (selB && !_isWithinBounds(lat, lon)) {
            var clamped2 = _clampToBounds(lat, lon);
            lat = clamped2.lat; lon = clamped2.lon;
        }

        var dir = parseFloat(ev.direction || ev.Direction || ev.heading || ev.Heading || -1);
        if (isNaN(dir) || dir < 0) dir = -1;
        var hwId = (ev.highway_id || ev.highwayId || ev.HighwayId || '').toUpperCase();
        var isNSHwy = hwId.indexOf('I35') >= 0 || hwId.indexOf('I-35') >= 0 ||
                      hwId.indexOf('I45') >= 0 || hwId.indexOf('I-45') >= 0 ||
                      hwId.indexOf('I25') >= 0 || hwId.indexOf('I-25') >= 0;
        // ── Trust the sim's direction ──────────────────────────────────────
        // The InputPayloadService already generates direction aligned with the
        // real highway bearing (highwayBearing or reverse). Do NOT reassign it
        // based on _hwBearingDeg — that value may not be updated from the server
        // yet (default 90°), which would reject valid directions for N-S highways.
        // Only assign a fallback if direction is truly missing (< 0 or NaN).
        if (dir < 0) {
            var _brg = _hwBearingDeg;
            var _brgRev = (_brg + 180) % 360;
            dir = (Math.random() > 0.5) ? Math.round(_brg) : Math.round(_brgRev);
        }
        var existing = vehicleData.get(vid);
        if (existing && !isNaN(existing.lat) && !isNaN(existing.lon)
                     && existing.lat !== 0 && existing.lon !== 0
                     && existing.zoneLat === (zone ? zone.lat : null)) {
            // Vehicle already animated — preserve current GPS position,
            // only update speed/metadata. Keep the original direction to
            // prevent flipping — the sim now generates deterministic direction
            // per vehicle ID, but keep this guard for safety.
            existing.ev       = ev;
            existing.vc       = vc;
            existing.speedMph = spd;
            existing.make     = make;
            // Only update direction if the sim provides one AND it's
            // different from the current — don't flip just because
            // a new event arrived.
            if (dir >= 0 && Math.abs(dir - (existing.direction || 0)) > 1) {
                existing.direction = dir;
            }
            existing.isNSHwy  = isNSHwy;
            existing.lastSeen = now;
        } else {
            // New vehicle or zone changed — set full initial state
            vehicleData.set(vid, { ev: ev, vc: vc, lat: lat, lon: lon, speedMph: spd, make: make,
                                   direction: dir,
                                   isNSHwy: isNSHwy,
                                   laneSide: (Math.random() > 0.5) ? 1 : -1,
                                   zoneLat: zone ? zone.lat : null,
                                   zoneLon: zone ? zone.lon : null,
                                   lastSeen: now });
        }
    });
    // Prune stale vehicles — 30s during sim (fast turnover), 120s idle
    var pruneMs = simRunning ? 30000 : 120000;
    vehicleData.forEach(function(vd, vid) {
        if (now - vd.lastSeen > pruneMs) vehicleData.delete(vid);
    });
    _updateStatsBar();
    
    // Auto-pan: only during active simulation and only if the vehicle is
    // more than 50% outside the visible bounds (avoid map drift on DB events)
    if (simRunning && _map && _mapReady && events.length > 0) {
        var lastEv = events[events.length - 1];
        var lastLat = parseFloat(lastEv.latitude || lastEv.Latitude || 0);
        var lastLon = parseFloat(lastEv.longitude || lastEv.Longitude || 0);
        if (lastLat && lastLon) {
            var bounds = _map.getBounds();
            if (!bounds.contains([lastLat, lastLon])) {
                // Only pan slightly — don't chase every vehicle aggressively
                var curCtr = _map.getCenter();
                var newLat = curCtr.lat + (lastLat - curCtr.lat) * 0.1;
                var newLon = curCtr.lng + (lastLon - curCtr.lng) * 0.1;
                _map.panTo([newLat, newLon], { animate: false });
                _mapCtrLat = newLat; _mapCtrLon = newLon;
            }
        }
    }
}

function _updateStatsBar() {
    var el = document.getElementById('statGround');
    if (el) el.textContent = vehicleData.size;
    var hw = document.getElementById('statHighway');
    if (hw) hw.textContent = HW || '–';
}

// ── DB scene refresh ──────────────────────────────────────────────────
// ── Server-side animation data fetch ────────────────────────────────
// Polls the controller's GetAnimationData endpoint for pre-validated
// vehicle coordinates + highway zone coordinates.
var _serverBounds = null;


// ── Refresh Animation Button ───────────────────────────────────────────
// Syncs T3D dropdowns to simulation context (if sim is running) and
// loads the animation. Requires all 3 values (highway + zone + server).
async function refreshAnimation() {
    console.log('[T3D] refreshAnimation: called — checking simulation status');

    // ── STEP 1: CHECK SIMULATION STATUS (DB is authoritative) ──
    var simActive = false;
    var dbStatusOk = false;
    var simCtx = null;
    try { simCtx = JSON.parse(localStorage.getItem('airways_sim_context') || 'null'); } catch(e) {}

    try {
        var sr = await fetch('/DataInputFormats/SimulationStatus');
        if (sr.ok) {
            var dbStatus = await sr.json();
            dbStatusOk = true;
            simActive = dbStatus.isRunning && !dbStatus.stale;
            console.log('[T3D] refreshAnimation: DB sim status = running=' + simActive +
                ' stale=' + dbStatus.stale + ' total=' + (dbStatus.totalPosted || 0));
        }
    } catch(e) { console.warn('[T3D] refreshAnimation: sim status check failed', e); }

    // ── If DB says sim is OFF, clear ALL stale sim localStorage ──
    // This prevents the "sim is on even after app stops" issue. The DB
    // is the source of truth — if it says NOT running, we clear all
    // client-side sim state and treat the session as non-sim.
    if (dbStatusOk && !simActive) {
        localStorage.removeItem('airways_sim_state');
        localStorage.removeItem('airways_sim_active');
        localStorage.removeItem('airways_sim_heartbeat');
        // Keep airways_sim_context for dropdown restoration, but don't
        // use it to trigger sim mode.
        if (simRunning) {
            console.log('[T3D] refreshAnimation: DB says sim OFF — clearing stale sim state');
            simRunning = false; feedHeld = false;
            var badge = document.getElementById('simFeedBadge');
            if (badge) badge.style.display = 'none';
        }
    }

    // ── STEP 2: IF SIM IS ON — sync to sim context ──
    // Only use localStorage fallback if the DB status check FAILED
    // (network error, server down). If the DB said sim is OFF, we
    // respect that — no localStorage override.
    var useLocalFallback = !dbStatusOk;
    if (useLocalFallback) {
        var localSimActive = localStorage.getItem('airways_sim_active') === 'true';
        var simHeartbeat = parseInt(localStorage.getItem('airways_sim_heartbeat') || '0');
        var heartbeatAge = Date.now() - simHeartbeat;
        var heartbeatFresh = simHeartbeat > 0 && heartbeatAge < 120000;
        if (localSimActive && heartbeatFresh && simCtx && simCtx.hwId) {
            simActive = true;
            console.log('[T3D] refreshAnimation: DB check failed — using localStorage fallback (sim ON)');
        }
    }
    if (simActive && simCtx && simCtx.hwId) {
        console.log('[T3D] refreshAnimation: SIM IS ON — syncing to sim context', simCtx);

        // 2a. Clear current animation
        _clearVehicles();
        simRunning = true; feedHeld = true;
        var badge = document.getElementById('simFeedBadge');
        if (badge) { badge.style.display = ''; badge.textContent = '● LIVE'; }

        // 2b. Set highway dropdown to sim's highway
        HW = simCtx.hwId;
        localStorage.setItem('t3d_selectedHw', HW);
        var hwSel = document.getElementById('hwSel');
        if (hwSel) hwSel.value = HW;
        console.log('[T3D] refreshAnimation: set HW=' + HW);

        // 2c. Fetch zones + servers for this highway
        try {
            var r = await fetch('/Traffic3D/GetAnimationData?highwayId=' + encodeURIComponent(HW) + '&mode=ground');
            if (r.ok) {
                var d = await r.json();
                if (d.highwayCoords && d.highwayCoords.length > 0) {
                    T3D_ZONES = d.highwayCoords.map(function(z) {
                        return { zoneId: z.zoneId, zoneName: z.zoneName, lat: z.lat, lon: z.lon,
                                 highwayId: z.highwayId, radius: z.radius };
                    });
                    var zsel = document.getElementById('t3dZoneSel');
                    if (zsel) {
                        zsel.innerHTML = '<option value="">(Select Zone)</option>';
                        T3D_ZONES.forEach(function(z) {
                            var opt = document.createElement('option');
                            opt.value = z.zoneId; opt.textContent = z.zoneName || z.zoneId;
                            opt.dataset.hw = z.highwayId || HW;
                            opt.dataset.lat = z.lat ? z.lat.toFixed(4) : '';
                            opt.dataset.lon = z.lon ? z.lon.toFixed(4) : '';
                            zsel.appendChild(opt);
                        });
                    }
                    var ssel = document.getElementById('t3dServerSel');
                    if (ssel && d.servers) {
                        ssel.innerHTML = '<option value="">(Select Server)</option>';
                        d.servers.forEach(function(s) {
                            var opt = document.createElement('option');
                            opt.value = s.serverId;
                            opt.textContent = s.serverName || s.serverId;
                            opt.dataset.zone = s.zoneId || '';
                            ssel.appendChild(opt);
                        });
                    }
                    _hwyIsEW = d.isEW;
                    if (typeof d.hwBearing === 'number') _hwBearingDeg = d.hwBearing;
                    if (d.bridgePath && d.bridgePath.length > 0) {
                        _bridgePathCoords = d.bridgePath.map(function(p) {
                            return { lat: p.lat, lon: p.lon };
                        });
                    }
                    console.log('[T3D] refreshAnimation: ' + T3D_ZONES.length + ' zones bearing=' + _hwBearingDeg.toFixed(1) + '° bridge=' + _bridgePathCoords.length + 'pts isEW=' + _hwyIsEW);
                }
            }
        } catch(e) { console.warn('[T3D] refreshAnimation: zone fetch failed:', e); }

        // 2d. Set zone dropdown to sim's zone
        if (simCtx.zoneId) {
            selectedZoneId = simCtx.zoneId;
            localStorage.setItem('t3d_selectedZone', selectedZoneId);
            var zsel2 = document.getElementById('t3dZoneSel');
            if (zsel2) zsel2.value = selectedZoneId;
            var ssel2 = document.getElementById('t3dServerSel');
            if (ssel2) {
                ssel2.querySelectorAll('option').forEach(function(o) {
                    o.style.display = (!o.value || !o.dataset.zone || o.dataset.zone === selectedZoneId) ? '' : 'none';
                });
            }
            console.log('[T3D] refreshAnimation: set zone=' + selectedZoneId);
        }

        // 2e. Set server dropdown to sim's server
        if (simCtx.serverId) {
            selectedServerId = simCtx.serverId;
            localStorage.setItem('t3d_selectedServer', selectedServerId);
            var ssel3 = document.getElementById('t3dServerSel');
            if (ssel3) ssel3.value = selectedServerId;
            console.log('[T3D] refreshAnimation: set server=' + selectedServerId);
        }

        // 2f. Pan map to selected zone + build bridge
        var z = selectedZoneId
            ? T3D_ZONES.find(function(zz){ return zz.zoneId === selectedZoneId; })
            : (T3D_ZONES[0] || null);
        if (z && z.lat && z.lon) {
            midLat = z.lat; midLon = z.lon;
            _panMapTo(z.lat, z.lon);
            _setHighwayCoords(z.lat, z.lon, z.highwayId || HW);
            console.log('[T3D] refreshAnimation: panned map to (' + z.lat + ', ' + z.lon + ')');
        } else if (T3D_ZONES.length > 0) {
            var z0 = T3D_ZONES[0];
            midLat = z0.lat; midLon = z0.lon;
            _panMapTo(z0.lat, z0.lon);
            _setHighwayCoords(z0.lat, z0.lon, HW);
            console.log('[T3D] refreshAnimation: panned map to first zone');
        }
        _forceBridgeRedraw();

        // 2g. Load vehicle animation data
        if (HW && selectedZoneId && selectedServerId) {
            console.log('[T3D] refreshAnimation: all 3 set — loading animation data');
            await refreshScene();
            console.log('[T3D] refreshAnimation: loaded ' + vehicleData.size + ' vehicles');
        } else {
            console.warn('[T3D] refreshAnimation: sim context incomplete — hw=' + HW + ' zone=' + selectedZoneId + ' srv=' + selectedServerId);
        }
        _validateSelectionState();
        return;
    }

    // ── STEP 3: Check if sim is ON but context is missing ──
    // If the DB says sim is active but we don't have simCtx in localStorage,
    // still treat this as sim mode using the DB status directly.
    if (simActive && (!simCtx || !simCtx.hwId)) {
        console.log('[T3D] refreshAnimation: SIM IS ON (DB) but no localStorage context — fetching from DB status');
        try {
            var sr2 = await fetch('/DataInputFormats/SimulationStatus');
            if (sr2.ok) {
                var dbCtx = await sr2.json();
                if (dbCtx.highwayId) {
                    simCtx = { hwId: dbCtx.highwayId, zoneId: dbCtx.zoneId, serverId: dbCtx.serverId };
                    simActive = true;
                    console.log('[T3D] refreshAnimation: using DB sim context', simCtx);
                }
            }
        } catch(e) { console.warn('[T3D] refreshAnimation: DB context fetch failed', e); }
    }

    // If we now have a valid simCtx, go back to STEP 2
    if (simActive && simCtx && simCtx.hwId) {
        console.log('[T3D] refreshAnimation: retrying STEP 2 with recovered context');
        // Re-run the sim sync path by setting state and calling refreshScene
        _clearVehicles();
        simRunning = true; feedHeld = true;
        HW = simCtx.hwId;
        selectedZoneId = simCtx.zoneId || selectedZoneId;
        selectedServerId = simCtx.serverId || selectedServerId;
        var hwSelR = document.getElementById('hwSel');
        if (hwSelR) hwSelR.value = HW;
        var zselR = document.getElementById('t3dZoneSel');
        if (zselR) zselR.value = selectedZoneId;
        var sselR = document.getElementById('t3dServerSel');
        if (sselR) sselR.value = selectedServerId;
        localStorage.setItem('t3d_selectedHw', HW);
        localStorage.setItem('t3d_selectedZone', selectedZoneId);
        localStorage.setItem('t3d_selectedServer', selectedServerId);
        // Fetch zones + vehicles
        await refreshScene();
        _validateSelectionState();
        return;
    }

    // ── STEP 4: SIM IS OFF — use current dropdown values ──
    console.log('[T3D] refreshAnimation: sim is OFF — using current dropdown values');
    simRunning = false; feedHeld = false;
    // Clear stale sim localStorage so it doesn't interfere on next boot
    if (dbStatusOk && !simActive) {
        localStorage.removeItem('airways_sim_state');
        localStorage.removeItem('airways_sim_active');
        localStorage.removeItem('airways_sim_heartbeat');
    }
    var badgeOff = document.getElementById('simFeedBadge');
    if (badgeOff) badgeOff.style.display = 'none';

    // ── Apply dropdown selections to the map view ──
    // Since dropdown handlers no longer pan the map or redraw the bridge,
    // we do it here when the Refresh button is clicked.
    if (HW && T3D_ZONES.length > 0) {
        var rz = selectedZoneId
            ? T3D_ZONES.find(function(zz){ return zz.zoneId === selectedZoneId; })
            : T3D_ZONES[0];
        if (rz && rz.lat && rz.lon) {
            midLat = rz.lat; midLon = rz.lon;
            _panMapTo(rz.lat, rz.lon);
            _setHighwayCoords(rz.lat, rz.lon, rz.highwayId || HW);
        }
        if (typeof roadGroup3 !== 'undefined') {
            roadGroup3.rotation.y = _hwyIsEW ? 0 : Math.PI / 2;
        }
        _bridgeDirty = true;
        _forceBridgeRedraw();
        if (_map) setTimeout(function() { if (_map) { _map.invalidateSize(true); _forceBridgeRedraw(); } }, 200);
    }

    var curHw = document.getElementById('hwSel') ? document.getElementById('hwSel').value : HW;
    var curZone = document.getElementById('t3dZoneSel') ? document.getElementById('t3dZoneSel').value : selectedZoneId;
    var curSrv = document.getElementById('t3dServerSel') ? document.getElementById('t3dServerSel').value : selectedServerId;
    HW = curHw; selectedZoneId = curZone; selectedServerId = curSrv;

    if (!HW || !selectedZoneId || !selectedServerId) {
        var missing = [];
        if (!HW) missing.push('Highway');
        if (!selectedZoneId) missing.push('Zone');
        if (!selectedServerId) missing.push('Server');
        console.warn('[T3D] refreshAnimation: missing ' + missing.join(', '));
        alert('Select all 3 values:\nMissing: ' + missing.join(', '));
        _validateSelectionState();
        return;
    }

    // If highway changed, fetch zones first
    if (T3D_ZONES.length === 0 || (T3D_ZONES[0] && T3D_ZONES[0].highwayId !== HW)) {
        console.log('[T3D] refreshAnimation: fetching zones for HW=' + HW);
        try {
            var rz = await fetch('/Traffic3D/GetAnimationData?highwayId=' + encodeURIComponent(HW) + '&mode=ground');
            if (rz.ok) {
                var rd = await rz.json();
                if (rd.highwayCoords && rd.highwayCoords.length > 0) {
                    T3D_ZONES = rd.highwayCoords.map(function(z) {
                        return { zoneId: z.zoneId, zoneName: z.zoneName, lat: z.lat, lon: z.lon,
                                 highwayId: z.highwayId, radius: z.radius };
                    });
                    // Store bridge path + bearing from zone-only fetch
                    if (typeof rd.hwBearing === 'number') _hwBearingDeg = rd.hwBearing;
                    if (rd.bridgePath && rd.bridgePath.length > 0) {
                        _bridgePathCoords = rd.bridgePath.map(function(p) {
                            return { lat: p.lat, lon: p.lon };
                        });
                    }
                    var zsel3 = document.getElementById('t3dZoneSel');
                    if (zsel3) {
                        zsel3.innerHTML = '<option value="">(Select Zone)</option>';
                        T3D_ZONES.forEach(function(z) {
                            var opt = document.createElement('option');
                            opt.value = z.zoneId; opt.textContent = z.zoneName || z.zoneId;
                            opt.dataset.hw = z.highwayId || HW;
                            opt.dataset.lat = z.lat ? z.lat.toFixed(4) : '';
                            opt.dataset.lon = z.lon ? z.lon.toFixed(4) : '';
                            zsel3.appendChild(opt);
                        });
                        if (selectedZoneId) zsel3.value = selectedZoneId;
                    }
                    var ssel4 = document.getElementById('t3dServerSel');
                    if (ssel4 && rd.servers) {
                        ssel4.innerHTML = '<option value="">(Select Server)</option>';
                        rd.servers.forEach(function(s) {
                            var opt = document.createElement('option');
                            opt.value = s.serverId;
                            opt.textContent = s.serverName || s.serverId;
                            opt.dataset.zone = s.zoneId || '';
                            ssel4.appendChild(opt);
                        });
                        if (selectedServerId) ssel4.value = selectedServerId;
                    }
                    _hwyIsEW = rd.isEW;
                }
            }
        } catch(e) { console.warn('[T3D] refreshAnimation: zone fetch failed:', e); }
    }

    // Pan map to selected zone
    var pz = selectedZoneId
        ? T3D_ZONES.find(function(z){ return z.zoneId === selectedZoneId; })
        : T3D_ZONES[0];
    if (pz && pz.lat && pz.lon) {
        midLat = pz.lat; midLon = pz.lon;
        _panMapTo(pz.lat, pz.lon);
        _setHighwayCoords(pz.lat, pz.lon, pz.highwayId || HW);
    } else if (T3D_ZONES.length > 0) {
        midLat = T3D_ZONES[0].lat; midLon = T3D_ZONES[0].lon;
        _panMapTo(midLat, midLon);
        _setHighwayCoords(midLat, midLon, HW);
    }
    _forceBridgeRedraw();

    console.log('[T3D] refreshAnimation: all 3 set — loading animation data');
    await refreshScene();
    console.log('[T3D] refreshAnimation: loaded ' + vehicleData.size + ' vehicles');
    _validateSelectionState();
}

async function refreshScene() {
    // ── GUARD: animation requires all 3 values (highway + zone + server) ──
    // If any is missing, do NOT fetch and do NOT clear existing animation.
    if (!HW || !selectedZoneId || !selectedServerId) {
        console.log('[T3D] refreshScene: SKIPPED — need all 3 (hw=' + HW + ' zone=' + selectedZoneId + ' srv=' + selectedServerId + ')');
        return;
    }
    try {
        var params = 'highwayId=' + encodeURIComponent(HW) +
                     '&zoneId='   + encodeURIComponent(selectedZoneId) +
                     '&serverId=' + encodeURIComponent(selectedServerId) +
                     '&mode=ground' +
                     (simRunning ? '&simOnly=true' : '');
        console.log('[T3D] refreshScene:', params);
        var r = await fetch('/Traffic3D/GetAnimationData?' + params);
        if (!r.ok) { console.warn('[T3D] refreshScene HTTP', r.status); return; }
        var data = await r.json();
        console.log('[T3D] refreshScene: zones=' + ((data.highwayCoords||[]).length) + ' vehicles=' + ((data.vehicles||[]).length));
        // Update highway path from server-provided zone coordinates
        if (data.highwayCoords && data.highwayCoords.length > 0) {
            // Update T3D_ZONES from server data
            T3D_ZONES = data.highwayCoords.map(function(z) {
                return { zoneId: z.zoneId, zoneName: z.zoneName, lat: z.lat, lon: z.lon,
                         highwayId: z.highwayId, radius: z.radius };
            });
            // Store bearing + dense bridge path from server
            if (typeof data.hwBearing === 'number') {
                _hwBearingDeg = data.hwBearing;
            }
            if (data.bridgePath && data.bridgePath.length > 0) {
                _bridgePathCoords = data.bridgePath.map(function(p) {
                    return { lat: p.lat, lon: p.lon };
                });
                console.log('[T3D] Bridge path: ' + _bridgePathCoords.length + ' pts bearing=' + _hwBearingDeg.toFixed(1) + '°');
            }
            // ── DO NOT rebuild dropdowns when all 3 are already set ──
            // The dropdowns were populated by t3dHighwayChanged. Rebuilding
            // them here can clear the selection if zone ordering differs between
            // the initial fetch (ordered by longitude) and this fetch (sorted by axis).
            // Just update T3D_ZONES for the bridge path and keep dropdowns as-is.
            if (!selectedZoneId || !selectedServerId) {
                // Only rebuild if we're missing selections (e.g. boot or highway change)
                var zsel = document.getElementById('t3dZoneSel');
                if (zsel) {
                    var currentIds = Array.from(zsel.querySelectorAll('option')).filter(function(o){ return o.value; }).map(function(o){ return o.value; });
                    var newIds = T3D_ZONES.map(function(z){ return z.zoneId; });
                    var changed = currentIds.length !== newIds.length || currentIds.some(function(id,i){ return id !== newIds[i]; });
                    if (changed) {
                        var prevZone = selectedZoneId;
                        zsel.innerHTML = '<option value="">(Select Zone)</option>';
                        T3D_ZONES.forEach(function(z) {
                            var opt = document.createElement('option');
                            opt.value = z.zoneId;
                            opt.textContent = z.zoneName || z.zoneId;
                            opt.dataset.hw = z.highwayId || HW;
                            opt.dataset.lat = z.lat ? z.lat.toFixed(4) : '';
                            opt.dataset.lon = z.lon ? z.lon.toFixed(4) : '';
                            zsel.appendChild(opt);
                        });
                        if (prevZone && newIds.indexOf(prevZone) >= 0) {
                            zsel.value = prevZone;
                        } else {
                            selectedZoneId = '';
                            zsel.value = '';
                        }
                    }
                }
                // Rebuild server dropdown only if missing
                if (data.servers) {
                    var ssel = document.getElementById('t3dServerSel');
                    if (ssel) {
                        var prevSrv = selectedServerId;
                        ssel.innerHTML = '<option value="">(Select Server)</option>';
                        data.servers.forEach(function(s) {
                            var opt = document.createElement('option');
                            opt.value = s.serverId;
                            var zn = '';
                            if (s.zoneId) {
                                var zMatch = T3D_ZONES.find(function(zz){ return zz.zoneId === s.zoneId; });
                                zn = zMatch ? (zMatch.zoneName || s.zoneId) : s.zoneId;
                            }
                            opt.textContent = (s.serverName || s.serverId) + (zn ? ' (' + zn + ')' : '');
                            opt.dataset.zone = s.zoneId || '';
                            ssel.appendChild(opt);
                        });
                        if (prevSrv) {
                            var stillExists = data.servers.some(function(s){ return s.serverId === prevSrv; });
                            if (stillExists) ssel.value = prevSrv;
                            else { selectedServerId = ''; ssel.value = ''; }
                        }
                        if (selectedZoneId) {
                            ssel.querySelectorAll('option').forEach(function(o) {
                                o.style.display = (!o.value || !o.dataset.zone || o.dataset.zone === selectedZoneId) ? '' : 'none';
                            });
                        }
                    }
                }
            }
            // ALWAYS update bridge path from server zones (sorted by axis)
            _setHighwayCoords(T3D_ZONES[0].lat, T3D_ZONES[0].lon, HW);
            _hwyIsEW = data.isEW;
            if (typeof roadGroup3 !== 'undefined') {
                roadGroup3.rotation.y = _hwyIsEW ? 0 : Math.PI / 2;
            }
            // ── PAN MAP to the selected zone (or first zone) ──
            // Without this, the map stays at its previous location and the
            // bridge is drawn off-screen — "unable to locate the highway."
            var panZone = selectedZoneId
                ? T3D_ZONES.find(function(z){ return z.zoneId === selectedZoneId; })
                : T3D_ZONES[0];
            if (panZone && panZone.lat && panZone.lon) {
                midLat = panZone.lat; midLon = panZone.lon;
                _panMapTo(panZone.lat, panZone.lon);
            }
        } else if (data.isEW !== undefined) {
            _hwyIsEW = data.isEW;
            if (typeof roadGroup3 !== 'undefined') roadGroup3.rotation.y = _hwyIsEW ? 0 : Math.PI / 2;
        }
        // Store bounds from server
        if (data.bounds) {
            _serverBounds = data.bounds;
        }
        // Load validated vehicles
        // When sim is running, clear existing vehicles first so we only
        // show simulation data — no stale DB or synthetic vehicles.
        if (simRunning) {
            // When sim is ON, MERGE DB vehicles with existing animation.
            // DO NOT clear — loadEvents preserves existing vehicles' animated
            // positions and only adds new ones. Clearing would wipe the
            // continuous animation and re-create vehicles at the DB's latest
            // GPS, causing them to jump to new positions.
            if (data.vehicles && data.vehicles.length > 0) {
                console.log('[T3D] refreshScene: sim ON — merging ' + data.vehicles.length + ' DB vehicles with ' + vehicleData.size + ' existing');
                loadEvents(data.vehicles);
            } else {
                console.log('[T3D] refreshScene: sim ON, 0 DB sim events — keeping ' + vehicleData.size + ' BroadcastChannel vehicles');
            }
        } else {
            // Sim OFF — normal mode: load whatever the server returns
            if (data.vehicles && data.vehicles.length > 0) {
                loadEvents(data.vehicles);
            } else if (vehicleData.size === 0) {
                console.log('[T3D] No vehicles from server, scene already empty');
            }
        }
        _forceBridgeRedraw();
    } catch(e) { console.warn('[T3D] Scene refresh error:', e); }
}

function _validateSelectionState() {
    var issues = [];
    var hwSel = document.getElementById('hwSel');
    if (hwSel && hwSel.value && HW && hwSel.value !== HW) issues.push('HW mismatch');
    if (!_serverBounds) issues.push('No server bounds');
    if (!_hwyPath || _hwyPath.length === 0) issues.push('No highway path');
    if (issues.length > 0) console.warn('[T3D Validation] ' + issues.join('; '));
    return issues.length === 0;
}

// ── Validate that dropdown selection is reflected in animation state ──
// Called after any dropdown change to verify the scene matches the selection.
function _validateSelectionState() {
    var issues = [];
    // Check HW matches dropdown
    var hwSel = document.getElementById('hwSel');
    if (hwSel && hwSel.value && HW && hwSel.value !== HW) {
        issues.push('HW mismatch: dropdown=' + hwSel.value + ' state=' + HW);
    }
    // Check zone matches dropdown
    var zSel = document.getElementById('t3dZoneSel');
    if (zSel && zSel.value !== selectedZoneId) {
        issues.push('Zone mismatch: dropdown=' + zSel.value + ' state=' + selectedZoneId);
    }
    // Check server matches dropdown
    var sSel = document.getElementById('t3dServerSel');
    if (sSel && sSel.value !== selectedServerId) {
        issues.push('Server mismatch: dropdown=' + sSel.value + ' state=' + selectedServerId);
    }
    // Check bounds exist
    if (!_serverBounds) {
        issues.push('No server bounds set');
    }
    // Check highway path exists
    if (!_hwyPath || _hwyPath.length === 0) {
        issues.push('No highway path for bridge');
    }
    if (issues.length > 0) {
        console.warn('[T3D Validation] ' + issues.join('; '));
    }
    return issues.length === 0;
}

// Override _getSelectedBounds to use server-provided bounds
var _getSelectedBoundsOrig = _getSelectedBounds;
_getSelectedBounds = function() {
    if (_serverBounds) {
        return {
            minLat: _serverBounds.minLat, maxLat: _serverBounds.maxLat,
            minLon: _serverBounds.minLon, maxLon: _serverBounds.maxLon,
            tight: _serverBounds.tight,
            centerLat: (_serverBounds.minLat + _serverBounds.maxLat) / 2,
            centerLon: (_serverBounds.minLon + _serverBounds.maxLon) / 2
        };
    }
    return _getSelectedBoundsOrig();
};

// ── Feed hold toggle ──────────────────────────────────────────────────
function toggleFeed() {
    feedHeld = !feedHeld;
    var btn = document.getElementById('btnAnimToggle');
    if (btn) { btn.textContent = feedHeld ? '▶ Resume' : '⏸ Hold Feed';
               btn.classList.toggle('btn-outline-warning', !feedHeld);
               btn.classList.toggle('btn-warning', feedHeld); }
}

// ── Sim feed panel ────────────────────────────────────────────────────
function toggleSimPanel() {
    var body = document.getElementById('simFeedBody');
    var tog  = document.getElementById('simFeedToggle');
    if (!body) return;
    var open = body.style.maxHeight !== '0px' && body.style.maxHeight !== '';
    body.style.maxHeight = open ? '0px' : '200px';
    if (tog) tog.textContent = open ? '▼' : '▲';
}

function _updateSimPanel(ev) {
    var badge = document.getElementById('simFeedBadge');
    var line  = document.getElementById('simFeedLine');
    var ts    = new Date().toLocaleTimeString();
    var vid   = ev.vehicle_id || ev.vehicleId || ev.VehicleId || '?';
    var cat   = (ev.vehicle_category || ev.vehicleCategory || ev.vehicle_mode || ev.vehicleMode || '?').toLowerCase();
    var spd   = parseFloat(ev.speed_mph || ev.speedMph || ev.SpeedMph || 0).toFixed(1);
    if (badge) badge.style.display = '';
    if (line)  line.textContent = ts + ' · ' + vid + ' · ' + cat + ' · ' + spd + ' mph';

    // Update detail fields
    ['sfVehicleId','sfType','sfSpeed','sfZone','sfLatLon','sfDbStatus'].forEach(function(id) {
        var el = document.getElementById(id); if (el) el.textContent = '–';
    });
    var sf = function(id, val) { var e = document.getElementById(id); if (e) e.textContent = val; };
    sf('sfVehicleId', vid + (ev.dbId ? ' [db#' + ev.dbId + ']' : ''));
    sf('sfType',  cat);
    sf('sfSpeed', spd + ' mph');
    sf('sfZone',  ev.zone_id || ev.zoneId || '–');
    var lat = parseFloat(ev.latitude || ev.Latitude || 0);
    var lon = parseFloat(ev.longitude || ev.Longitude || 0);
    sf('sfLatLon', lat.toFixed(4) + ', ' + lon.toFixed(4));
    sf('sfDbStatus', ev.dbId ? '✓ db#' + ev.dbId + ' · vid ' + vid :
        (ev._dbSaved ? '✓ saved · vid ' + vid : 'pending...'));

    // Flash live label
    var lbl = document.getElementById('simLiveLabel');
    if (lbl) { lbl.style.opacity = '1'; setTimeout(function() { lbl.style.opacity = '0'; }, 1800); }
}

// ── Simulation BroadcastChannel listener ─────────────────────────────
var _bc = null;
try { _bc = new BroadcastChannel('airways_sim'); } catch(e) {}

function _onSimMsg(data) {
    if (!data) return;
    if (data.type === 'sim_started') {
        // Sim started on another tab — switch to sim's highway/zone/server context
        simRunning = true; feedHeld = true;
        _clearVehicles();
        var badge = document.getElementById('simFeedBadge');
        if (badge) { badge.style.display = ''; badge.textContent = '● LIVE'; }

        // ── Sync T3D dropdowns to the simulation's context ──
        var ctx = data.context || {};
        if (ctx.hwId) {
            _simHwId = ctx.hwId;
            // If the sim's highway differs from current, switch it
            if (ctx.hwId !== HW) {
                HW = ctx.hwId;
                localStorage.setItem('t3d_selectedHw', HW);
                var hwSel = document.getElementById('hwSel');
                if (hwSel) hwSel.value = HW;
                // Fetch zones for this highway from server
                fetch('/Traffic3D/GetAnimationData?highwayId=' + encodeURIComponent(HW) + '&mode=ground')
                    .then(function(r){ return r.json(); })
                    .then(function(d) {
                        if (d.highwayCoords && d.highwayCoords.length > 0) {
                            T3D_ZONES = d.highwayCoords.map(function(z) {
                                return { zoneId: z.zoneId, zoneName: z.zoneName, lat: z.lat, lon: z.lon,
                                         highwayId: z.highwayId, radius: z.radius };
                            });
                            // Store bridge path + bearing from zone-only fetch
                            if (typeof d.hwBearing === 'number') _hwBearingDeg = d.hwBearing;
                            if (d.bridgePath && d.bridgePath.length > 0) {
                                _bridgePathCoords = d.bridgePath.map(function(p) {
                                    return { lat: p.lat, lon: p.lon };
                                });
                            }
                            // Rebuild zone dropdown
                            var zsel = document.getElementById('t3dZoneSel');
                            if (zsel) {
                                zsel.innerHTML = '<option value="">(Select Zone)</option>';
                                T3D_ZONES.forEach(function(z) {
                                    var opt = document.createElement('option');
                                    opt.value = z.zoneId; opt.textContent = z.zoneName || z.zoneId;
                                    opt.dataset.hw = z.highwayId || HW;
                                    opt.dataset.lat = z.lat ? z.lat.toFixed(4) : '';
                                    opt.dataset.lon = z.lon ? z.lon.toFixed(4) : '';
                                    zsel.appendChild(opt);
                                });
                            }
                            // Rebuild server dropdown
                            var ssel = document.getElementById('t3dServerSel');
                            if (ssel && d.servers) {
                                ssel.innerHTML = '<option value="">(Select Server)</option>';
                                d.servers.forEach(function(s) {
                                    var opt = document.createElement('option');
                                    opt.value = s.serverId;
                                    opt.textContent = s.serverName || s.serverId;
                                    opt.dataset.zone = s.zoneId || '';
                                    ssel.appendChild(opt);
                                });
                            }
                            // Center map on first zone
                            var z0 = T3D_ZONES[0];
                            if (z0 && z0.lat) {
                                midLat = z0.lat; midLon = z0.lon;
                                _panMapTo(z0.lat, z0.lon);
                                _setHighwayCoords(z0.lat, z0.lon, HW);
                                _hwyIsEW = d.isEW;
                            }
                        }
                        // Now apply zone/server selection from sim context
                        _applySimContext(ctx);
                    })
                    .catch(function(){});
            } else {
                // Same highway — just apply zone/server
                _applySimContext(ctx);
            }
        }
        return;
    }

    // Helper: apply sim's zone/server selection to T3D dropdowns
    function _applySimContext(ctx) {
        if (ctx.zoneId) {
            _simZoneId = ctx.zoneId;
            selectedZoneId = ctx.zoneId;
            localStorage.setItem('t3d_selectedZone', ctx.zoneId);
            var zsel = document.getElementById('t3dZoneSel');
            if (zsel) zsel.value = ctx.zoneId;
            // Pan map to the selected zone
            var z = T3D_ZONES.find(function(zz){ return zz.zoneId === ctx.zoneId; });
            if (z && z.lat && z.lon) {
                midLat = z.lat; midLon = z.lon;
                _panMapTo(z.lat, z.lon);
                _setHighwayCoords(z.lat, z.lon, z.highwayId || HW);
            }
        }
        if (ctx.serverId) {
            _simSrvId = ctx.serverId;
            selectedServerId = ctx.serverId;
            localStorage.setItem('t3d_selectedServer', ctx.serverId);
            var ssel = document.getElementById('t3dServerSel');
            if (ssel) ssel.value = ctx.serverId;
        }
        _forceBridgeRedraw();
    }
    if (data.type === 'sim_vehicle' || data.type === 'sim_event') {
        var ev = data.payload || data;
        var _wasFirst = !simRunning;
        simRunning = true; feedHeld = true;
        // Clear the scene on the FIRST sim event to remove pre-existing live DB vehicles
        if (_wasFirst) _clearVehicles();
        // Accept both snake_case (sim payload) and camelCase
        _simHwId   = ev.highway_id  || ev.highwayId  || _simHwId;
        _simZoneId = ev.zone_id     || ev.zoneId     || _simZoneId;
        _simSrvId  = ev.server_id   || ev.serverId    || _simSrvId;
        // Auto-select the sim's zone so the map re-centres and highway aligns
        if (_simZoneId && _simZoneId !== selectedZoneId) {
            selectedZoneId = _simZoneId;
            var z = T3D_ZONES.find(function(zz){ return zz.zoneId === _simZoneId; });
            if (z && z.lat && z.lon) {
                midLat = z.lat; midLon = z.lon;
                _panMapTo(z.lat, z.lon);
                _setHighwayCoords(z.lat, z.lon, z.highwayId);
            }
            var zsel = document.getElementById('t3dZoneSel');
            if (zsel) zsel.value = _simZoneId;
        }
        _forceBridgeRedraw();
        _updateSimPanel(ev);
        // ── Merge classification data into the event so loadEvents has it ──
        if (data.classification) {
            var cls = data.classification;
            if (cls.make)     ev.vehicle_make     = cls.make;
            if (cls.category) ev.vehicle_category  = cls.category;
            if (cls.domain)   ev.classification_domain = cls.domain;
            if (cls.color)    ev.classification_color  = cls.color;
        }
        // Validate sim event coordinates against selected bounds before loading
        var _simLat = parseFloat(ev.latitude || ev.Latitude || ev.lat || 0);
        var _simLon = parseFloat(ev.longitude || ev.Longitude || ev.lon || 0);
        if (_simLat && _simLon) {
            var _sb = _getSelectedBounds();
            if (_sb && !_isWithinBounds(_simLat, _simLon)) {
                var _sc = _clampToBounds(_simLat, _simLon);
                ev.latitude  = _sc.lat;
                ev.longitude = _sc.lon;
            }
        }
        loadEvents([ev]);
        // Update badge count
        if (!window._simEventCount) window._simEventCount = 0;
        window._simEventCount++;
        var badge = document.getElementById('simFeedBadge');
        if (badge) badge.textContent = '● LIVE #' + window._simEventCount;
    } else if (data.type === 'sim_stop' || data.type === 'sim_stopped') {
        simRunning = false; feedHeld = false;
        var badge = document.getElementById('simFeedBadge');
        if (badge) badge.style.display = 'none';
        // Only refresh if all 3 values are set
        if (HW && selectedZoneId && selectedServerId) refreshScene();
    }
}

if (_bc) _bc.onmessage = function(e) { _onSimMsg(e.data); };

// Also listen via localStorage (cross-tab)
window.addEventListener('storage', function(e) {
    if (e.key === 'airways_sim_last_event') {
        try { _onSimMsg(JSON.parse(e.newValue || '{}')); } catch(_) {}
    } else if (e.key === 'airways_sim_state') {
        // Sim state changed in another tab — check if sim started
        try {
            var st = JSON.parse(e.newValue || '{}');
            if (st.running && !simRunning) {
                // Sim just started — clear and switch to sim mode
                simRunning = true; feedHeld = true;
                _clearVehicles();
                var badge = document.getElementById('simFeedBadge');
                if (badge) { badge.style.display = ''; badge.textContent = '● LIVE'; }
            } else if (!st.running && simRunning) {
                // Sim just stopped — resume live DB feed
                simRunning = false; feedHeld = false;
                var badge2 = document.getElementById('simFeedBadge');
                if (badge2) badge2.style.display = 'none';
                _clearVehicles();
                if (HW && selectedZoneId && selectedServerId) refreshScene();
            }
        } catch(_) {}
    }
});

// ── Simulation state restore on page load ────────────────────────────
async function _simRestoreState() {
    var ls = localStorage.getItem('airways_sim_state');
    if (!ls) return;
    var st;
    try { st = JSON.parse(ls); } catch(_) { return; }
    if (!st.running) return;
    // Verify DB still thinks sim is running — DB is the source of truth
    try {
        var r = await fetch('/DataInputFormats/SimulationStatus');
        if (!r.ok) { console.warn('Sim status check failed'); return; }
        var dbStatus = await r.json();
        if (dbStatus.stale || !dbStatus.isRunning) {
            // DB says sim is OFF — clear ALL stale sim localStorage
            console.log('[T3D] _simRestoreState: DB says sim OFF — clearing all sim state');
            localStorage.removeItem('airways_sim_state');
            localStorage.removeItem('airways_sim_active');
            localStorage.removeItem('airways_sim_heartbeat');
            simRunning = false; feedHeld = false;
            return;
        }
        simRunning = true; feedHeld = true;
        // Clear pre-existing live DB vehicles — sim data takes priority
        _clearVehicles();
        var badge = document.getElementById('simFeedBadge');
        if (badge) { badge.style.display = ''; badge.textContent = '● LIVE #' + (dbStatus.totalPosted || 0); }
    } catch(e) { console.warn('Status check failed:', e); }
}

// ── Inspector (click vehicle) ─────────────────────────────────────────
function showInspector(vd) {
    var el = document.getElementById('inspector');
    if (!el) return;
    el.innerHTML = '<div style="font-size:.75rem;line-height:1.6;color:#94a3b8">' +
        '<div><span style="color:#4ade80">ID:</span> ' + (vd.ev.vehicleId || '–') + '</div>' +
        '<div><span style="color:#4ade80">Type:</span> ' + (vd.vc.category || '–') + '</div>' +
        '<div><span style="color:#4ade80">Speed:</span> ' + (vd.speedMph || 0).toFixed(1) + ' mph</div>' +
        '<div><span style="color:#4ade80">Lat/Lon:</span> ' + (vd.lat||0).toFixed(4) + ', ' + (vd.lon||0).toFixed(4) + '</div>' +
        '</div>';
}

_oc.addEventListener('click', function(e) {
    if (!_map || !_mapReady) return;
    var rect = _oc.getBoundingClientRect();
    var cx = e.clientX - rect.left, cy = e.clientY - rect.top;
    var origin = _map.getPixelOrigin();
    var closestVid = null, closestDist = 30;
    vehicleData.forEach(function(vd, vid) {
        var mapPt = _map.project([vd.lat, vd.lon], _map.getZoom());
        var sx = mapPt.x - origin.x, sy = mapPt.y - origin.y;
        var d = Math.hypot(cx - sx, cy - sy);
        if (d < closestDist) { closestDist = d; closestVid = vid; }
    });
    if (closestVid) showInspector(vehicleData.get(closestVid));
});

// ── Window resize ─────────────────────────────────────────────────────
window.addEventListener('resize', function() {
    _bridgeDirty = true;
    if (_map) setTimeout(function() { if (_map) _map.invalidateSize(true); }, 50);
});

// ── Boot sequence ─────────────────────────────────────────────────────
(async function boot() {
    console.log('[T3D] Boot: HW=' + HW + ' zones=' + T3D_ZONES.length);
    _initMap();
    console.log('[T3D] Boot: map ready=' + _mapReady);
    // Set highway coords from the initial selected zone (not just map centre)
    var _bootZone = T3D_ZONES.find(function(z){ return z.lat && z.lon; });
    if (_bootZone) {
        _mapCtrLat = _bootZone.lat; _mapCtrLon = _bootZone.lon;
        _panMapTo(_bootZone.lat, _bootZone.lon);
        _setHighwayCoords(_bootZone.lat, _bootZone.lon, _bootZone.highwayId || HW);
    } else {
        _setHighwayCoords(_mapCtrLat, _mapCtrLon, HW);
    }

    // 2. Start 2D canvas render loop
    _renderLoop();

    // 3. Default to Top view (2D overlay + Leaflet map)
    setViewport('top');
    var topBtn = document.querySelector('#viewToggle [data-view="top"]');
    if (topBtn) {
        document.querySelectorAll('#viewToggle button').forEach(function(b) {
            b.classList.remove('active','btn-primary'); b.classList.add('btn-outline-primary');
        });
        topBtn.classList.add('active','btn-primary'); topBtn.classList.remove('btn-outline-primary');
    }

    // 4. Check if sim was running (cross-tab restore) — BEFORE loading DB events
    await _simRestoreState();

    // 5. Restore selection from localStorage (survives page refresh)
    //    Priority: simulation context (airways_sim_context) > T3D's own saved state
    var simCtx = null;
    try { simCtx = JSON.parse(localStorage.getItem('airways_sim_context') || 'null'); } catch(e) {}
    var savedHw   = (simCtx && simCtx.hwId)    ? simCtx.hwId    : localStorage.getItem('t3d_selectedHw');
    var savedZone = (simCtx && simCtx.zoneId)  ? simCtx.zoneId  : localStorage.getItem('t3d_selectedZone');
    var savedSrv  = (simCtx && simCtx.serverId) ? simCtx.serverId : localStorage.getItem('t3d_selectedServer');
    if (simCtx) console.log('[T3D] Boot: sim context = hw=' + simCtx.hwId + ' zone=' + simCtx.zoneId + ' srv=' + simCtx.serverId);
    if (savedHw && savedHw !== HW) {
        HW = savedHw;
        var hwSel = document.getElementById('hwSel');
        if (hwSel) hwSel.value = HW;
        console.log('[T3D] Boot: restored HW=' + HW + ' from sim context/localStorage');
        // Always fetch zones for this highway at boot — sim or not.
        // Without this, the map stays at the Razor default center (first
        // highway in DB) and the bridge for the restored highway is
        // drawn off-screen.
        {
            try {
                var r = await fetch('/Traffic3D/GetAnimationData?highwayId=' + encodeURIComponent(HW) + '&mode=ground');
                if (r.ok) {
                    var d = await r.json();
                    if (d.highwayCoords && d.highwayCoords.length > 0) {
                        T3D_ZONES = d.highwayCoords.map(function(z) {
                            return { zoneId: z.zoneId, zoneName: z.zoneName, lat: z.lat, lon: z.lon,
                                     highwayId: z.highwayId, radius: z.radius };
                        });
                        var zsel = document.getElementById('t3dZoneSel');
                        if (zsel) {
                            zsel.innerHTML = '<option value="">(Select Zone)</option>';
                            T3D_ZONES.forEach(function(z) {
                                var opt = document.createElement('option');
                                opt.value = z.zoneId; opt.textContent = z.zoneName || z.zoneId;
                                opt.dataset.hw = z.highwayId || HW;
                                opt.dataset.lat = z.lat ? z.lat.toFixed(4) : '';
                                opt.dataset.lon = z.lon ? z.lon.toFixed(4) : '';
                                zsel.appendChild(opt);
                            });
                        }
                        var ssel = document.getElementById('t3dServerSel');
                        if (ssel && d.servers) {
                            ssel.innerHTML = '<option value="">(Select Server)</option>';
                            d.servers.forEach(function(s) {
                                var opt = document.createElement('option');
                                opt.value = s.serverId;
                                opt.textContent = s.serverName || s.serverId;
                                opt.dataset.zone = s.zoneId || '';
                                ssel.appendChild(opt);
                            });
                        }
                        _hwyIsEW = d.isEW;
                        if (typeof d.hwBearing === 'number') _hwBearingDeg = d.hwBearing;
                        if (d.bridgePath && d.bridgePath.length > 0) {
                            _bridgePathCoords = d.bridgePath.map(function(p) {
                                return { lat: p.lat, lon: p.lon };
                            });
                            console.log('[T3D] Boot: bridge=' + _bridgePathCoords.length + 'pts bearing=' + _hwBearingDeg.toFixed(1) + '°');
                        }
                        var z0 = T3D_ZONES[0];
                        if (z0 && z0.lat) {
                            midLat = z0.lat; midLon = z0.lon;
                            _panMapTo(z0.lat, z0.lon);
                            _setHighwayCoords(z0.lat, z0.lon, HW);
                        }
                        _forceBridgeRedraw();
                    }
                }
            } catch(e) { console.warn('[T3D] Boot zone fetch failed:', e); }
        }
    }
    if (savedZone) {
        var validZone = T3D_ZONES.some(function(z){ return z.zoneId === savedZone; });
        if (validZone) {
            selectedZoneId = savedZone;
            var zSelEl = document.getElementById('t3dZoneSel');
            if (zSelEl) zSelEl.value = savedZone;
            // Pan map to this zone so the bridge is visible
            var bz = T3D_ZONES.find(function(z){ return z.zoneId === savedZone; });
            if (bz && bz.lat && bz.lon) {
                midLat = bz.lat; midLon = bz.lon;
                _panMapTo(bz.lat, bz.lon);
                _setHighwayCoords(bz.lat, bz.lon, bz.highwayId || HW);
            }
            console.log('[T3D] Boot: restored zone=' + savedZone + ' (map panned)');
        }
    }
    if (savedSrv) {
        selectedServerId = savedSrv;
        var sSelEl = document.getElementById('t3dServerSel');
        if (sSelEl) sSelEl.value = savedSrv;
        console.log('[T3D] Boot: restored server=' + savedSrv);
    }

    // 6. Use refreshAnimation to check sim status and load appropriately.
    //    This ensures boot uses the same flow as the Refresh button:
    //    - If sim is running → sync to sim context, load animation
    //    - If sim is off → use restored dropdown values, load animation
    await refreshAnimation();
    console.log('[T3D] Boot complete: vehicles=' + vehicleData.size + ' simRunning=' + simRunning);
})();

// ── Slow poll: 30s, live mode only ───────────────────────────────────
setInterval(function() { if (!simRunning && !feedHeld && HW && selectedZoneId && selectedServerId) refreshScene(); }, 30000);

// ── Sim poll: 3s, sim mode only ────────────────────────────────────────
// During simulation, poll the DB for sim events (SIM-* vehicles) so the
// scene stays current even if BroadcastChannel isn't delivering (e.g.,
// DIF page was closed). This ensures the Refresh button + auto-poll
// always show ONLY simulation data.
setInterval(function() {
    if (simRunning && feedHeld && HW && selectedZoneId && selectedServerId) refreshScene();
}, 3000);

</script>