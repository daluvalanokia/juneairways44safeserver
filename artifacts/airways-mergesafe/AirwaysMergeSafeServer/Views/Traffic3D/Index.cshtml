@model AirwaysMergeSafeServer.ViewModels.Traffic3DViewModel
@{
    ViewData["Title"] = "3D Traffic";
    var zonesJson   = System.Text.Json.JsonSerializer.Serialize(
        Model.Zones.Where(z => z.Latitude.HasValue).Select(z => new {
            zoneId = z.ZoneId, zoneName = z.ZoneName, status = z.Status,
            lat = z.Latitude, lon = z.Longitude,
            highwayId = z.HighwayId,
            altM = z.AltitudeMeters ?? 0, radius = z.GeofenceRadius
        }));
    var sensorsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Sensors.Where(s => s.Latitude.HasValue).Select(s => new {
            deviceId = s.DeviceId, deviceName = s.DeviceName,
            deviceType = s.DeviceType, status = s.Status,
            lat = s.Latitude, lon = s.Longitude,
            altM = s.AltitudeMeters ?? 0
        }));
    var serversJson = System.Text.Json.JsonSerializer.Serialize(
        Model.SwitchServers.Select(s => new {
            serverId   = s.ServerId,   serverName = s.ServerName,
            zoneId     = s.ZoneId,     status     = s.Status,
            ipAddress  = s.IpAddress,  port       = s.Port
        }));
    var hw          = Model.SelectedHighwayId ?? "";
    var zoneCtrLat  = Model.Zones.Where(z => z.Latitude.HasValue).Select(z => z.Latitude!.Value).FirstOrDefault();
    var zoneCtrLon  = Model.Zones.Where(z => z.Longitude.HasValue).Select(z => z.Longitude!.Value).FirstOrDefault();
    // I-20 Grand Prairie centreline fallback — not downtown Dallas
    if (zoneCtrLat == 0) zoneCtrLat = 32.7213;
    if (zoneCtrLon == 0) zoneCtrLon = -97.0207;
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <h4 class="mb-0">🏗 3D Traffic Scene</h4>
        <small class="text-muted">Ground vehicles · Classification-aware rendering</small>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <select id="hwSel" class="form-select form-select-sm" style="width:190px"
                onchange="t3dHighwayChanged(this.value)">
            @foreach (var h in Model.Highways)
            {
                @if (h.HighwayId == Model.SelectedHighwayId)
                { <option value="@h.HighwayId" selected>@h.Name</option> }
                else
                { <option value="@h.HighwayId">@h.Name</option> }
            }
        </select>
        <!-- Zone dropdown -->
        <select id="t3dZoneSel" class="form-select form-select-sm" style="width:150px"
                onchange="t3dZoneChanged()">
            <option value="">(Select Zone)</option>
            @foreach (var z in Model.Zones)
            {
                <option value="@z.ZoneId"
                        data-hw="@z.HighwayId"
                        data-lat="@(z.Latitude?.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                        data-lon="@(z.Longitude?.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture) ?? "")">@z.ZoneName</option>
            }
        </select>
        <!-- Switch Server dropdown -->
        <select id="t3dServerSel" class="form-select form-select-sm" style="width:160px"
                onchange="t3dServerChanged()">
            <option value="">(Select Server)</option>
            @foreach (var s in Model.SwitchServers)
            {
                var sZone = Model.Zones.FirstOrDefault(z => z.ZoneId == s.ZoneId);
                <option value="@s.ServerId"
                        data-zone="@(s.ZoneId ?? "")"
                        data-zonename="@(sZone?.ZoneName ?? s.ZoneId ?? "")">@s.ServerName (@(sZone?.ZoneName ?? s.ZoneId ?? "?"))</option>
            }
        </select>
        <!-- View-mode toggle -->
        <div class="btn-group btn-group-sm" id="viewToggle">
            <button class="btn btn-primary active"    data-view="perspective" title="Perspective">⬡ 3D</button>
            <button class="btn btn-outline-primary"   data-view="side"        title="Side / Elevation">↕ Side</button>
            <button class="btn btn-outline-primary"   data-view="top"         title="Top / Plan">⊞ Top</button>
            <button class="btn btn-outline-primary"   data-view="split"       title="All three panels">⊟ Split</button>
        </div>
        <a href="/AirScene" class="btn btn-sm btn-outline-warning">🛫 Air Scene</a>
        <button id="btnAnimToggle" class="btn btn-sm btn-outline-warning" onclick="toggleFeed()">⏸ Hold Feed</button>
        <button class="btn btn-sm btn-success" onclick="refreshAnimation()" title="Sync to simulation + load animation">⟳ Refresh</button>
    </div>
</div>

<!-- ── Sim Data Feed Panel ─────────────────────────────────────────────── -->
<div id="simFeedPanel" style="background:rgba(5,12,5,.93);border:1px solid #1e4a1e;border-radius:6px;
     font-family:monospace;font-size:12px;margin-bottom:6px;overflow:hidden">
    <div onclick="toggleSimPanel()"
         style="padding:5px 10px;cursor:pointer;display:flex;align-items:center;gap:8px;user-select:none">
        <span style="color:#4ade80;font-size:.7rem;font-weight:700;letter-spacing:.05em">📡 SIM FEED</span>
        <span id="simFeedBadge" style="background:#dc2626;color:#fff;font-size:.6rem;font-weight:700;
              padding:1px 6px;border-radius:9px;letter-spacing:.08em;display:none">● LIVE</span>
        <span id="simFeedLine" style="color:#475569;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
            No sim events yet — start the simulator on Data Input Formats.
        </span>
        <span id="simFeedToggle" style="color:#4ade80;font-size:.65rem;flex-shrink:0">▼</span>
    </div>
    <div id="simFeedBody" style="max-height:0;overflow:hidden;transition:max-height .25s ease">
        <div style="padding:6px 12px 8px;border-top:1px solid #1e4a1e">
            <table style="width:100%;font-size:.68rem;border-collapse:collapse">
                <tr>
                    <td style="color:#4ade80;padding:1px 8px 1px 0;width:18%">Vehicle ID</td>
                    <td id="sfVehicleId" style="color:#d1fae5;width:30%">–</td>
                    <td style="color:#4ade80;padding:1px 8px;width:12%">Type</td>
                    <td id="sfType" style="color:#d1fae5">–</td>
                </tr>
                <tr>
                    <td style="color:#4ade80;padding:1px 8px 1px 0">Speed</td>
                    <td id="sfSpeed" style="color:#d1fae5">–</td>
                    <td style="color:#4ade80;padding:1px 8px">Zone</td>
                    <td id="sfZone" style="color:#d1fae5">–</td>
                </tr>
                <tr>
                    <td style="color:#4ade80;padding:1px 8px 1px 0">Lat / Lon</td>
                    <td id="sfLatLon" colspan="3" style="color:#d1fae5">–</td>
                </tr>
                <tr>
                    <td style="color:#4ade80;padding:1px 8px 1px 0">DB Save</td>
                    <td id="sfDbStatus" colspan="3" style="color:#fbbf24">–</td>
                </tr>
            </table>
        </div>
    </div>
</div>

<!-- ── Scene grid (split / single-panel modes) ────────────────────────── -->
<div id="sceneWrap" style="position:relative;height:520px;border-radius:8px;overflow:hidden;background:#1a2f1a">
    <!-- Leaflet map — fills entire scene as background -->
    <div id="t3dMiniMap" style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:0"></div>
    <!-- Three.js 3D canvas — transparent, renders on top of map -->
    <canvas id="mainCanvas" style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:1"></canvas>
    <!-- 2D label overlay — on top of everything -->
    <canvas id="t3d-label-overlay" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:2"></canvas>
    <!-- Overlay labels for split mode -->
    <div id="labelA" class="badge bg-secondary position-absolute" style="top:6px;left:6px;display:none;z-index:3">Perspective</div>
    <div id="labelB" class="badge bg-info text-dark position-absolute"    style="top:6px;display:none;z-index:3">Side ↕</div>
    <div id="labelC" class="badge bg-warning text-dark position-absolute" style="top:6px;display:none;z-index:3">Top ⊞</div>
    <div id="simLiveLabel" class="badge bg-success position-absolute"
         style="top:6px;right:6px;font-size:.72rem;opacity:0;transition:opacity .5s ease;pointer-events:none;z-index:10">
        🛰 Live Sim — Vehicle Added
    </div>
    <!-- Zoom controls (bottom-right) -->
    <div style="position:absolute;bottom:10px;right:10px;z-index:8;display:flex;flex-direction:column;gap:4px">
        <button id="btnZoomIn" onclick="t3dZoomIn()" title="Zoom In"
                style="width:38px;height:38px;border-radius:8px;background:rgba(15,23,42,.92);
                       color:#fff;border:1px solid rgba(99,179,237,.5);font-size:1.4rem;font-weight:700;
                       cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.5);line-height:1">＋</button>
        <button id="btnZoomOut" onclick="t3dZoomOut()" title="Zoom Out"
                style="width:38px;height:38px;border-radius:8px;background:rgba(15,23,42,.92);
                       color:#fff;border:1px solid rgba(99,179,237,.5);font-size:1.4rem;font-weight:700;
                       cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.5);line-height:1">−</button>
    </div>
</div>

<!-- ── Classification legend + inspector ─────────────────────────────── -->
<div class="row mt-3 g-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-2 px-3">
                <h6 class="mb-2">🔑 Classification Legend</h6>
                <div class="d-flex flex-wrap gap-2" id="classLegend">
                    <span class="badge rounded-pill px-3 py-2" style="background:#3b82f6">sedan</span>
                    <span class="badge rounded-pill px-3 py-2" style="background:#22c55e">suv</span>
                    <span class="badge rounded-pill px-3 py-2" style="background:#f59e0b;color:#000">truck</span>
                    <span class="badge rounded-pill px-3 py-2" style="background:#a855f7">motorcycle</span>
                    <span class="badge rounded-pill px-3 py-2" style="background:#64748b">van</span>
                </div>
                <!-- Stats bar -->
                <div class="d-flex flex-wrap gap-3 mt-2 small text-muted" id="statsRow">
                    <span>Ground: <b id="statGround">–</b></span>
                    <span>Zones: <b>@Model.Zones.Count</b></span>
                    <span>Sensors: <b>@Model.Sensors.Count</b></span>
                    <span>Highway: <b id="statHighway">@(Model.SelectedHighwayId ?? "–")</b></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-2 px-3">
                <h6 class="mb-1">🔍 Inspector <small class="text-muted">(click vehicle)</small></h6>
                <div id="inspector" class="text-muted small">No vehicle selected.</div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script id="brandLogosData" type="application/json">@Html.Raw(Model.BrandLogosJson)</script>
<script>
/* ══════════════════════════════════════════════════════════════════════
   TRAFFIC3D — Leaflet-first architecture with 2D canvas vehicle overlay
   
   Design:
   - Leaflet owns the map (real OSM tiles centred on zone GPS coordinates)
   - A transparent 2D canvas overlay sits on top (z-index:2)
   - Vehicles are drawn as coloured circles with brand badges + ID labels
     projected from GPS lat/lon → Leaflet pixelpoint → canvas px
   - Three.js is kept ONLY for the 3D/Side/Perspective views (optional)
   - Zoom: Leaflet.setZoom controls both map tiles AND vehicle scale
   
   The previous architecture had Three.js vehicles in an abstract scene
   coordinate system (XZ_SCALE=800 units) that did not match the real
   GPS positions coming from simulation, causing vehicles to render
   outside the canvas bounds as hexagons.
   ══════════════════════════════════════════════════════════════════════ */

// ── Constants ─────────────────────────────────────────────────────────
let  HW        = '@hw';
const XZ_SCALE  = 800;   // kept for 3D perspective view
const ALT_SCALE = 0.05;

// ── Initial events preloaded by controller ────────────────────────────
const _INITIAL_EVENTS = @Html.Raw(Model.RecentEventsJson ?? "[]");

// ── Zone / Server data from Razor ─────────────────────────────────────
const T3D_SERVERS = @Html.Raw(serversJson);
let T3D_ZONES   = @Html.Raw(zonesJson);
var selectedZoneId   = '';
var selectedServerId = '';

// ── Map centre: zone GPS coordinates (or Dallas default) ──────────────
var _mapCtrLat = @Html.Raw(zoneCtrLat.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture));
var _mapCtrLon = @Html.Raw(zoneCtrLon.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture));

// Initialise from first zone that has coordinates
if (typeof T3D_ZONES !== 'undefined' && T3D_ZONES.length > 0) {
    var _z0 = T3D_ZONES.find(function(z){ return z.lat && z.lon; });
    if (_z0) { _mapCtrLat = _z0.lat; _mapCtrLon = _z0.lon; }
}

// midLat/midLon: scene origin for 3D perspective view
var midLat = _mapCtrLat, midLon = _mapCtrLon;
function norm(lat, lon) {
    return { x: (lon - midLon) * XZ_SCALE, z: (lat - midLat) * XZ_SCALE };
}

// ── Brand badges from VehicleRegistry ────────────────────────────────
var BRAND_BADGES = {};
var BRAND_LOGO_IMAGES = {};
(function() {
    try {
        var raw = document.getElementById('brandLogosData');
        if (!raw) return;
        var data = JSON.parse(raw.textContent || raw.innerHTML);
        if (!data) return;
        Object.keys(data).forEach(function(make) {
            var d = data[make];
            BRAND_BADGES[make] = { color: d.color || '#334155', initials: d.initials || make.slice(0,2).toUpperCase() };
            if (d.svgDataUri) {
                var img = new Image();
                img.src = d.svgDataUri;
                BRAND_LOGO_IMAGES[make] = img;
            }
        });
    } catch(e) { console.warn('Brand badge load error:', e); }
})();

// ── Category colours ──────────────────────────────────────────────────
const CAT_COLORS = {
    sedan:      '#1d4ed8',
    suv:        '#15803d',
    truck:      '#b45309',
    motorcycle: '#7e22ce',
    van:        '#334155'
};
const CAT_SPEC = {
    sedan:      { color: '#3b82f6' },
    suv:        { color: '#22c55e' },
    truck:      { color: '#f59e0b' },
    motorcycle: { color: '#a855f7' },
    van:        { color: '#64748b' }
};

// ── Vehicle classification heuristic ─────────────────────────────────
function classifyVehicle(ev) {
    var cat = 'sedan';
    // Check multiple field names: vehicle_category, vehicleCategory, vehicle_type, vehicleType
    var raw = (ev.vehicle_category || ev.vehicleCategory || ev.VehicleCategory ||
               ev.vehicle_type || ev.vehicleType || ev.VehicleType ||
               ev.vehicle_mode || ev.vehicleMode || ev.VehicleMode || '').toLowerCase();
    if (raw.includes('truck') || raw.includes('pickup'))   cat = 'truck';
    else if (raw.includes('suv'))   cat = 'suv';
    else if (raw.includes('motor') || raw.includes('bike')) cat = 'motorcycle';
    else if (raw.includes('van'))   cat = 'van';
    else if (raw.includes('coupe')) cat = 'sedan';
    else if (raw.includes('sedan'))  cat = 'sedan';
    else {
        var sp = ev.speedMph || ev.SpeedMph || ev.speed_mph || 0;
        if (sp > 85) cat = 'motorcycle';
    }
    // Use classification data if available (from sim broadcast)
    var domain = 'ground';
    if (ev.classification_domain)  domain = ev.classification_domain;
    else if (ev.classification && ev.classification.domain) domain = ev.classification.domain;
    var color = CAT_SPEC[cat]?.color || '#3b82f6';
    if (ev.classification_color) color = ev.classification_color;
    else if (ev.classification && ev.classification.color) color = ev.classification.color;
    return { category: cat, domain: domain, color: color };
}

// ── Simulation / feed state ───────────────────────────────────────────
var simRunning = false;
var feedHeld   = false;
var _simHwId   = null;
var _simZoneId = null;
var _simSrvId  = null;

// ── Vehicle map: vehicleId → { ev, vc, lat, lon, speedMph, make, lastSeen } ──
var vehicleData = new Map();   // GPS-based vehicle store for 2D overlay

// ── Overlay canvas ────────────────────────────────────────────────────
var _oc  = document.getElementById('t3d-label-overlay');
var _octx = _oc ? _oc.getContext('2d') : null;

// ── Leaflet map ───────────────────────────────────────────────────────
var _map = null;
var _tileLayer = null;
var _tileErrors = 0;
var _mapReady = false;

function _initMap() {
    var el = document.getElementById('t3dMiniMap');
    if (!el || typeof L === 'undefined') return;
    if (_map) { _map.remove(); _map = null; }

    _map = L.map('t3dMiniMap', {
        zoomControl: false,
        attributionControl: false,
        dragging: true,
        scrollWheelZoom: false,
        doubleClickZoom: false,
        keyboard: false, boxZoom: false, touchZoom: false
    }).setView([_mapCtrLat, _mapCtrLon], 15);

    // Mark ready immediately — _map.project() works as soon as setView is called.
    // Don't gate rendering on a setTimeout that may fire before DOM is painted.
    _mapReady = true;

    // invalidateSize fixes tile gaps after DOM paint — but doesn't block rendering
    setTimeout(function() { if (_map) _map.invalidateSize(true); }, 80);
    setTimeout(function() { if (_map) _map.invalidateSize(true); }, 300);

    // Allow map to receive mouse events for dragging
    // The 2D overlay canvas (z-index:2) already has pointer-events:none
    _map.getContainer().style.pointerEvents = 'auto';

    _tileLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19, subdomains: 'abc', attribution: '', maxRetries: 1
    }).addTo(_map);

    _tileErrors = 0;
    var _fallbackTimer = setTimeout(function() {
        if (_map && !_map._tileFallback) _applyTileFallback();
    }, 3000);

    _tileLayer.on('tileerror', function() {
        _tileErrors++;
        if (_tileErrors >= 3 && _map && !_map._tileFallback) {
            clearTimeout(_fallbackTimer);
            _applyTileFallback();
        }
    });
    _tileLayer.on('tileload', function() {
        _tileErrors = 0;
        clearTimeout(_fallbackTimer);
    });

    // ── Keep _leafletZoom in sync so the overlay road-width scales correctly ──
    _map.on('zoomend', function() {
        _leafletZoom = _map.getZoom();
        _bridgeDirty = true;
    });
    // ── Keep _mapCtrLat/Lon in sync when the map is panned (e.g. auto-pan) ──
    _map.on('moveend', function() {
        if (_map) {
            var c = _map.getCenter();
            _mapCtrLat = c.lat; _mapCtrLon = c.lng;
        }
    });
}

function _applyTileFallback() {
    if (!_map) return;
    _map._tileFallback = true;
    if (_tileLayer) _tileLayer.remove();
    var el = document.getElementById('t3dMiniMap');
    if (el) el.style.background = 'linear-gradient(135deg, #1a2f1a 0%, #2a3a2a 50%, #1a2040 100%)';
}

function _panMapTo(lat, lon) {
    if (!_map) return;
    _mapCtrLat = lat; _mapCtrLon = lon;
    _map.setView([lat, lon], _map.getZoom() || _leafletZoom, { animate: false });
    _map.invalidateSize();
    // Force a second invalidateSize + bridge redraw after the map
    // has processed the setView — tiles may not be loaded yet but
    // the projection needs the correct container size.
    var _panLat = lat, _panLon = lon;
    setTimeout(function() {
        if (_map) {
            _map.invalidateSize(true);
            _bridgeDirty = true;
            _forceBridgeRedraw();
        }
    }, 150);
}

// ── Zoom: Leaflet zoom level controls both map + vehicle size ─────────
var _leafletZoom = 15;

function t3dZoomIn() {
    if (!_map) return;
    _leafletZoom = Math.min(18, (_map.getZoom() || _leafletZoom) + 1);
    _map.setZoom(_leafletZoom, { animate: false });
    _bridgeDirty = true;
    if (_map) _map.invalidateSize();
}
function t3dZoomOut() {
    if (!_map) return;
    _leafletZoom = Math.max(10, (_map.getZoom() || _leafletZoom) - 1);
    _map.setZoom(_leafletZoom, { animate: false });
    _bridgeDirty = true;
    if (_map) _map.invalidateSize();
}

// Mouse wheel: zoom in/out
document.getElementById('t3dMiniMap').addEventListener('wheel', function(e) {
    e.preventDefault();
    if (e.deltaY < 0) t3dZoomIn(); else t3dZoomOut();
}, { passive: false });

// ── Highway overlay: GPS-locked road strip aligned to the real highway ──
// _hwyLat/Lon: the exact centreline GPS coordinate of the selected zone.
// _hwyIsEW:    true for E-W highways (I-20, I-10, I-30), false for N-S.
// The overlay is redrawn every animation frame using Leaflet projection,
// so it automatically tracks zoom + pan without any extra re-computation.
var _hwyLat   = 0, _hwyLon = 0;
var _hwyIsEW  = true;
// Array of {lat, lon} for ALL zones on the current highway — used to draw
// a multi-segment polyline that follows the actual road curvature.
var _hwyPath  = [];
var _bridgeDirty = true;  // forces full bridge re-projection on next frame

function _isEWHighway(hwId) {
    var h = (hwId || '').toUpperCase();
    if (h.indexOf('I35') >= 0 || h.indexOf('I-35') >= 0 ||
        h.indexOf('I45') >= 0 || h.indexOf('I-45') >= 0 ||
        h.indexOf('I25') >= 0 || h.indexOf('I-25') >= 0) return false;
    return true;
}

// ── Highway bearing: server-provided value takes priority ────────────
// _hwBearingDeg is set from data.hwBearing on every GetAnimationData
// fetch. It is computed server-side from actual zone GPS in the DB.
// Hardcoded fallbacks (corrected from zone GPS) only apply pre-fetch.
function _hwBearing(hwId) {
    if (typeof _hwBearingDeg === 'number' && _hwBearingDeg !== 90.0) {
        return _hwBearingDeg;
    }
    // Corrected fallbacks (atan2 from zone GPS, not guessed):
    var h = (hwId || '').toUpperCase();
    if (h.indexOf('I35') >= 0 || h.indexOf('I-35') >= 0) return 206;
    if (h.indexOf('I45') >= 0 || h.indexOf('I-45') >= 0) return 348;
    if (h.indexOf('I25') >= 0 || h.indexOf('I-25') >= 0) return 355;
    if (h.indexOf('I20') >= 0 || h.indexOf('I-20') >= 0) return 269;
    if (h.indexOf('I10') >= 0 || h.indexOf('I-10') >= 0) return  75;
    return _hwBearingDeg || 90;
}

// ── Extend a point along a bearing by distDeg degrees ────────────────
function _bearingPoint(lat, lon, bearing, distDeg) {
    var rad = bearing * Math.PI / 180;
    var cosLat = Math.cos(lat * Math.PI / 180);
    return {
        lat: lat + Math.cos(rad) * distDeg,
        lon: lon + Math.sin(rad) * distDeg / cosLat
    };
}

function _setHighwayCoords(lat, lon, hwId) {
    _hwyLat  = lat;
    _hwyLon  = lon;
    _hwyIsEW = _isEWHighway(hwId);
    _hwyHeading = _hwyIsEW ? 'EW' : 'NS';

    // ── PRIORITY: use server-provided dense bridge path ──────────────
    // When bridgePath is available from GetAnimationData, use it directly
    // as the road polyline — it is computed from real zone GPS coordinates
    // and is always geometrically correct.
    if (_bridgePathCoords && _bridgePathCoords.length >= 2) {
        _hwyPath = _bridgePathCoords.map(function(p) {
            return { lat: p.lat, lon: p.lon };
        });
        console.log('[T3D] _setHighwayCoords: using server bridgePath (' + _hwyPath.length + ' pts)');
        if (typeof roadGroup3 !== 'undefined') {
            roadGroup3.rotation.y = _hwyIsEW ? 0 : Math.PI / 2;
        }
        return;
    }

    // ── FALLBACK: build path from zone anchors + server bearing ─────
    var bearing = _hwBearing(hwId);
    _hwyPath = [];
    if (typeof T3D_ZONES !== 'undefined' && T3D_ZONES.length > 0) {
        var cosLat = Math.cos(lat * Math.PI / 180);
        var bearRad = bearing * Math.PI / 180;
        var sorted = T3D_ZONES.filter(function(z){ return z.lat && z.lon; }).slice();
        sorted.sort(function(a, b) {
            var pa = Math.cos(bearRad) * a.lat + Math.sin(bearRad) * a.lon * cosLat;
            var pb = Math.cos(bearRad) * b.lat + Math.sin(bearRad) * b.lon * cosLat;
            return pa - pb;
        });
        sorted.forEach(function(z) {
            _hwyPath.push({ lat: z.lat, lon: z.lon, zoneId: z.zoneId });
        });
    }
    if (_hwyPath.length === 0 && lat && lon) {
        _hwyPath = [{ lat: lat, lon: lon, zoneId: '' }];
    }
    if (typeof roadGroup3 !== 'undefined') {
        roadGroup3.rotation.y = _hwyIsEW ? 0 : Math.PI / 2;
    }
}

function _forceBridgeRedraw() {
    if (T3D_ZONES.length > 0) {
        var z0 = T3D_ZONES.find(function(z){ return z.lat && z.lon; }) || T3D_ZONES[0];
        _setHighwayCoords(z0.lat, z0.lon, HW);
    }
    _bridgeDirty = true;
    if (_map) _map.invalidateSize();
    console.log('[T3D] Bridge redraw forced: path=' + _hwyPath.length + ' isEW=' + _hwyIsEW);
}

function _projectLatLng(lat, lon) {
    // Project a GPS coordinate to screen-relative pixel coords.
    if (_map && _mapReady) {
        var origin = _map.getPixelOrigin();
        var p = _map.project([lat, lon], _map.getZoom());
        return { x: p.x - origin.x, y: p.y - origin.y };
    }
    var zfb = _leafletZoom || 15;
    var pxPerDeg = Math.pow(2, zfb) * 256 / 360;
    return {
        x: _oc.width/2  + (lon - _mapCtrLon) * pxPerDeg,
        y: _oc.height/2 - (lat - _mapCtrLat) * pxPerDeg
    };
}

// ── Bridge path + bearing from server ───────────────────────────────
// Populated from GetAnimationData response.
// _hwBearingDeg: actual road bearing computed from zone GPS (0=N, 90=E)
// _bridgePathCoords: dense GPS waypoints end-to-end (330m spacing)
// _bridgeRoadWidth: perpendicular clamping width (~39m)
var _bridgePathCoords = [];
var _bridgeRoadWidth  = 0.00018;  // ±road width in degrees (~20m per lane)
var _hwBearingDeg     = 90.0;     // updated from server on every fetch

/// Find the nearest point on the bridge path to a GPS coordinate.
/// Returns: { lat, lon, bearing, perpDist, clampedLat, clampedLon, segIndex }
///   bearing   — road heading at the nearest segment (degrees, 0=N 90=E)
///   perpDist  — perpendicular distance from the path (degrees)
///   clampedLat/Lon — position clamped to ±roadWidth of the path
function _nearestOnBridgePath(lat, lon) {
    if (!_bridgePathCoords || _bridgePathCoords.length < 2) return null;
    var bestDist = Infinity;
    var best = null;

    for (var i = 0; i < _bridgePathCoords.length - 1; i++) {
        var p1 = _bridgePathCoords[i];
        var p2 = _bridgePathCoords[i + 1];
        var dx = p2.lat - p1.lat;
        var dy = p2.lon - p1.lon;
        var segLen2 = dx * dx + dy * dy;
        if (segLen2 < 1e-12) continue;

        // Project vehicle point onto segment
        var t = ((lat - p1.lat) * dx + (lon - p1.lon) * dy) / segLen2;
        t = Math.max(0, Math.min(1, t));
        var projLat = p1.lat + dx * t;
        var projLon = p1.lon + dy * t;
        var perpLat = lat - projLat;
        var perpLon = lon - projLon;
        var perpDist = Math.sqrt(perpLat * perpLat + perpLon * perpLon);

        if (perpDist < bestDist) {
            bestDist = perpDist;
            var cosLat = Math.cos(p1.lat * Math.PI / 180);
            var bearing = Math.atan2(dy * cosLat, dx) * 180 / Math.PI;
            if (bearing < 0) bearing += 360;

            // Clamp to ±roadWidth perpendicular to path
            var clampedLat = projLat, clampedLon = projLon;
            if (perpDist > _bridgeRoadWidth && perpDist > 0) {
                var clampT = _bridgeRoadWidth / perpDist;
                clampedLat = projLat + perpLat * clampT;
                clampedLon = projLon + perpLon * clampT;
            }

            best = {
                lat: projLat, lon: projLon,
                bearing: bearing,
                perpDist: perpDist,
                clampedLat: clampedLat, clampedLon: clampedLon,
                segIndex: i
            };
        }
    }
    return best;
}

// ── Clip the highway polyline to geographic bounds ──────────────────
// Takes the projected screen pts + raw GPS path + clip rect (in GPS degrees).
// Returns a new array of screen pts, clipped to the bounding box.
function _clipPathToBounds(screenPts, gpsPts, minLat, maxLat, minLon, maxLon) {
    if (screenPts.length === 0) return screenPts;
    if (screenPts.length === 1) {
        // Single point — check if it's inside bounds
        var p = gpsPts[0];
        if (p.lat >= minLat && p.lat <= maxLat && p.lon >= minLon && p.lon <= maxLon) {
            return screenPts;
        }
        return [];
    }

    // For each segment, clip to the GPS bounds using Cohen-Sutherland-style logic
    // We work in GPS space, then project the clipped endpoints to screen coords.
    var result = [];
    for (var i = 0; i < gpsPts.length - 1; i++) {
        var lat1 = gpsPts[i].lat, lon1 = gpsPts[i].lon;
        var lat2 = gpsPts[i+1].lat, lon2 = gpsPts[i+1].lon;
        var inside1 = lat1 >= minLat && lat1 <= maxLat && lon1 >= minLon && lon1 <= maxLon;
        var inside2 = lat2 >= minLat && lat2 <= maxLat && lon2 >= minLon && lon2 <= maxLon;

        if (inside1 && inside2) {
            // Both inside — add both (dedup: only add p1 if result is empty or different)
            if (result.length === 0) {
                result.push(_projectLatLng(lat1, lon1));
            }
            result.push(_projectLatLng(lat2, lon2));
        } else if (inside1 && !inside2) {
            // p1 inside, p2 outside — clip at boundary
            var clip = _clipSegmentToBox(lat1, lon1, lat2, lon2, minLat, maxLat, minLon, maxLon, false);
            if (result.length === 0) result.push(_projectLatLng(lat1, lon1));
            if (clip) result.push(_projectLatLng(clip.lat, clip.lon));
        } else if (!inside1 && inside2) {
            // p1 outside, p2 inside — clip at boundary
            var clip = _clipSegmentToBox(lat1, lon1, lat2, lon2, minLat, maxLat, minLon, maxLon, true);
            if (clip) result.push(_projectLatLng(clip.lat, clip.lon));
            result.push(_projectLatLng(lat2, lon2));
        }
        // Both outside — skip segment entirely
    }
    // Handle single-point path
    if (result.length === 0 && gpsPts.length === 1) {
        var p = gpsPts[0];
        if (p.lat >= minLat && p.lat <= maxLat && p.lon >= minLon && p.lon <= maxLon) {
            // Single point inside — extend along highway axis to fill bounds
            var extLat = (maxLat - minLat) / 2;
            var extLon = (maxLon - minLon) / 2;
            if (_hwyIsEW) {
                result.push(_projectLatLng(p.lat, p.lon - extLon));
                result.push(_projectLatLng(p.lat, p.lon + extLon));
            } else {
                result.push(_projectLatLng(p.lat - extLat, p.lon));
                result.push(_projectLatLng(p.lat + extLat, p.lon));
            }
        }
    }
    // Extend first/last points slightly beyond bounds so the line reaches the clip edge
    if (result.length >= 2) {
        var extPx = Math.max(cw, ch) * 0.1;
        var d0x = result[0].x - result[1].x, d0y = result[0].y - result[1].y;
        var l0 = Math.hypot(d0x, d0y);
        if (l0 > 0) { result[0].x += d0x/l0 * extPx; result[0].y += d0y/l0 * extPx; }
        var n = result.length;
        var dNx = result[n-1].x - result[n-2].x, dNy = result[n-1].y - result[n-2].y;
        var lN = Math.hypot(dNx, dNy);
        if (lN > 0) { result[n-1].x += dNx/lN * extPx; result[n-1].y += dNy/lN * extPx; }
    }
    return result;
}

// Helper: clip a GPS line segment to a bounding box — returns the intersection point
function _clipSegmentToBox(lat1, lon1, lat2, lon2, minLat, maxLat, minLon, maxLon, fromOutside) {
    // Simple parametric clipping: find t where the line crosses the box edge
    var dLat = lat2 - lat1, dLon = lon2 - lon1;
    var t = 1;
    // Check each boundary
    if (dLat !== 0) {
        var tMin = (minLat - lat1) / dLat;
        var tMax = (maxLat - lat1) / dLat;
        if (tMin > 0 && tMin <= 1) t = Math.min(t, tMin);
        if (tMax > 0 && tMax <= 1) t = Math.min(t, tMax);
    }
    if (dLon !== 0) {
        var tMin2 = (minLon - lon1) / dLon;
        var tMax2 = (maxLon - lon1) / dLon;
        if (tMin2 > 0 && tMin2 <= 1) t = Math.min(t, tMin2);
        if (tMax2 > 0 && tMax2 <= 1) t = Math.min(t, tMax2);
    }
    if (t <= 0 || t > 1) return null;
    return { lat: lat1 + dLat * t, lon: lon1 + dLon * t };
}

function _drawHighwayOverlay() {
    if (!_oc || !_octx) return;
    if (!_hwyPath.length) return;
    var cw = _oc.width, ch = _oc.height;
    if (cw < 2 || ch < 2) return;
    if (_bridgeDirty && _map) { _map.invalidateSize(); _bridgeDirty = false; }
    // Debug: log bridge state every 5 seconds (throttled)
    if (!window._lastBridgeLog || Date.now() - window._lastBridgeLog > 5000) {
        window._lastBridgeLog = Date.now();
        var _dbgCenter = _map ? _map.getCenter() : { lat: _mapCtrLat, lng: _mapCtrLon };
        console.log('[T3D] Bridge: path=' + _hwyPath.length + ' isEW=' + _hwyIsEW +
            ' HW=' + HW + ' zone=' + selectedZoneId + ' srv=' + selectedServerId +
            ' mapCenter=(' + _dbgCenter.lat.toFixed(4) + ',' + _dbgCenter.lng.toFixed(4) + ')' +
            ' canvas=' + cw + 'x' + ch + ' mapReady=' + _mapReady);
    }

    var zoomFactor;
    if (_map && _mapReady) {
        zoomFactor = Math.pow(2, _map.getZoom() - 15);
    } else {
        zoomFactor = Math.pow(2, (_leafletZoom || 15) - 15);
    }
    var roadPx = Math.max(24, Math.round(48 * zoomFactor));

    // ── Project ALL highway zone points to screen coords ────────────────
    var pts = _hwyPath.map(function(p) {
        return _projectLatLng(p.lat, p.lon);
    });

    // ── Always extend the first and last segments to fill the screen ──
    // The bridge is a polyline connecting ALL zones on the highway.
    // It should always be fully drawn — the map zoom/pan handles what's
    // visible. Previous zone-based clipping could eliminate all points
    // when zones were far apart (e.g., I-10 Z001 vs Z003 are 1.4° apart),
    // resulting in pts.length < 2 and no bridge drawn at all.
    if (pts.length >= 2) {
        var extLen = Math.max(cw, ch) * 1.5;
        var dx0 = pts[0].x - pts[1].x, dy0 = pts[0].y - pts[1].y;
        var len0 = Math.hypot(dx0, dy0);
        if (len0 > 0) {
            pts[0].x += dx0 / len0 * extLen;
            pts[0].y += dy0 / len0 * extLen;
        }
        var n = pts.length;
        var dxN = pts[n-1].x - pts[n-2].x, dyN = pts[n-1].y - pts[n-2].y;
        var lenN = Math.hypot(dxN, dyN);
        if (lenN > 0) {
            pts[n-1].x += dxN / lenN * extLen;
            pts[n-1].y += dyN / lenN * extLen;
        }
    } else if (pts.length === 1) {
        // Single zone — extend along highway axis to fill the screen
        var extLen2 = Math.max(cw, ch) * 1.5;
        if (_hwyIsEW) {
            pts = [
                { x: pts[0].x - extLen2, y: pts[0].y },
                { x: pts[0].x + extLen2, y: pts[0].y }
            ];
        } else {
            pts = [
                { x: pts[0].x, y: pts[0].y - extLen2 },
                { x: pts[0].x, y: pts[0].y + extLen2 }
            ];
        }
    }

    if (pts.length < 2) {
        console.warn('[T3D] Bridge: pts.length=' + pts.length + ' path=' + _hwyPath.length + ' — cannot draw');
        return;
    }

    // ── Helper: draw a polyline through all projected points ───────────
    function _strokePath() {
        _octx.beginPath();
        _octx.moveTo(pts[0].x, pts[0].y);
        for (var i = 1; i < pts.length; i++) {
            _octx.lineTo(pts[i].x, pts[i].y);
        }
        _octx.stroke();
    }

    // ── Road surface (semi-transparent asphalt) ────────────────────────
    _octx.strokeStyle = 'rgba(80, 100, 120, 0.55)';
    _octx.lineWidth = roadPx;
    _octx.lineCap = 'butt';
    _octx.lineJoin = 'round';
    _strokePath();

    // ── Centre yellow line ──────────────────────────────────────────────
    _octx.strokeStyle = 'rgba(253, 224, 71, 0.90)';
    _octx.lineWidth = Math.max(2, 3 * zoomFactor);
    _octx.setLineDash([]);
    _strokePath();

    // ── Lane dashes — perpendicular offset from centre ──────────────────
    _octx.strokeStyle = 'rgba(255,255,255,0.70)';
    _octx.lineWidth = Math.max(1, 1.5 * zoomFactor);
    _octx.setLineDash([20 * zoomFactor, 14 * zoomFactor]);
    var laneOff = roadPx / 4;
    // Compute perpendicular for each segment — use average direction
    for (var si = 0; si < pts.length - 1; si++) {
        var sdx = pts[si+1].x - pts[si].x;
        var sdy = pts[si+1].y - pts[si].y;
        var slen = Math.hypot(sdx, sdy);
        if (slen < 1) continue;
        var spx = -sdy / slen, spy = sdx / slen;
        [-laneOff, laneOff].forEach(function(off) {
            _octx.beginPath();
            _octx.moveTo(pts[si].x + spx * off, pts[si].y + spy * off);
            _octx.lineTo(pts[si+1].x + spx * off, pts[si+1].y + spy * off);
            _octx.stroke();
        });
    }
    _octx.setLineDash([]);

    // ── Edge kerb lines ─────────────────────────────────────────────────
    _octx.strokeStyle = 'rgba(255,255,255,0.55)';
    _octx.lineWidth = Math.max(2, 3 * zoomFactor);
    for (var ki = 0; ki < pts.length - 1; ki++) {
        var kdx = pts[ki+1].x - pts[ki].x;
        var kdy = pts[ki+1].y - pts[ki].y;
        var klen = Math.hypot(kdx, kdy);
        if (klen < 1) continue;
        var kpx = -kdy / klen, kpy = kdx / klen;
        [-roadPx/2, roadPx/2].forEach(function(off) {
            _octx.beginPath();
            _octx.moveTo(pts[ki].x + kpx * off, pts[ki].y + kpy * off);
            _octx.lineTo(pts[ki+1].x + kpx * off, pts[ki+1].y + kpy * off);
            _octx.stroke();
        });
    }

    // ── Zone anchor pins — mark each real GPS coordinate on the map ────
    // These show exactly where the bridge connects to the highway.
    _hwyPath.forEach(function(zp) {
        var pp = _projectLatLng(zp.lat, zp.lon);
        // Pin circle — small, just enough to mark the zone anchor
        _octx.beginPath();
        _octx.arc(pp.x, pp.y, 3, 0, Math.PI * 2);
        _octx.fillStyle = 'rgba(253,224,71,0.85)';
        _octx.fill();
        _octx.strokeStyle = 'rgba(0,0,0,0.6)';
        _octx.lineWidth = 1;
        _octx.stroke();
        // Inner dot
        _octx.beginPath();
        _octx.arc(pp.x, pp.y, 1.2, 0, Math.PI * 2);
        _octx.fillStyle = '#fff';
        _octx.fill();
        // Zone label
        _octx.save();
        _octx.shadowColor = 'rgba(255,255,255,0.8)';
        _octx.shadowBlur = 3;
        _octx.fillStyle = '#000';
        _octx.font = 'bold 8px monospace';
        _octx.textAlign = 'center';
        _octx.textBaseline = 'bottom';
        _octx.fillText(zp.zoneId || '', pp.x, pp.y - 9);
        _octx.restore();
    });
}

// ── Vehicle overlay: draw vehicles as GPS-projected circles with labels ──
function _drawVehicles() {
    if (!_oc || !_octx) return;
    var cw = _oc.width, ch = _oc.height;
    if (cw < 2 || ch < 2) return;

    vehicleData.forEach(function(vd, vid) {
        if (!vd.lat || !vd.lon) return;

        var sx, sy;
        if (_map && _mapReady) {
            // Primary: Leaflet projection — exact GPS → pixel
            var origin = _map.getPixelOrigin();
            var mapPt  = _map.project([vd.lat, vd.lon], _map.getZoom());
            sx = mapPt.x - origin.x;
            sy = mapPt.y - origin.y;
        } else {
            // Fallback: simple linear projection from map centre
            var zoom = _leafletZoom || 15;
            var pxPerDeg = Math.pow(2, zoom) * 256 / 360;
            sx = cw / 2 + (vd.lon - _mapCtrLon) * pxPerDeg;
            sy = ch / 2 - (vd.lat - _mapCtrLat) * pxPerDeg;
        }

        // ── Directional lane separation ─────────────────────────────────
        // Apply a perpendicular visual offset so opposing traffic renders
        // on opposite sides of the road centreline.
        // Road overlay is ~28px wide so ±10px keeps each lane distinct.
        var laneHalfPx = 10;
        var vDir = vd.direction || 0;
        if (vd.isNSHwy) {
            // N-S highway: northbound (0°) shift left (−sx), southbound (180°) shift right (+sx)
            sx += (vDir <= 90 || vDir >= 270) ? -laneHalfPx : laneHalfPx;
        } else {
            // E-W highway: eastbound (90°) shift north (−sy), westbound (270°) shift south (+sy)
            sy += (vDir >= 45 && vDir <= 135) ? -laneHalfPx : laneHalfPx;
        }

        // Cull off-screen
        if (sx < -60 || sx > cw + 60 || sy < -60 || sy > ch + 60) return;

        var cat   = vd.vc ? vd.vc.category : 'sedan';
        var color = CAT_COLORS[cat] || '#1d4ed8';
        var make  = vd.make || '';
        var badge = BRAND_BADGES[make];
        var logoImg = BRAND_LOGO_IMAGES[make];
        var dir = vd.direction || 0;
        var spd = vd.speedMph || 0;

        // ── Car silhouette with brand logo ─────────────────────────────
        // Car drawn with long axis = X (pointing East by default).
        // Rotation formula: carRot = (dir - 90) * PI/180
        //   dir=90  (East)  → carRot=0   → long axis East  ✅
        //   dir=0   (North) → carRot=-PI/2 → long axis North ✅
        //   dir=270 (West)  → carRot=PI   → long axis West  ✅
        //   dir=180 (South) → carRot=PI/2 → long axis South ✅
        var carW = 30, carH = 15;   // long=X, short=Y (body dimensions in px)
        var carRot = (dir - 90) * Math.PI / 180;

        _octx.save();
        _octx.translate(sx, sy);
        _octx.rotate(carRot);

        // ── Car body ──────────────────────────────────────────────────
        _octx.beginPath();
        _octx.roundRect(-carW/2, -carH/2, carW, carH, 5);
        _octx.fillStyle = color;
        _octx.fill();
        _octx.strokeStyle = 'rgba(255,255,255,0.9)';
        _octx.lineWidth = 1.8;
        _octx.stroke();

        // ── Roof / cabin highlight (raised section, centred) ──────────
        _octx.beginPath();
        _octx.roundRect(-carW/2 + 5, -carH/2 + 2, carW - 10, carH - 4, 3);
        _octx.fillStyle = 'rgba(255,255,255,0.18)';
        _octx.fill();

        // ── Front nose — brighter tint shows drive direction ──────────
        _octx.beginPath();
        _octx.roundRect(carW/2 - 6, -carH/2 + 2, 5, carH - 4, 2);
        _octx.fillStyle = 'rgba(255,255,255,0.45)';
        _octx.fill();

        // ── Wheels — 4 ellipses perpendicular to car long-axis ────────
        // Wheels are along the Y axis (short axis) so they are always
        // perpendicular to the road — this is the natural result of the
        // correct rotation formula above.
        var wW = 4, wH = 7;   // wheel: narrow along car axis, tall across it
        _octx.fillStyle = '#111827';
        _octx.strokeStyle = 'rgba(255,255,255,0.6)';
        _octx.lineWidth = 0.8;
        // Front-left, front-right, rear-left, rear-right
        [[carW/2 - 6,  carH/2 - 1],
         [carW/2 - 6, -carH/2 - 2],
         [-carW/2 + 3,  carH/2 - 1],
         [-carW/2 + 3, -carH/2 - 2]].forEach(function(w) {
            _octx.beginPath();
            _octx.ellipse(w[0], w[1], wW/2, wH/2, 0, 0, Math.PI * 2);
            _octx.fill();
            _octx.stroke();
        });

        // ── Brand logo centered on car body ───────────────────────────
        if (logoImg && logoImg.complete && logoImg.naturalWidth > 0) {
            _octx.drawImage(logoImg, -10, -7, 20, 14);
        } else if (badge) {
            // Initials badge
            _octx.beginPath();
            _octx.arc(0, 0, 7, 0, Math.PI * 2);
            _octx.fillStyle = badge.color;
            _octx.fill();
            _octx.strokeStyle = 'rgba(255,255,255,0.55)';
            _octx.lineWidth = 1.2;
            _octx.stroke();
            _octx.fillStyle = '#fff';
            _octx.font = badge.initials.length > 2 ? 'bold 6px Arial' : 'bold 9px Arial';
            _octx.textAlign = 'center';
            _octx.textBaseline = 'middle';
            _octx.fillText(badge.initials, 0, 0.5);
        } else {
            // Generic dot fallback
            _octx.beginPath();
            _octx.arc(0, 0, 5, 0, Math.PI * 2);
            _octx.fillStyle = 'rgba(255,255,255,0.4)';
            _octx.fill();
        }

        _octx.restore();

        // Heading arrow — extends from the front of the car
        if (dir && spd > 0) {
            var arrowRad = (dir - 90) * Math.PI / 180;
            var arrowLen = 14;
            var ax2 = sx + Math.cos(arrowRad) * arrowLen;
            var ay2 = sy + Math.sin(arrowRad) * arrowLen;
            _octx.beginPath();
            _octx.moveTo(sx + Math.cos(arrowRad) * 10, sy + Math.sin(arrowRad) * 10);
            _octx.lineTo(ax2, ay2);
            _octx.strokeStyle = 'rgba(255,255,255,0.7)';
            _octx.lineWidth = 2;
            _octx.stroke();
        }

        // Speed indicator ring (arc proportional to speed)
        var arc = (Math.min(spd, 120) / 120) * Math.PI * 2;
        _octx.beginPath();
        _octx.arc(sx, sy, 15, -Math.PI / 2, -Math.PI / 2 + arc);
        _octx.strokeStyle = 'rgba(253,224,71,0.75)';
        _octx.lineWidth = 2;
        _octx.stroke();

        // ── Transparent tooltip (no dark background) ────────────────────
        // Text with shadow for readability — no filled pill background.
        var tipW = 120, tipH = 30;
        var tipX = Math.max(2, Math.min(cw - tipW - 2, sx - tipW / 2));
        var tipY = sy - 48;
        if (tipY < 2) tipY = sy + 20;

        // Connector line (thin, semi-transparent)
        var lineFx = tipX + tipW / 2;
        var lineFy = tipY < sy ? tipY + tipH : tipY;
        _octx.strokeStyle = 'rgba(0,0,0,0.35)';
        _octx.lineWidth = 1;
        _octx.setLineDash([3, 3]);
        _octx.beginPath();
        _octx.moveTo(lineFx, lineFy);
        _octx.lineTo(sx, sy);
        _octx.stroke();
        _octx.setLineDash([]);

        // Vehicle ID — bold black text with light shadow for legibility
        _octx.save();
        _octx.shadowColor = 'rgba(255,255,255,0.85)';
        _octx.shadowBlur = 3;
        _octx.fillStyle = '#000';
        _octx.font = 'bold 10px monospace';
        _octx.textAlign = 'left';
        _octx.textBaseline = 'top';
        _octx.fillText((vid || '–').slice(0, 14), tipX + 4, tipY + 3);

        // Make + category — smaller, dark grey
        _octx.fillStyle = 'rgba(0,0,0,0.8)';
        _octx.font = '9px Arial';
        _octx.textBaseline = 'bottom';
        var makeCat = (make ? make.slice(0, 12) : '') + (make && cat ? ' · ' : '') + cat;
        _octx.fillText(makeCat, tipX + 4, tipY + tipH - 3);

        // Speed — right-aligned, dark with amber tint
        if (spd > 0) {
            _octx.fillStyle = 'rgba(120,53,15,0.95)';
            _octx.font = 'bold 9px monospace';
            _octx.textAlign = 'right';
            _octx.textBaseline = 'top';
            _octx.fillText(spd + 'mph', tipX + tipW - 4, tipY + 3);
        }
        _octx.restore();
    });
}

// ── Animation loop: runs at 60fps, redraws overlay on every frame ─────

// ── Per-frame vehicle movement ──────────────────────────────────────
// Moves each vehicle along its heading at its speed (mph → deg/s).
// 1 mph ≈ 0.447 m/s; 1° lat ≈ 111,000 m; 1° lon at 32.7°N ≈ 93,100 m.
var _lastMoveTime = Date.now();
function _updateVehiclePositions() {
    var now = Date.now();
    var dt = (now - _lastMoveTime) / 1000;
    if (dt > 0.5) dt = 0.5;   // max 0.5s step to prevent teleports on tab resume
    _lastMoveTime = now;
    if (dt <= 0) return;

    // Pre-compute degree-per-metre ratios at current map centre
    var refLat = _mapCtrLat || 32.7213;
    var latPerM = 1 / 111000;
    var lonPerM = 1 / (111000 * Math.cos(refLat * Math.PI / 180));

    // ── Compute bridge path endpoints for vehicle removal ────────────────
    // Vehicles that travel past the first or last bridge path coordinate
    // have reached the end of the highway and should disappear.
    var pathStart = null, pathEnd = null;
    if (_bridgePathCoords.length >= 2) {
        pathStart = _bridgePathCoords[0];
        pathEnd   = _bridgePathCoords[_bridgePathCoords.length - 1];
    }
    // Extend the endpoints slightly so vehicles exit the visible area
    // before being removed (20% of the total path length as margin).
    var pathMargin = 0;
    if (_bridgePathCoords.length >= 2) {
        var totalLat = Math.abs(pathEnd.lat - pathStart.lat);
        var totalLon = Math.abs(pathEnd.lon - pathStart.lon);
        pathMargin = Math.max(totalLat, totalLon) * 0.15;
    }

    // ── Move each vehicle in the sim's direction at the sim's speed ──────
    // No wrapping, no bouncing, no re-projection. Vehicles move freely
    // from their starting GPS in the direction the sim specified, at the
    // speed the sim specified. They disappear when they pass the highway
    // endpoints.
    var toRemove = [];
    vehicleData.forEach(function(vd, vid) {
        var spd = vd.speedMph || 0;
        if (spd < 1) return;
        var ms  = spd * 0.44704;          // mph -> m/s
        var dir = vd.direction || 0;
        if (dir <= 0) dir = _hwBearingDeg; // fallback if missing

        // ── 1. Move along the sim's direction ────────────────────────────
        var rad  = dir * Math.PI / 180;
        var dLat = ms * Math.cos(rad) * dt * latPerM;
        var dLon = ms * Math.sin(rad) * dt * lonPerM;
        var newLat = vd.lat + dLat;
        var newLon = vd.lon + dLon;

        // ── 2. Gentle lane keeping — nudge toward road if drifting ────────
        // Apply a very gentle correction only if the vehicle has drifted
        // more than 3x road width from the bridge centreline. This keeps
        // vehicles roughly on the road without overriding their position.
        if (_bridgePathCoords.length >= 2) {
            var snap = _nearestOnBridgePath(newLat, newLon);
            if (snap && snap.perpDist > _bridgeRoadWidth * 3) {
                var perpRad = snap.bearing * Math.PI / 180 + Math.PI / 2;
                var cosLat2 = Math.cos(snap.lat * Math.PI / 180);
                newLat = snap.lat + Math.cos(perpRad) * vd.laneSide * _bridgeRoadWidth;
                newLon = snap.lon + Math.sin(perpRad) * vd.laneSide * _bridgeRoadWidth / cosLat2;
            }
        }

        // ── 3. Check if vehicle has reached the end of the highway ───────
        // Compare the vehicle's along-axis position against the bridge
        // endpoints. If it has passed either end (plus margin), remove it.
        if (pathStart && pathEnd) {
            if (_hwyIsEW) {
                // E-W highway: check longitude
                var minLon = Math.min(pathStart.lon, pathEnd.lon) - pathMargin;
                var maxLon = Math.max(pathStart.lon, pathEnd.lon) + pathMargin;
                if (newLon < minLon || newLon > maxLon) {
                    console.log('[T3D] Vehicle ' + vid + ' reached highway end (lon=' + newLon.toFixed(4) + ') — removing');
                    toRemove.push(vid);
                    return;
                }
            } else {
                // N-S highway: check latitude
                var minLat = Math.min(pathStart.lat, pathEnd.lat) - pathMargin;
                var maxLat = Math.max(pathStart.lat, pathEnd.lat) + pathMargin;
                if (newLat < minLat || newLat > maxLat) {
                    console.log('[T3D] Vehicle ' + vid + ' reached highway end (lat=' + newLat.toFixed(4) + ') — removing');
                    toRemove.push(vid);
                    return;
                }
            }
        }

        // ── FINAL SANITY CHECK ─────────────────────────────────────────────
        if (isNaN(newLat) || isNaN(newLon) || (newLat === 0 && newLon === 0)) {
            return;
        }
        vd.lat = newLat;
        vd.lon = newLon;
    });

    // Remove vehicles that reached the highway end
    toRemove.forEach(function(vid) { vehicleData.delete(vid); });
}

var _animFrame = null;
var _renderErrors = 0;
function _renderLoop() {
    _animFrame = requestAnimationFrame(_renderLoop);
    try {
        // Sync overlay canvas size with container
        var wrap = document.getElementById('sceneWrap');
        if (wrap && _oc) {
            var cw = wrap.clientWidth, ch = wrap.clientHeight;
            if (_oc.width !== cw || _oc.height !== ch) { _oc.width = cw; _oc.height = ch; }
        }
        if (_octx && _oc) {
            _octx.clearRect(0, 0, _oc.width, _oc.height);
            _updateVehiclePositions();
            _drawHighwayOverlay();
            _drawVehicles();
        }
    } catch(e) {
        _renderErrors++;
        if (_renderErrors <= 5) console.warn('[T3D] Render error #' + _renderErrors + ':', e);
    }
}

// ── THREE.JS SCENE (Perspective/Side/Split views) ─────────────────────
// Three.js is kept for the 3D perspective and side-elevation views.
// In Top view, we use the 2D canvas overlay above instead.
const _3dCanvas = document.getElementById('mainCanvas');
const renderer  = new THREE.WebGLRenderer({ canvas: _3dCanvas, antialias: true, alpha: true });
renderer.setClearColor(0x000000, 0);
renderer.setPixelRatio(window.devicePixelRatio);
renderer.setSize(_3dCanvas.clientWidth, _3dCanvas.clientHeight);

const scene3 = new THREE.Scene();
scene3.fog = new THREE.Fog(0x2a3a2a, 800, 1400);
scene3.add(new THREE.HemisphereLight(0xbfd4ea, 0x4a6b3a, 0.55));
scene3.add(new THREE.AmbientLight(0xffffff, 0.45));
var dir3 = new THREE.DirectionalLight(0xffffff, 1.2);
dir3.position.set(120, 200, 80); scene3.add(dir3);

// Road for 3D view — parent group so we can rotate by highway heading
var roadGroup3 = new THREE.Group();
scene3.add(roadGroup3);
var roadGeo3 = new THREE.PlaneGeometry(1400, 48);
roadGeo3.applyMatrix4(new THREE.Matrix4().makeRotationX(-Math.PI / 2));
roadGroup3.add(new THREE.Mesh(roadGeo3, new THREE.MeshPhongMaterial({ color: 0x374151, opacity: 0.9, transparent: true })));
// Centre line
var clGeo = new THREE.PlaneGeometry(1400, 1.5);
clGeo.applyMatrix4(new THREE.Matrix4().makeRotationX(-Math.PI / 2));
var clMesh = new THREE.Mesh(clGeo, new THREE.MeshPhongMaterial({ color: 0xfde047 }));
clMesh.position.y = 0.02; roadGroup3.add(clMesh);
// Lane dashes
for (var di = -13; di <= 13; di++) {
    var dg = new THREE.PlaneGeometry(14, 0.5);
    dg.applyMatrix4(new THREE.Matrix4().makeRotationX(-Math.PI / 2));
    var dm = new THREE.Mesh(dg, new THREE.MeshPhongMaterial({ color: 0xffffff }));
    dm.position.set(di * 40, 0.02, -10); roadGroup3.add(dm.clone());
    dm.position.z = 10; roadGroup3.add(dm);
}

// Cameras
const camP3 = new THREE.PerspectiveCamera(55, _3dCanvas.clientWidth / _3dCanvas.clientHeight, 0.1, 3000);
camP3.position.set(-220, 55, 120); camP3.lookAt(60, 0, 0);
const camS3 = new THREE.OrthographicCamera(-240, 240, 90, -90, 0.1, 2000);
camS3.position.set(0, 0, 500); camS3.lookAt(0, 0, 0);

var currentView = 'top';   // default to top (uses 2D overlay)
var radius3 = 280, theta3 = 0.6, phi3 = 0.5;
var vehicleMeshes3 = [];  // THREE.Group objects for 3D perspective view

// 3D mesh factory — simple coloured box per vehicle type
function _make3DVehicle(ev, vc) {
    var l = 4.5, w = 1.9, h = 1.4;
    if (vc.category === 'truck') { l = 9; w = 2.4; h = 2.8; }
    else if (vc.category === 'suv') { l = 5; w = 2.1; h = 1.8; }
    else if (vc.category === 'van') { l = 5.5; w = 2.1; h = 2.2; }
    else if (vc.category === 'motorcycle') { l = 2.2; w = 0.6; h = 1.1; }
    var geo = new THREE.BoxGeometry(l, h, w);
    var mat = new THREE.MeshPhongMaterial({ color: new THREE.Color(vc.color || '#3b82f6') });
    return new THREE.Mesh(geo, mat);
}

// Build or update 3D mesh from vehicleData (called when loading events in 3D views)
function _sync3DMeshes() {
    // Remove stale
    vehicleMeshes3 = vehicleMeshes3.filter(function(m) {
        if (!vehicleData.has(m.userData.vid)) { scene3.remove(m); return false; }
        return true;
    });
    // Add new
    vehicleData.forEach(function(vd, vid) {
        var exists = vehicleMeshes3.find(function(m){ return m.userData.vid === vid; });
        if (!exists) {
            var mesh = _make3DVehicle(vd.ev, vd.vc);
            var p = norm(vd.lat || midLat, vd.lon || midLon);
            var lane = (Math.random() - 0.5) * 20;
            mesh.position.set(p.x, 0.7, lane);
            var spd3 = vd.speedMph || 30;
            var dir3v = vd.direction || 0;
            var isNS = vd.isNSHwy || false;
            var vx3, vz3, laneX;
            if (isNS) {
                vz3 = spd3 * 0.015 * (Math.cos(dir3v * Math.PI / 180) >= 0 ? 1 : -1);
                vx3 = 0;
                laneX = (Math.random() - 0.5) * 20;  // lateral spread along X
                mesh.position.set(laneX, 0.7, p.x);
            } else {
                vx3 = spd3 * 0.015 * (Math.cos(dir3v * Math.PI / 180) >= 0 ? 1 : -1);
                vz3 = 0;
                laneX = 0;
            }
            mesh.userData = { vid: vid, vx: vx3, vz: vz3, isNS: isNS,
                              laneZ: isNS ? 0 : lane, laneX: isNS ? laneX : 0,
                              baseY: 0.7, phase: Math.random() * Math.PI * 2 };
            scene3.add(mesh);
            vehicleMeshes3.push(mesh);
        }
    });
}

// 3D animate loop (only active in perspective/side/split views)
var _3dAnimRunning = false;
var _tick3 = 0;
function _animate3D() {
    if (!_3dAnimRunning) return;
    requestAnimationFrame(_animate3D); _tick3++;
    camP3.position.x = -220 + radius3 * 0.4 * Math.sin(theta3 * 0.3);
    camP3.position.y = Math.max(20, radius3 * Math.sin(phi3));
    camP3.position.z =  120 + radius3 * 0.25 * Math.cos(theta3 * 0.3);
    camP3.lookAt(60, 0, 0);
    vehicleMeshes3.forEach(function(m) {
        var ud = m.userData;
        if (ud.isNS) {
            // N-S highway: travel along Z axis
            m.position.z += ud.vz;
            m.position.x += (ud.laneX - m.position.x) * 0.05;
            m.position.y = ud.baseY + Math.sin(_tick3 * 0.22 + ud.phase) * Math.abs(ud.vz) * 0.14;
            if (m.position.z >  680) m.position.z = -680;
            if (m.position.z < -680) m.position.z =  680;
        } else {
            // E-W highway: travel along X axis (default)
            m.position.x += ud.vx;
            m.position.z += (ud.laneZ - m.position.z) * 0.05;
            m.position.y = ud.baseY + Math.sin(_tick3 * 0.22 + ud.phase) * Math.abs(ud.vx) * 0.14;
            if (m.position.x >  680) m.position.x = -680;
            if (m.position.x < -680) m.position.x =  680;
        }
    });
    var cw = _3dCanvas.clientWidth, ch = _3dCanvas.clientHeight;
    renderer.setSize(cw, ch, false);
    var cam = currentView === 'side' ? camS3 : camP3;
    if (cam.isPerspectiveCamera) { cam.aspect = cw/ch; cam.updateProjectionMatrix(); }
    renderer.render(scene3, cam);
}

// 3D camera drag
var _isDrag3 = false, _prevM3 = {x:0,y:0};
_3dCanvas.addEventListener('mousedown', function(e) { _isDrag3 = true; _prevM3 = {x:e.clientX, y:e.clientY}; });
window.addEventListener('mouseup', function() { _isDrag3 = false; });
window.addEventListener('mousemove', function(e) {
    if (!_isDrag3) return;
    theta3 -= (e.clientX - _prevM3.x) * 0.005;
    phi3 = Math.max(0.05, Math.min(1.4, phi3 - (e.clientY - _prevM3.y) * 0.005));
    _prevM3 = {x:e.clientX, y:e.clientY};
});
_3dCanvas.addEventListener('wheel', function(e) {
    radius3 = Math.max(40, Math.min(700, radius3 + e.deltaY * 0.25));
});

// ── View toggle ───────────────────────────────────────────────────────
function setViewport(view) {
    currentView = view;
    var is2D = (view === 'top');
    // Show Three.js canvas only for 3D views
    _3dCanvas.style.display = is2D ? 'none' : '';
    // Overlay canvas always visible
    _oc.style.display = '';

    // Start/stop 3D render loop
    if (!is2D && !_3dAnimRunning) {
        _3dAnimRunning = true; _sync3DMeshes(); _animate3D();
    } else if (is2D) {
        _3dAnimRunning = false;
        renderer.clear();   // blank the 3D canvas when not in use
    }

    // Show Leaflet map for top view; hide for 3D (it shows through alpha)
    document.getElementById('t3dMiniMap').style.visibility = is2D ? 'visible' : 'hidden';

    // Split mode labels
    ['labelA','labelB','labelC'].forEach(function(id) {
        document.getElementById(id).style.display = view === 'split' ? '' : 'none';
    });
    // Force bridge re-projection — canvas dimensions may have changed
    _bridgeDirty = true;
    if (_map) _map.invalidateSize();
    console.log('[T3D] Viewport set: ' + view + ' bridge dirty');
}

// View buttons
document.querySelectorAll('#viewToggle button').forEach(function(btn) {
    btn.addEventListener('click', function() {
        document.querySelectorAll('#viewToggle button').forEach(function(b) {
            b.classList.remove('active','btn-primary'); b.classList.add('btn-outline-primary');
        });
        btn.classList.add('active','btn-primary'); btn.classList.remove('btn-outline-primary');
        setViewport(btn.dataset.view);
    });
});

// ── Zone / Server change handlers ─────────────────────────────────────
// ── Highway dropdown change — AJAX refresh (no page reload) ──────────
async function t3dHighwayChanged(newHighwayId) {
    if (!newHighwayId || newHighwayId === HW) return;
    HW = newHighwayId;
    localStorage.setItem('t3d_selectedHw', HW);
    selectedZoneId = ''; selectedServerId = '';
    localStorage.removeItem('t3d_selectedZone');
    localStorage.removeItem('t3d_selectedServer');
    var zsel = document.getElementById('t3dZoneSel');
    var ssel = document.getElementById('t3dServerSel');
    if (zsel) zsel.value = '';
    if (ssel) { ssel.value = ''; ssel.querySelectorAll('option').forEach(function(o) { o.style.display = ''; }); }
    // Fetch zones + servers — populate dropdowns ONLY. No map pan, no bridge redraw.
    // The animation view only updates when the Refresh button is clicked.
    try {
        var r = await fetch('/Traffic3D/GetAnimationData?highwayId=' + encodeURIComponent(newHighwayId) + '&mode=ground');
        if (!r.ok) return;
        var data = await r.json();
        if (data.highwayCoords && data.highwayCoords.length > 0) {
            T3D_ZONES = data.highwayCoords.map(function(z) {
                return { zoneId: z.zoneId, zoneName: z.zoneName, lat: z.lat, lon: z.lon, highwayId: z.highwayId, radius: z.radius };
            });
            if (zsel) {
                zsel.innerHTML = '<option value="">(Select Zone)</option>';
                T3D_ZONES.forEach(function(z) {
                    var opt = document.createElement('option');
                    opt.value = z.zoneId; opt.textContent = z.zoneName || z.zoneId;
                    opt.dataset.hw = z.highwayId || HW;
                    opt.dataset.lat = z.lat ? z.lat.toFixed(4) : '';
                    opt.dataset.lon = z.lon ? z.lon.toFixed(4) : '';
                    zsel.appendChild(opt);
                });
            }
            _hwyIsEW = data.isEW;
        } else {
            T3D_ZONES = [];
            if (zsel) zsel.innerHTML = '<option value="">(Select Zone)</option>';
            if (ssel) ssel.innerHTML = '<option value="">(Select Server)</option>';
            console.warn('[T3D] Highway ' + newHighwayId + ' has no zones');
        }
        if (data.bounds) _serverBounds = data.bounds;
        if (data.servers && ssel) {
            ssel.innerHTML = '<option value="">(Select Server)</option>';
            data.servers.forEach(function(s) {
                var opt = document.createElement('option');
                opt.value = s.serverId;
                var zn = '';
                if (s.zoneId) {
                    var zMatch = T3D_ZONES.find(function(zz){ return zz.zoneId === s.zoneId; });
                    zn = zMatch ? (zMatch.zoneName || s.zoneId) : s.zoneId;
                }
                opt.textContent = (s.serverName || s.serverId) + (zn ? ' (' + zn + ')' : '');
                opt.dataset.zone = s.zoneId || '';
                ssel.appendChild(opt);
            });
        }
        if (typeof data.hwBearing === 'number') _hwBearingDeg = data.hwBearing;
        if (data.bridgePath && data.bridgePath.length > 0) {
            _bridgePathCoords = data.bridgePath.map(function(p) { return { lat: p.lat, lon: p.lon }; });
        }
        console.log('[T3D] t3dHighwayChanged: dropdowns updated — click Refresh to apply');
    } catch(e) { console.warn('[T3D] Highway fetch failed:', e); }
}

async function t3dZoneChanged() {
    selectedZoneId = document.getElementById('t3dZoneSel').value;
    localStorage.setItem('t3d_selectedZone', selectedZoneId);
    selectedServerId = '';
    localStorage.removeItem('t3d_selectedServer');
    document.getElementById('t3dServerSel').value = '';
    var srvSel = document.getElementById('t3dServerSel');
    srvSel.querySelectorAll('option').forEach(function(o) {
        o.style.display = (!selectedZoneId || !o.dataset.zone || o.dataset.zone === selectedZoneId) ? '' : 'none';
    });
    // Do NOT pan map, redraw bridge, or load animation.
    // The animation view only updates when the Refresh button is clicked.
    console.log('[T3D] t3dZoneChanged: zone=' + selectedZoneId + ' — click Refresh to apply');
}

async function t3dServerChanged() {
    selectedServerId = document.getElementById('t3dServerSel').value;
    localStorage.setItem('t3d_selectedServer', selectedServerId);
    var opt = document.querySelector('#t3dServerSel option[value="' + selectedServerId + '"]');
    if (opt && opt.dataset.zone) {
        document.getElementById('t3dZoneSel').value = opt.dataset.zone;
