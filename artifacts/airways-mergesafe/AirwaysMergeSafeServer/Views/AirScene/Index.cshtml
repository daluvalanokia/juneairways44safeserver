    [-rw * 0.5 + 0.3, rw * 0.5 - 0.3].forEach(function(ez) {
        var eg = new THREE.PlaneGeometry(1800, 0.4);
        eg.applyMatrix4(new THREE.Matrix4().makeRotationX(-Math.PI / 2));
        var em = new THREE.Mesh(eg, new THREE.MeshPhongMaterial({ color: 0xffffff }));
        em.position.set(0, 0.02, ez);
