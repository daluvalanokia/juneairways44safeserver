var _airRoadWidth3D = 20;   // fixed visual width, NOT scaled with XZ_SCALE
var _airRoadMeshes3D = [];  // rebuildable road elements

function _airBuildRoad3D() {
    // Remove old road elements
    _airRoadMeshes3D.forEach(function(m) { airRoadGroup3.remove(m); });
    _airRoadMeshes3D = [];

    var rw = _airRoadWidth3D;

