// ── Orbit control ─────────────────────────────────────────────────────
let isDrag = false, prevM = {x:0,y:0}, theta = 0.6, phi = 0.5, radius = 310;
let airCamTween = null;
var lookTarget = { y: 15 };

canvas.addEventListener('mousemove', e => {
    if (isDrag) return;
    const rect = canvas.getBoundingClientRect();
    const rx   = (e.clientX - rect.left) / rect.width;
    const ry   = (e.clientY - rect.top)  / rect.height;
    let cam, lx, pickArr;
    if      (rx < SPLIT[1]) { cam = camP; lx = rx / SPLIT[1];                     pickArr = vehicleObjects.map(vo => vo.meshP); }
    else if (rx < SPLIT[2]) { cam = camS; lx = (rx-SPLIT[1])/(SPLIT[2]-SPLIT[1]); pickArr = vehicleObjects.map(vo => vo.meshS); }
    else                     { cam = camT; lx = (rx-SPLIT[2])/(SPLIT[3]-SPLIT[2]); pickArr = vehicleObjects.map(vo => vo.meshT); }
    mouse2.x =  lx * 2 - 1;
    mouse2.y = -ry * 2 + 1;
    raycaster.setFromCamera(mouse2, cam);
    canvas.style.cursor = raycaster.intersectObjects(pickArr, false).length ? 'pointer' : '';
});

canvas.addEventListener('mousedown', e => {
    const rect = canvas.getBoundingClientRect();
    const rx   = (e.clientX - rect.left) / rect.width;
    if (rx < SPLIT[1]) { isDrag = true; prevM = {x: e.clientX, y: e.clientY}; }
});
window.addEventListener('mouseup',   () => isDrag = false);
window.addEventListener('mousemove', e => {
    if (!isDrag) return;
    theta -= (e.clientX - prevM.x) * 0.005;
    phi    = Math.max(0.05, Math.min(1.45, phi - (e.clientY - prevM.y) * 0.005));
    prevM  = {x: e.clientX, y: e.clientY};
});
canvas.addEventListener('wheel', e => {
    radius = Math.max(60, Math.min(900, radius + e.deltaY * 0.25));
});

// ── Band legend ───────────────────────────────────────────────────────
function renderBandLegend() {
    const el = document.getElementById('bandLegend');
    document.getElementById('stBands').textContent = SERVERS.length;
    if (!SERVERS.length) {
        el.innerHTML = '<span class="text-muted small">No altitude corridors defined for this highway yet.</span>';
        return;
    }
    el.innerHTML = SERVERS.map((s, i) => {
        const col  = bandHsl(i);
        const span = (s.altMax - s.altMin).toFixed(0);
        return `<div class="band-chip">
            <span class="band-swatch" style="background:${col}"></span>
            <span style="color:${col};font-weight:700">${s.serverId}</span>
            <span class="text-muted">${s.altMin.toFixed(0)}–${s.altMax.toFixed(0)} m</span>
            <span class="text-muted">(${span} m tall, ${s.altWidth.toFixed(0)} m wide)</span>
            <span class="badge rounded-pill ms-1 ${s.status==='online'?'bg-success':'bg-secondary'}"
                  style="font-size:9px">${s.status}</span>
        </div>`;
    }).join('');
}

// ── Altitude Y-axis ticks ─────────────────────────────────────────────
function renderAltAxis() {
    const el = document.getElementById('altAxis');
    const wrap  = document.getElementById('sceneWrap');
    const maxAlt = SERVERS.length ? Math.max(...SERVERS.map(s => s.altMax)) : 400;
    const ticks  = [0, 50, 100, 150, 200, 250, 300, 350, 400].filter(t => t <= maxAlt + 80);
    const ch     = wrap.clientHeight;
    el.innerHTML = ticks.map(t => {
        const sceneY = t * ALT_SCALE;
        const frac   = 0.5 - sceneY / (OH * 2);
        const py     = Math.round(frac * ch);
        return `<div style="position:absolute;top:${py}px;right:2px;white-space:nowrap">${t} m</div>`;
    }).join('');
}

// ── Feed-mode Pause/Resume (Fix 1: full implementation) ───────────────
// Pausing stops live data injection AND 30-second polling (feed-mode control).
// onSimStateChange handles both sim-started and sim-stopped lifecycle events.
// Initial state is synced from localStorage on page load.
let tick = 0;
// _airFeedHeld = user explicitly paused the data feed (DB polling stopped)
// When sim starts, feed auto-holds to show only sim data.
// Vehicles already on screen keep their orbit animation — only NEW data intake is suspended.
let animationPaused = false;
var _airFeedHeld = false;

function _airToggleFeed() {
    _airFeedHeld = !_airFeedHeld;
    var btn = document.getElementById('btnAnimToggle');
    if (btn) {
        btn.textContent = _airFeedHeld ? '▶ Resume Feed' : '⏸ Hold Feed';
        btn.className   = _airFeedHeld ? 'btn btn-sm btn-warning' : 'btn btn-sm btn-outline-warning';
    }
    if (!_airFeedHeld) {
        _airDoRefresh(); // resuming — pull latest data immediately
        if (_airSimRunning && !_airFastTimer) {
            _airFastTimer = setInterval(function() { if (!_airFeedHeld) _airDoRefresh(); }, _airIntervalMs);
        }
    } else {
        if (_airFastTimer) { clearInterval(_airFastTimer); _airFastTimer = null; }
    }
}

// Keep animationPaused as alias (camera tween check uses it)
Object.defineProperty(window, 'animationPaused', {
    get: function() { return _airFeedHeld; },
    set: function(v) { /* no-op — use _airToggleFeed() */ }
});

// ── Air Sim Data Feed Panel JS ─────────────────────────────────────────
var _airSimPanelOpen = false;
function toggleAirSimPanel() {
    _airSimPanelOpen = !_airSimPanelOpen;
    var body = document.getElementById('airSimFeedBody');
    var tog  = document.getElementById('airSimFeedToggle');
    if (body) body.style.maxHeight = _airSimPanelOpen ? '90px' : '0';
    if (tog)  tog.textContent = _airSimPanelOpen ? '▲' : '▼';
}
function _updateAirSimPanel(ev, dbStatus) {
    var t   = new Date().toLocaleTimeString('en-US', {hour12:false});
    var spd = (ev.speedMph ?? 0).toFixed(1);
    var alt = (ev.altitudeMeters ?? 0).toFixed(0);
    var lat = (ev.latitude  ?? 0).toFixed(4);
    var lon = (ev.longitude ?? 0).toFixed(4);
    var line = t + '  ·  ' + (ev.vehicleId||'?') + '  ·  '
             + (ev.vehicleCategory || 'air') + '  ·  ' + alt + ' m · ' + spd + ' mph';
    var el = document.getElementById('airSimFeedLine');
    if (el) {
        el.style.color   = '#60a5fa';
        el.textContent   = line;
        el.style.opacity = '1';
    }
    function setEl(id, val) { var x = document.getElementById(id); if (x) x.textContent = val || '–'; }
    setEl('asfVehicleId', ev.vehicleId);
    setEl('asfType',      ev.vehicleCategory || 'air');
    setEl('asfAltSpd',   alt + ' m · ' + spd + ' mph');
    setEl('asfZone',      ev.zoneId || '–');
    setEl('asfLatLon',    lat + ', ' + lon);
    if (dbStatus !== undefined) {
        var dbEl = document.getElementById('asfDbStatus');
        if (dbEl) { dbEl.textContent = dbStatus;
                    dbEl.style.color = dbStatus.startsWith('✓') ? '#4ade80' : '#fbbf24'; }
    }
    if (!_airSimPanelOpen) toggleAirSimPanel();
    var badge = document.getElementById('airSimFeedBadge');
    if (badge) badge.style.display = '';
    if (!window._airSimEventCount) window._airSimEventCount = 0;
    window._airSimEventCount++;
    if (badge) badge.textContent = '● LIVE #' + window._airSimEventCount;
}

var _airSimRunning      = false;   // true while sim is broadcasting
var _airFastTimer   = null;    // fast poll timer during sim
var _airIntervalMs  = 30000;   // synced with DIF post interval on first message

function onSimStateChange(isRunning) {
    _airSimRunning = isRunning;
    var badge = document.getElementById('airSimFeedBadge');
    if (badge) {
        badge.style.display = isRunning ? '' : 'none';
        if (!isRunning) badge.textContent = '● LIVE';
    }

    // Auto-select sim's zone/server when sim starts
    if (isRunning) _airApplySimContext();

    if (_airFastTimer) { clearInterval(_airFastTimer); _airFastTimer = null; }

    if (isRunning) {
        // ── Sim started → clear existing vehicles + auto-HOLD feed ──────────
        // Only sim-injected data should be visible — no pre-existing DB events.
        clearScene();
        vehicleObjects.length = 0;
        if (!_airFeedHeld) {
            _airFeedHeld = true;
            var btn = document.getElementById('btnAnimToggle');
            if (btn) {
                btn.textContent = '▶ Resume Feed';
                btn.className   = 'btn btn-sm btn-warning';
            }
        }
        // No fast poll timer — sim events arrive via BroadcastChannel instantly.
        // _airDoRefresh() is gated by _airFeedHeld so no DB fetch happens during sim.
    } else {
        // ── Sim stopped → auto-RESUME feed ─────────────────────────────────
        if (_airFeedHeld) {
            _airFeedHeld = false;
            var btn2 = document.getElementById('btnAnimToggle');
            if (btn2) {
                btn2.textContent = '⏸ Hold Feed';
                btn2.className   = 'btn btn-sm btn-outline-warning';
            }
        }
        _airDoRefresh();
        window._airSimEventCount = 0;
        var el = document.getElementById('airSimFeedLine');
        if (el) { el.style.color = '#475569'; el.textContent = 'Sim stopped — viewing live data.'; }
    }
}

// ── Auto-select sim's zone/server in the Air Scene ────────────────────────
// Reads airways_sim_context (written by DIF every tick) and pre-selects
// the airZoneSel/airServerSel dropdowns, then refreshes the scene.
function _airApplySimContext() {
    try {
        var raw = localStorage.getItem('airways_sim_context');
        if (!raw) return;
        var ctx = JSON.parse(raw);
        var changed = false;

        // Apply zone
        if (ctx.zoneId) {
            var zSel = document.getElementById('airZoneSel');
            if (zSel && zSel.value !== ctx.zoneId) {
                var zOpt = zSel.querySelector('option[value="' + ctx.zoneId + '"]');
                if (zOpt) {
                    zSel.value     = ctx.zoneId;
                    selectedZoneId = ctx.zoneId;
                    // Filter server dropdown to match zone
                    var srvSel = document.getElementById('airServerSel');
                    if (srvSel) {
                        var first = '';
                        srvSel.querySelectorAll('option').forEach(function(o) {
                            var match = !ctx.zoneId || o.dataset.zone === ctx.zoneId;
                            o.style.display = match ? '' : 'none';
                            if (match && !first) first = o.value;
                        });
                        if (!ctx.serverId) { srvSel.value = first; selectedServerId = first; }
                    }
                    changed = true;
                }
            }
        }

        // Apply server
        if (ctx.serverId) {
            var sSel = document.getElementById('airServerSel');
            if (sSel) {
                var sOpt = sSel.querySelector('option[value="' + ctx.serverId + '"]');
                if (sOpt) {
                    sSel.value       = ctx.serverId;
                    selectedServerId = ctx.serverId;
                    changed = true;
                }
            }
        }

        if (changed) { airHighlightCorridors(); _airDoRefresh(); }
    } catch(e) {}
}

// ── Animate loop ──────────────────────────────────────────────────────
function animate() {
    requestAnimationFrame(animate);
    tick++;
    if (airCamTween) airCamTween();

    camP.position.x = radius * Math.sin(theta) * Math.cos(phi);
    camP.position.y = Math.max(5, radius * Math.sin(phi));
    camP.position.z = radius * Math.cos(theta) * Math.cos(phi);
    camP.lookAt(0, lookTarget.y, 0);

    // Vehicle animation — always runs; animationPaused only gates the 30s DB poll
    vehicleObjects.forEach((vo, i) => {
        if (vo.vc.domain === 'air' && vo.st) {
            // Advance orbit angle each frame — simulates circular flight circuit
            vo.st.angle += vo.st.speed;
            const ox   = Math.sin(vo.st.angle) * vo.st.orbitR;
            const oz   = Math.cos(vo.st.angle) * vo.st.orbitR;
            // Altitude oscillation: thermal lift + turbulence
            const dy   = Math.sin(tick * 0.025 + vo.st.phase) * 1.2;
            const curY = vo.altY + dy;
            const tY   = vo.topY + dy;
            // Move all three panel meshes in sync with orbit
            vo.meshP.position.set(ox, curY, oz);
            vo.meshS.position.set(ox, curY, oz);
            vo.meshT.position.set(ox, tY,   oz);
            // Labels follow the vehicle in all three panels
            if (vo.labelP) vo.labelP.position.set(ox, curY + 4, oz);
            if (vo.labelS) vo.labelS.position.set(ox, curY + 4, oz);
            if (vo.labelT) vo.labelT.position.set(ox, tY + 4, oz);
            // Face direction of travel + bank into turn
            vo.meshP.rotation.y = vo.st.angle + Math.PI * 0.5;
            vo.meshP.rotation.z = -0.22;        // realistic bank angle
            // Top-down view: rotate to match heading
            vo.meshT.rotation.z += vo.st.speed;
            // Speed/alert overlays track aircraft XZ
            vo.overlays.forEach(m => m.position.set(ox, curY - 0.2, oz));
        } else {
            // Ground vehicle or no orbit state: gentle hovering bob
            const dy = Math.sin(tick * 0.04 + i * 0.8) * 0.05;
            vo.meshP.position.y = vo.altY + dy;
            vo.meshS.position.y = vo.altY + dy;
            vo.meshT.position.y = vo.topY + dy;
            // Labels follow bob
            if (vo.labelP) vo.labelP.position.y = vo.altY + dy + 4;
            if (vo.labelS) vo.labelS.position.y = vo.altY + dy + 4;
            if (vo.labelT) vo.labelT.position.y = vo.topY + dy + 4;
        }
    });
    conflictRings.forEach((r, i) => {
        if (vehicleObjects[i]) {
            r.position.x = vehicleObjects[i].meshP.position.x;
            r.position.y = vehicleObjects[i].meshP.position.y;
            r.position.z = vehicleObjects[i].meshP.position.z;
        }
        r.rotation.z += 0.02;
    });

    const cw = canvas.clientWidth, ch = canvas.clientHeight;
    renderer.setSize(cw, ch, false);

    renderer.setViewport(0,       0, cw * 0.42, ch);
    renderer.setScissor( 0,       0, cw * 0.42, ch);
    renderer.setScissorTest(true);
    camP.aspect = (cw * 0.42) / ch;
    camP.updateProjectionMatrix();
    renderer.render(scene, camP);

    renderer.setViewport(cw * 0.43, 0, cw * 0.27, ch);
    renderer.setScissor( cw * 0.43, 0, cw * 0.27, ch);
    renderer.render(scene, camS);

    renderer.setViewport(cw * 0.72, 0, cw * 0.27, ch);
    renderer.setScissor( cw * 0.72, 0, cw * 0.27, ch);
    renderer.render(scene, camT);

    renderer.setScissorTest(false);
}

// ── Boot ──────────────────────────────────────────────────────────────
(async () => {
    renderBandLegend();
    renderAltAxis();
    await _airDoRefresh();
    animate();
})();

// 30s slow poll — gated: skip when sim running or feed held
setInterval(function() { if (!_airSimRunning && !_airFeedHeld) _airDoRefresh(); }, 30000);
window.addEventListener('resize', renderAltAxis);
// Restore sim feed state from localStorage on page load (handles DataInputFormats navigation)
(function() { if (localStorage.getItem('airways_sim_active') === 'true') onSimStateChange(true); })();

// ── Live simulation feed ───────────────────────────────────────────────
function _airNorm(evObj, cl) {
    var ev = Object.assign({}, evObj);
    if (cl) {
        ev.vehicleCategory  = cl.category;
        ev.vehicleMode      = cl.domain;
        ev.altitudeMeters   = (cl.altitudeM  != null) ? cl.altitudeM  : (evObj.altitude_m  ?? 0);
        ev.speedMph         = (cl.speedMph   != null) ? cl.speedMph   : (evObj.speed_mph   ?? 0);
        ev.vehicleClassJson = JSON.stringify(cl);
    } else {
        ev.altitudeMeters = evObj.altitude_m  ?? 0;
        ev.speedMph       = evObj.speed_mph   ?? 0;
    }
    // FIX: exhaustive field alias normalisation (same fix as Traffic3D)
    ev.latitude  = evObj.latitude  ?? evObj.lat      ?? evObj.lat_deg  ?? evObj.Latitude  ?? 32.7767;
    ev.longitude = evObj.longitude ?? evObj.lon      ?? evObj.lon_deg  ?? evObj.Longitude ?? -96.7970;
    ev.speedMph  = evObj.speedMph  ?? evObj.speed_mph ?? evObj.SpeedMph ?? evObj.speed ?? ev.speedMph ?? 0;
    ev.vehicleId = evObj.vehicle_id || ('SIM-' + Math.random().toString(36).slice(2,6).toUpperCase());
    ev.eventType = evObj.event_type || 'detection';
    ev.zoneId    = evObj.zone_id    || '';
    // Extract vehicle_make for brand badge display
    ev.vehicleMake = evObj.vehicle_make || evObj.vehicleMake || null;
    // EMA-update _airMidLat/_airMidLon so sim-spawned vehicles match DB-poll positions
    if (ev.latitude && ev.longitude) {
        _airMidLat = _airMidLat * 0.85 + ev.latitude  * 0.15;
        _airMidLon = _airMidLon * 0.85 + ev.longitude * 0.15;
    }
    return ev;
}

function _airInject(evObj, cl) {
    // Sim events ALWAYS flow while sim is running — _airFeedHeld blocks DB refresh only.
    if (!_airSimRunning) return;
    var ev = _airNorm(evObj, cl);

    _updateAirSimPanel(ev, '⏳ saving…');

    // Immediate visual update by vehicleId — update orbit speed + altitude before DB round-trip
    if (ev.vehicleId && airVehicleState.has(ev.vehicleId)) {
        var _st = airVehicleState.get(ev.vehicleId);
        _st.speed = (Math.max(10, ev.speedMph ?? 70) * 0.022) / _st.orbitR;
        var _vo = vehicleObjects.find(function(o) { return o.ev && o.ev.vehicleId === ev.vehicleId; });
        if (_vo) {
            if (ev.altitudeMeters != null) { _vo.altY = ev.altitudeMeters * ALT_SCALE; _vo.topY = ev.altitudeMeters * ALT_SCALE; }
            _vo.ev = ev;
        }
    }

    // ── Always save to DB + refresh (works in both live and sim-only modes) ──
    fetch('/AirScene/InjectSimEvent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            vehicleId:      ev.vehicleId,
            highwayId:      HW || '',
            zoneId:         ev.zoneId || selectedZoneId || '',
            vehicleType:    ev.vehicleCategory || 'air_urban',
            srcType:        'airflycar',
            isAirFlyCar:    'Y',
            speedMph:       ev.speedMph,
            latitude:       ev.latitude,
            longitude:      ev.longitude,
            altitudeMeters: ev.altitudeMeters ?? 0
        })
    }).then(function(r) {
        return r.json().then(function(j) {
            if (r.ok) _updateAirSimPanel(ev, '✓ saved · id ' + j.id);
            else       _updateAirSimPanel(ev, '✗ ' + (j.error || r.status));
        });
    }).catch(function(err) {
        _updateAirSimPanel(ev, '✗ ' + (err.message || 'network error'));
        _airInjectDirect(ev, cl); // fallback: direct inject for visual continuity
    }).then(function() {
        // Refresh 500ms after POST resolves — DB has the new row
        if (!_airFeedHeld) setTimeout(function() { _airDoRefresh(); }, 500);
    });

    var lbl = document.getElementById('airSimLiveLabel');
    if (lbl) { lbl.style.opacity = '1'; setTimeout(function(){ lbl.style.opacity = '0'; }, 2500); }
    document.getElementById('stTime').textContent = 'Sim · ' + new Date().toLocaleTimeString();

    if (!animationPaused) return; // camera tween only in sim-only mode
    var startR = radius, startP = phi;
    var targR  = Math.max(25, startR * 0.13);
    var targP  = Math.max(0.15, Math.min(0.55, startP));
    var frames = 0, phase = 'in';
    var FIN = 55, FHOLD = 100, FOUT = 70;
    airCamTween = function() {
        var t, ease;
        if (phase === 'in') {
            frames++;
            t = Math.min(1, frames / FIN);
            ease = t < 0.5 ? 2*t*t : -1+(4-2*t)*t;
            radius = startR + (targR - startR) * ease;
            phi    = startP + (targP - startP) * ease;
            if (frames >= FIN) { frames = 0; phase = 'hold'; }
        } else if (phase === 'hold') {
            frames++;
            if (frames >= FHOLD) { frames = 0; phase = 'out'; }
        } else {
            frames++;
            t = Math.min(1, frames / FOUT);
            ease = t < 0.5 ? 2*t*t : -1+(4-2*t)*t;
            radius = targR + (startR - targR) * ease;
            phi    = targP + (startP - targP) * ease;
            if (frames >= FOUT) { airCamTween = null; radius = startR; phi = startP; }
        }
    };
}

function _airInjectDirect(ev, cl) {
    var vc = resolveClass(ev);
    var vo = buildVehicle(ev);
    var overlays = buildSpeedOverlay(ev, vo.p, vo.isAir, vo.altY);
    vo.overlays = overlays;
    scene.add(vo.meshP); scene.add(vo.meshS); scene.add(vo.meshT);
    if (vo.labelP) scene.add(vo.labelP);
    if (vo.labelS) scene.add(vo.labelS);
    if (vo.labelT) scene.add(vo.labelT);
    overlays.forEach(function(m){ scene.add(m); });
    vehicleObjects.push(vo);
    var aEl = document.getElementById('stAir');
    if (aEl) aEl.textContent = (+aEl.textContent||0) + 1;
}

// ══════════════════════════════════════════════════════════════════════
// 3D VIEW: Map overlay + Bridge path + Zone pins + Bearing-based movement
// Duplicated from Traffic3D — adapted for air vehicles with altitude
// ══════════════════════════════════════════════════════════════════════

var _air3dCanvas = document.getElementById('air3dCanvas');
var _airRenderer = null, _airScene = null, _airCam = null;
var _airRoadGroup = null, _airRoadWidth = 20;
var _airMap = null, _airMapReady = false;
var _airBridgePath = [];
var _airHwBearing = 90;
var _airHwyIsEW = true;
var _air3dAnimRunning = false;
var _airRadius = 280, _airPhi = 0.35;
var _airZoneMarkers = [];
var _air3DBoundsCache = null;
var _airHwyPolyline = null;
var _airVehicleMeshes = [];
var _airMapCtrLat = _airMidLat, _airMapCtrLon = _airMidLon;
var _airViewMode = 'split';  // '3d' or 'split'

var _airViewMode = 'perspective'; // perspective | side | top | split

function airSetView(mode) {
    _airViewMode = mode;

    // Update toggle button states
    document.querySelectorAll('#airViewToggle button').forEach(function(b) {
        b.classList.toggle('btn-primary', b.dataset.airview === mode);
        b.classList.toggle('btn-outline-primary', b.dataset.airview !== mode);
    });

    var c3d  = document.getElementById('air3dCanvas');
    var c2d  = document.getElementById('airCanvas');
    var map  = document.getElementById('airMiniMap');
    var lblA = document.getElementById('airLabelA');
    var lblB = document.getElementById('airLabelB');
    var lblC = document.getElementById('airLabelC');
    var dAB  = document.getElementById('divAB');
    var dBC  = document.getElementById('divBC');
    var altAxis = document.getElementById('altAxis');
    var locBadge = document.getElementById('airLocBadge');

    // Hide all labels and dividers first
    if (lblA) lblA.style.display = 'none';
    if (lblB) lblB.style.display = 'none';
    if (lblC) lblC.style.display = 'none';
    if (dAB) dAB.style.display = 'none';
    if (dBC) dBC.style.display = 'none';
    if (altAxis) altAxis.style.display = 'none';

    if (mode === 'perspective') {
        if (c3d) c3d.style.display = 'block';
        if (c2d) c2d.style.display = 'none';
        if (map) { map.style.opacity = '0.55'; map.style.visibility = 'visible'; }
        if (lblA) lblA.style.display = '';
        if (locBadge) locBadge.style.display = '';
        _airInit3D();
        _airInitMap();
        _airCenterMapOnZone();
        _airSyncZoom();
        if (!_air3dAnimRunning) { _air3dAnimRunning = true; _airAnimate3D(); }
    } else if (mode === 'side') {
        if (c3d) c3d.style.display = 'none';
        if (c2d) c2d.style.display = 'block';
        if (map) { map.style.opacity = '0.3'; map.style.visibility = 'visible'; }
        if (lblB) lblB.style.display = '';
        if (altAxis) altAxis.style.display = '';
        _air3dAnimRunning = false;
    } else if (mode === 'top') {
        if (c3d) c3d.style.display = 'none';
        if (c2d) c2d.style.display = 'block';
        if (map) { map.style.opacity = '0.9'; map.style.visibility = 'visible'; }
        if (lblC) lblC.style.display = '';
        _air3dAnimRunning = false;
    } else if (mode === 'split') {
        if (c3d) c3d.style.display = 'none';
        if (c2d) c2d.style.display = 'block';
        if (map) { map.style.opacity = '0.7'; map.style.visibility = 'visible'; }
        if (lblA) lblA.style.display = '';
        if (lblB) lblB.style.display = '';
        if (lblC) lblC.style.display = '';
        if (dAB) dAB.style.display = '';
        if (dBC) dBC.style.display = '';
        if (altAxis) altAxis.style.display = '';
        _air3dAnimRunning = false;
    }

    // Resize canvases
    if (c3d) { c3d.width = c3d.clientWidth; c3d.height = c3d.clientHeight; }
    if (c2d) { c2d.width = c2d.clientWidth; c2d.height = c2d.clientHeight; }

    console.log('[AirScene] View mode:', mode);
}

function airZoomIn() {
    if (typeof _airMap !== 'undefined' && _airMap) _airMap.zoomIn();
    console.log('[AirScene] Zoom in');
}

function airZoomOut() {
    if (typeof _airMap !== 'undefined' && _airMap) _airMap.zoomOut();
    console.log('[AirScene] Zoom out');
}

// Wire up view toggle buttons
document.querySelectorAll('#airViewToggle button').forEach(function(b) {
    b.addEventListener('click', function() { airSetView(this.dataset.airview); });
});

function _airInit3D() {
    if (_airRenderer) return;  // already initialized
    _airRenderer = new THREE.WebGLRenderer({ canvas: _air3dCanvas, antialias: true });
    _airRenderer.setPixelRatio(window.devicePixelRatio);
    _airRenderer.setSize(_air3dCanvas.clientWidth, _air3dCanvas.clientHeight);

    _airScene = new THREE.Scene();
    _airScene.add(new THREE.AmbientLight(0xffffff, 0.5));
    var sun = new THREE.DirectionalLight(0xffffff, 0.8);
    sun.position.set(80, 200, 100); _airScene.add(sun);

    _airCam = new THREE.PerspectiveCamera(50, _air3dCanvas.clientWidth / _air3dCanvas.clientHeight, 0.1, 4000);
    _airCam.position.set(0, 100, 280);
    _airCam.lookAt(0, 0, 0);

    // Road group
    _airRoadGroup = new THREE.Group();
    _airScene.add(_airRoadGroup);
    _airBuildRoad();

    // Sky dome
    var skyGeo = new THREE.SphereGeometry(2000, 32, 15);
    var skyMat = new THREE.ShaderMaterial({
        side: THREE.BackSide,
        uniforms: {
            topColor: { value: new THREE.Color(0x2a6ab5) },
            bottomColor: { value: new THREE.Color(0xd0e8f0) },
            offset: { value: 200 }, exponent: { value: 0.7 }
        },
        vertexShader: 'varying vec3 vWorldPos; void main() { vec4 wp = modelMatrix * vec4(position, 1.0); vWorldPos = wp.xyz; gl_Position = projectionMatrix * viewMatrix * wp; }',
        fragmentShader: 'uniform vec3 topColor; uniform vec3 bottomColor; uniform float offset; uniform float exponent; varying vec3 vWorldPos; void main() { float h = normalize(vWorldPos + vec3(0.0, offset, 0.0)).y; gl_FragColor = vec4(mix(bottomColor, topColor, max(pow(max(h, 0.0), exponent), 0.0)), 1.0); }'
    });
    var skyDome = new THREE.Mesh(skyGeo, skyMat);
    _airScene.add(skyDome);

    // 3D event handlers — pan + proportional zoom
    _air3dCanvas.style.cursor = 'grab';
    var _isDrag = false, _prev = {x:0, y:0};
    _air3dCanvas.addEventListener('mousedown', function(e) {
        e.preventDefault(); e.stopPropagation();
        _isDrag = true; _prev = {x:e.clientX, y:e.clientY};
        _air3dCanvas.style.cursor = 'grabbing';
    }, { passive: false });
    window.addEventListener('mouseup', function() {
        if (_isDrag) { _isDrag = false; _air3dCanvas.style.cursor = 'grab'; }
    });
    window.addEventListener('mousemove', function(e) {
        if (!_isDrag) return;
        e.preventDefault();
        var dx = e.clientX - _prev.x, dy = e.clientY - _prev.y;
        _prev = {x:e.clientX, y:e.clientY};
        if (!_airMap) return;
        var zoom = _airMap.getZoom();
        var mpp = 156543 * Math.cos(_airMapCtrLat * Math.PI / 180) / Math.pow(2, zoom);
        _airMapCtrLat += -(dy * mpp) / 111000;
        _airMapCtrLon += -(dx * mpp) / (111000 * Math.cos(_airMapCtrLat * Math.PI / 180));
        _airMidLat = _airMapCtrLat; _airMidLon = _airMapCtrLon;
        _airMap.setView([_airMapCtrLat, _airMapCtrLon], zoom, { animate: false });
        _airUpdateZoneMarkers();
        _air3DBoundsCache = null;
    });
    _air3dCanvas.addEventListener('wheel', function(e) {
        e.preventDefault(); e.stopPropagation();
        _airRadius = Math.max(40, Math.min(700, _airRadius + e.deltaY * 0.3));
        _airSyncZoom();
    }, { passive: false });
}

function _airBuildRoad() {
    // Clear old road elements
    while (_airRoadGroup.children.length > 0) _airRoadGroup.remove(_airRoadGroup.children[0]);
    var rw = _airRoadWidth;
    // Road surface
    var roadGeo = new THREE.PlaneGeometry(1800, rw);
    roadGeo.applyMatrix4(new THREE.Matrix4().makeRotationX(-Math.PI / 2));
    var roadMat = new THREE.MeshPhongMaterial({ color: 0x374151, opacity: 0.85, transparent: true });
    _airRoadGroup.add(new THREE.Mesh(roadGeo, roadMat));
    // Centre line
    var clGeo = new THREE.PlaneGeometry(1800, 0.6);
    clGeo.applyMatrix4(new THREE.Matrix4().makeRotationX(-Math.PI / 2));
    var clMesh = new THREE.Mesh(clGeo, new THREE.MeshPhongMaterial({ color: 0xfde047 }));
    clMesh.position.y = 0.02; _airRoadGroup.add(clMesh);
    // Edge lines
    [-rw * 0.5 + 0.3, rw * 0.5 - 0.3].forEach(function(ez) {
        var eg = new THREE.PlaneGeometry(1800, 0.4);
        eg.applyMatrix4(new THREE.Matrix4().makeRotationX(-Math.PI / 2));
        var em = new THREE.Mesh(eg, new THREE.MeshPhongMaterial({ color: 0xffffff }));
        em.position.set(0, 0.02, ez); _airRoadGroup.add(em);
    });
}

function _airInitMap() {
    if (_airMap) return;
    var el = document.getElementById('airMiniMap');
    if (!el || typeof L === 'undefined') return;
    _airMap = L.map('airMiniMap', {
        zoomControl: false, attributionControl: false,
        dragging: false, scrollWheelZoom: false,
        doubleClickZoom: false, keyboard: false, boxZoom: false, touchZoom: false
    }).setView([_airMidLat, _airMidLon], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(_airMap);
    _airMapReady = true;
    setTimeout(function() { if (_airMap) _airMap.invalidateSize(true); }, 80);
    setTimeout(function() { if (_airMap) _airMap.invalidateSize(true); }, 300);
}

function _airCenterMapOnZone() {
    if (!_airMap) return;
    var ctrLat = _airMidLat, ctrLon = _airMidLon;
    if (selectedZoneId && ZONES && ZONES.length) {
        var z = ZONES.find(function(zz) { return zz.zoneId === selectedZoneId; });
        if (z && z.lat && z.lon) { ctrLat = z.lat; ctrLon = z.lon; }
    }
    // Compute _airXZ_SCALE from bridge path span
    if (_airBridgePath && _airBridgePath.length >= 2) {
        var maxAbs = 0;
        for (var i = 0; i < _airBridgePath.length; i++) {
            var dLat = Math.abs(_airBridgePath[i].lat - ctrLat);
            var dLon = Math.abs(_airBridgePath[i].lon - ctrLon);
            if (dLat > maxAbs) maxAbs = dLat;
            if (dLon > maxAbs) maxAbs = dLon;
        }
        if (maxAbs > 0.0001) _airXZ_SCALE = 900 / maxAbs;
    }
    _airMapCtrLat = ctrLat; _airMapCtrLon = ctrLon;
    _airMidLat = ctrLat; _airMidLon = ctrLon;
    _airMap.setView([ctrLat, ctrLon], _airMap.getZoom(), { animate: false });
    // Road rotation
    _airRoadGroup.rotation.y = ((_airHwBearing || 90) - 90) * Math.PI / 180;
    // Draw highway polyline
    _airDrawHwyPolyline();
    // Update zone markers
    _air3DBoundsCache = null;
    _airUpdateZoneMarkers();
    _airSyncZoom();
    _airUpdateLocBadge();
}

function _airDrawHwyPolyline() {
    if (_airHwyPolyline) { _airMap.removeLayer(_airHwyPolyline); _airHwyPolyline = null; }
    if (!_airBridgePath || _airBridgePath.length < 2) return;
    var latlngs = _airBridgePath.map(function(p) { return [p.lat, p.lon]; });
    _airHwyPolyline = L.polyline(latlngs, {
        color: '#ff6600', weight: 4, opacity: 0.7, dashArray: '8,4'
    }).addTo(_airMap);
}

function _airUpdateZoneMarkers() {
    _airZoneMarkers.forEach(function(m) { _airScene.remove(m); });
    _airZoneMarkers = [];
    if (!_airBridgePath || _airBridgePath.length < 2) return;
    // Center pin
    var ctrPole = new THREE.Mesh(
        new THREE.CylinderGeometry(0.5, 0.5, 12, 8),
        new THREE.MeshPhongMaterial({ color: 0x00ff88, emissive: 0x004422, emissiveIntensity: 0.4 }));
    ctrPole.position.set(0, 6, 0); _airScene.add(ctrPole); _airZoneMarkers.push(ctrPole);
    // Bridge path pins
    for (var i = 0; i < _airBridgePath.length; i++) {
        if (i > 0 && i < _airBridgePath.length - 1 && i % 5 !== 0) continue;
        var p = _airNorm(_airBridgePath[i].lat, _airBridgePath[i].lon);
        var pole = new THREE.Mesh(
            new THREE.CylinderGeometry(0.3, 0.3, 8, 6),
            new THREE.MeshPhongMaterial({ color: 0xffd700 }));
        pole.position.set(p.x, 4, p.z); _airScene.add(pole); _airZoneMarkers.push(pole);
        var sph = new THREE.Mesh(
            new THREE.SphereGeometry(1.2, 8, 6),
            new THREE.MeshPhongMaterial({ color: 0xffd700, emissive: 0x442200, emissiveIntensity: 0.3 }));
        sph.position.set(p.x, 9, p.z); _airScene.add(sph); _airZoneMarkers.push(sph);
    }
    // Endpoint pins
    var p0 = _airNorm(_airBridgePath[0].lat, _airBridgePath[0].lon);
    var pN = _airNorm(_airBridgePath[_airBridgePath.length-1].lat, _airBridgePath[_airBridgePath.length-1].lon);
    [{p: p0, c: 0xff4444}, {p: pN, c: 0x44ff44}].forEach(function(ep) {
        var eMesh = new THREE.Mesh(
            new THREE.CylinderGeometry(0.6, 0.6, 10, 8),
            new THREE.MeshPhongMaterial({ color: ep.c, emissive: ep.c, emissiveIntensity: 0.2 }));
        eMesh.position.set(ep.p.x, 5, ep.p.z); _airScene.add(eMesh); _airZoneMarkers.push(eMesh);
    });
}

function _airGetBounds() {
    if (_air3DBoundsCache) return _air3DBoundsCache;
    var r = { minX: -900, maxX: 900, minZ: -900, maxZ: 900 };
    if (!_airBridgePath || _airBridgePath.length < 2) return r;
    var minX = Infinity, maxX = -Infinity, minZ = Infinity, maxZ = -Infinity;
    for (var i = 0; i < _airBridgePath.length; i++) {
        var p = _airNorm(_airBridgePath[i].lat, _airBridgePath[i].lon);
        if (p.x < minX) minX = p.x; if (p.x > maxX) maxX = p.x;
        if (p.z < minZ) minZ = p.z; if (p.z > maxZ) maxZ = p.z;
    }
    r = { minX: minX, maxX: maxX, minZ: minZ, maxZ: maxZ };
    _air3DBoundsCache = r;
    return r;
}

function _airSyncZoom() {
    if (!_airMap) return;
    var r = (_airRadius - 40) / (700 - 40);
    var baseZoom = 18 - r * 9;
    var scaleAdj = Math.log(_airXZ_SCALE / 800) / Math.LN2 * 0.6;
    var z = Math.round(baseZoom - scaleAdj);
    z = Math.max(8, Math.min(18, z));
    if (z !== _airMap.getZoom()) _airMap.setZoom(z, { animate: false });
}

function _airUpdateLocBadge() {
    var hwyEl = document.getElementById('airLocHwy');
    var zoneEl = document.getElementById('airLocZone');
    var coordEl = document.getElementById('airLocCoord');
    if (hwyEl) hwyEl.textContent = HW;
    if (zoneEl) {
        var z = ZONES.find(function(zz) { return zz.zoneId === selectedZoneId; });
        zoneEl.textContent = z ? z.zoneName : 'All Zones';
    }
    if (coordEl) coordEl.textContent = _airMapCtrLat.toFixed(4) + '°N, ' + Math.abs(_airMapCtrLon).toFixed(4) + '°W';
}

function _airUpdateCamera() {
    var brg = (_airHwBearing || 90) * Math.PI / 180;
    var camHeight = _airRadius * Math.sin(_airPhi);
    var camHoriz = _airRadius * Math.cos(_airPhi);
    _airCam.position.x = -camHoriz * Math.sin(brg - Math.PI / 2);
    _airCam.position.y = Math.max(15, camHeight);
    _airCam.position.z = -camHoriz * Math.cos(brg - Math.PI / 2);
    _airCam.lookAt(0, 0, 0);
}

function _airSyncVehicles3D() {
    // Remove stale meshes
    _airVehicleMeshes = _airVehicleMeshes.filter(function(m) {
        if (!vehicleObjects.find(function(vo) { return vo.ev && vo.ev.vehicleId === m.userData.vid; })) {
            _airScene.remove(m);
            if (m.userData.labelSprite) _airScene.remove(m.userData.labelSprite);
            return false;
        }
        return true;
    });
    // Add new meshes for vehicles not yet in 3D scene
    vehicleObjects.forEach(function(vo) {
        var vid = vo.vid;
        var exists = _airVehicleMeshes.find(function(m) { return m.userData.vid === vid; });
        if (!exists && vo.ev) {
            var ev = vo.ev;
            var altY = (ev.altitudeMeters || 60) * ALT_SCALE;
            var geo = new THREE.BoxGeometry(3, 0.8, 3);
            var mat = new THREE.MeshPhongMaterial({ color: new THREE.Color(vo.vc.color || '#00bcd4') });
            var mesh = new THREE.Mesh(geo, mat);
            var p = _airNorm(ev.latitude || _airMidLat, ev.longitude || _airMidLon);
            mesh.position.set(p.x, altY, p.z);
            mesh.userData = {
                vid: vid, ev: vo.ev, vc: vo.vc,
                spd: ev.speedMph || 30,
                dir: ev.direction || _airHwBearing || 90,
                altY: altY
            };
            _airScene.add(mesh);
            _airVehicleMeshes.push(mesh);
        }
    });
}

function _airAnimate3D() {
    if (!_air3dAnimRunning) return;
    requestAnimationFrame(_airAnimate3D);

    _airUpdateCamera();

    // Sync vehicles periodically
    if (window._airTick === undefined) window._airTick = 0;
    window._airTick++;
    if (window._airTick % 30 === 0) _airSyncVehicles3D();

    // Move vehicles using bearing-based velocity from input data
    var bp = _airGetBounds();
    var margin = 30;
    _airVehicleMeshes.forEach(function(m) {
        var ud = m.userData;
        var dir = ud.dir || _airHwBearing || 90;
        var spd = ud.spd || 30;
        var rad = dir * Math.PI / 180;
        var vx = spd * 0.025 * Math.sin(rad);
        var vz = spd * 0.025 * Math.cos(rad);
        m.position.x += vx;
        m.position.z += vz;
        m.rotation.y = -(dir - 90) * Math.PI / 180;
        // Altitude oscillation
        m.position.y = ud.altY + Math.sin(window._airTick * 0.025 + ud.vid.length) * 1.2;
        // Remove if exits bridge bounds
        if (m.position.x > bp.maxX + margin || m.position.x < bp.minX - margin ||
            m.position.z > bp.maxZ + margin || m.position.z < bp.minZ - margin) {
            _airScene.remove(m);
            _airVehicleMeshes = _airVehicleMeshes.filter(function(x) { return x !== m; });
        }
    });

    // Render
    var cw = _air3dCanvas.clientWidth, ch = _air3dCanvas.clientHeight;
    _airRenderer.setSize(cw, ch, false);
    _airCam.aspect = cw / ch;
    _airCam.updateProjectionMatrix();
    _airRenderer.render(_airScene, _airCam);
}

// Fetch GetAnimationData from AirScene controller
async function _airRefresh3D() {
    if (!selectedZoneId || !selectedServerId) return;
    try {
        var params = 'highwayId=' + encodeURIComponent(HW) +
                     '&zoneId=' + encodeURIComponent(selectedZoneId) +
                     '&serverId=' + encodeURIComponent(selectedServerId) +
                     '&mode=air' +
                     (_airSimRunning ? '&simOnly=true' : '');
        var r = await fetch('/AirScene/GetAnimationData?' + params);
        if (!r.ok) return;
        var data = await r.json();
        if (data.bridgePath && data.bridgePath.length > 0) {
            _airBridgePath = data.bridgePath.map(function(p) { return { lat: p.lat, lon: p.lon }; });
        }
        if (typeof data.hwBearing === 'number') _airHwBearing = data.hwBearing;
        if (data.isEW !== undefined) _airHwyIsEW = data.isEW;
        // Update ZONES if provided
        if (data.highwayCoords && data.highwayCoords.length > 0) {
            // Update zones for centering
        }
        // Re-center and rebuild
        if (_airViewMode === '3d') {
            _airCenterMapOnZone();
            // Load vehicles into vehicleObjects for 3D sync
            if (data.vehicles && data.vehicles.length > 0) {
                // Clear old vehicles
                vehicleObjects.forEach(function(vo) {
                    if (vo.meshP) _airScene.remove(vo.meshP);
                    if (vo.meshS) _airScene.remove(vo.meshS);
                    if (vo.meshT) _airScene.remove(vo.meshT);
                });
                vehicleObjects = [];
                _airVehicleMeshes.forEach(function(m) { _airScene.remove(m); });
                _airVehicleMeshes = [];
                // Add new vehicles
                data.vehicles.forEach(function(ev) {
                    var vc = resolveClass(ev);
                    var vo = buildVehicle(ev);
                    vo.overlays = [];
                    vehicleObjects.push(vo);
                });
                _airSyncVehicles3D();
            }
        }
    } catch(e) { console.warn('AirScene 3D refresh error:', e); }
}

// Bug Fix 2: BroadcastChannel — only call onSimStateChange for lifecycle events.
// Previously, onSimStateChange(e.data.type === 'sim_started') was called for ALL
// messages, toggling Pause↔Resume on every sim_vehicle post interval.
if (typeof BroadcastChannel !== 'undefined') {
    var _airSimBc = new BroadcastChannel('airways_sim');
    _airSimBc.onmessage = function(e) {
        if (!e.data) return;

        // Sync poll interval from DIF
        if (e.data.intervalSec && e.data.intervalSec > 0) {
            var newMs = e.data.intervalSec * 1000;
            if (newMs !== _airIntervalMs) {
                _airIntervalMs = newMs;
                // No fast poll timer during sim — sim injects directly via BroadcastChannel.
            }
        }

        if (e.data.type === 'sim_vehicle' && e.data.payload && e.data.srcType === 'airflycar')
            _airInject(e.data.payload, e.data.classification);
        if (e.data.type === 'sim_started') {
            onSimStateChange(true);
        }
        if (e.data.type === 'sim_stopped') onSimStateChange(false);
    };
}

// Bug Fix 4: Separate storage listeners — airways_sim_active handles lifecycle state;
// airways_sim_last_event handles vehicle payloads only (no dead sim_started check).
window.addEventListener('storage', function(e) {
    if (e.key === 'airways_sim_active') { onSimStateChange(e.newValue === 'true'); return; }
    if (e.key === 'airways_sim_context' && _airSimRunning) { _airApplySimContext(); return; }
    if (e.key !== 'airways_sim_last_event' || !e.newValue) return;
    try {
        var msg = JSON.parse(e.newValue);
        // Sync interval from localStorage fallback
        if (msg.intervalSec && msg.intervalSec > 0) {
            var newMs = msg.intervalSec * 1000;
            if (newMs !== _airIntervalMs) {
                _airIntervalMs = newMs;
                // No fast poll timer during sim — sim injects directly.
            }
        }
        if (msg.type === 'sim_vehicle' && msg.payload && msg.srcType === 'airflycar')
            _airInject(msg.payload, msg.classification);
    } catch(ex) {}
});
// On page load: if sim already running, apply its context immediately
(function() {
    if (localStorage.getItem('airways_sim_active') === 'true') {
        _airApplySimContext();
        onSimStateChange(true);
    }
})();
</script>
}
