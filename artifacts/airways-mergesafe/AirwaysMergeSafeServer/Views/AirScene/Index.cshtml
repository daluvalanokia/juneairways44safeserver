    var lampGeo = new THREE.SphereGeometry(1.5, 8, 6);
    var lampMat = new THREE.MeshPhongMaterial({ color: 0xfff9c4, emissive: 0xfff5b0, emissiveIntensity: 0.3 });
    for (var li = -15; li <= 15; li += 5) {
        var lx = li * 55;
        var pl = new THREE.Group();
        var poleL = new THREE.Mesh(poleGeo, poleMat); poleL.position.y = 9; pl.add(poleL);
        var armL = new THREE.Mesh(new THREE.BoxGeometry(5, 0.5, 0.5), poleMat);
        armL.position.set(2, 17, 0); pl.add(armL);
        var lampL = new THREE.Mesh(lampGeo, lampMat); lampL.position.set(4.5, 16.5, 0); pl.add(lampL);
        pl.position.set(lx, 0, 40); _airRoadGroup.add(pl);
        var pr = new THREE.Group();
        var poleR = new THREE.Mesh(poleGeo, poleMat); poleR.position.y = 9; pr.add(poleR);
        var armR = new THREE.Mesh(new THREE.BoxGeometry(5, 0.5, 0.5), poleMat);
        armR.position.set(-2, 17, 0); pr.add(armR);
        var lampR = new THREE.Mesh(lampGeo, lampMat); lampR.position.set(-4.5, 16.5, 0); pr.add(lampR);
        pr.position.set(lx, 0, -40); _airRoadGroup.add(pr);
    }

    // ── Distant hills ──────────────────────────────────────────────────────
    for (var hi = 0; hi < 8; hi++) {
        var hillGeo = new THREE.SphereGeometry(80 + Math.random()*60, 8, 6, 0, Math.PI*2, 0, Math.PI/2);
        var hillMat = new THREE.MeshPhongMaterial({ color: 0x3a5a3a });
        var hL = new THREE.Mesh(hillGeo, hillMat);
        hL.position.set(-700 + hi*180, -2, 380 + Math.random()*100);
        hL.scale.set(1.5, 0.4 + Math.random()*0.3, 1);
        _airRoadGroup.add(hL);
        var hR = new THREE.Mesh(hillGeo.clone(), hillMat);
        hR.position.set(-700 + hi*180, -2, -380 - Math.random()*100);
        hR.scale.set(1.5, 0.4 + Math.random()*0.3, 1);
        _airRoadGroup.add(hR);
    }

    // ── Altitude band indicators (thin translucent planes — NOT corridor boxes) ──
    // These are subtle horizontal planes showing altitude levels, not the heavy boxes
    var altLevels = [50, 100, 150, 200, 300];
    altLevels.forEach(function(aM) {
        var aGeo = new THREE.PlaneGeometry(1800, _airRoadWidth * 2.5);
        aGeo.applyMatrix4(new THREE.Matrix4().makeRotationX(-Math.PI/2));
        var aMat = new THREE.MeshBasicMaterial({
            color: 0x60a5fa, transparent: true, opacity: 0.04, depthWrite: false
        });
        var aMesh = new THREE.Mesh(aGeo, aMat);
        aMesh.position.y = aM * _airAltScale;
        _airRoadGroup.add(aMesh);
        // Altitude label line
        var lineGeo = new THREE.BufferGeometry().setFromPoints([
            new THREE.Vector3(-900, aM*_airAltScale, 0),
