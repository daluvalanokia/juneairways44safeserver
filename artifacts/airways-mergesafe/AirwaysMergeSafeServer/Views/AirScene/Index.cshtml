// ── 3D vehicle mesh factory — textured box with side-view logo ──
function _makeAir3DVehicle(ev, vc, vd) {
    var l = 4.5, w = 1.9, h = 1.4;
    if (vc.category === 'truck') { l = 9; w = 2.4; h = 2.8; }
    else if (vc.category === 'suv') { l = 5; w = 2.1; h = 1.8; }
    else if (vc.category === 'van') { l = 5.5; w = 2.1; h = 2.2; }
    else if (vc.category === 'motorcycle') { l = 2.2; w = 0.6; h = 1.1; }

    // Extract make from the passed vd parameter (from _syncAirMeshes).
    // Do NOT re-lookup by ev.id — that's the DB integer ID, not the
    // vehicle_id string used as the vehicleData Map key.
    var make = (vd && vd.make) ? vd.make
             : (ev && ev.vehicle_id) ? ev.vehicle_id.split('-')[0] : '';

    var group = new THREE.Group();

    // Body mesh — coloured box
    var bodyColor = vc.color || '#3b82f6';
    var geo = new THREE.BoxGeometry(l, h, w);
    var mat = new THREE.MeshPhongMaterial({ color: new THREE.Color(bodyColor) });
    var body = new THREE.Mesh(geo, mat);
    body.position.y = h / 2;
    group.add(body);

    // Roof/cabin — slightly smaller box on top (sedan/suv/van only)
    if (vc.category !== 'motorcycle' && vc.category !== 'truck') {
        var roofGeo = new THREE.BoxGeometry(l * 0.55, h * 0.55, w * 0.85);
        var roofMat = new THREE.MeshPhongMaterial({ color: new THREE.Color(bodyColor), transparent: true, opacity: 0.85 });
        var roof = new THREE.Mesh(roofGeo, roofMat);
        roof.position.y = h + h * 0.25;
        group.add(roof);
    }
    // Truck cab
    if (vc.category === 'truck') {
        var cabGeo = new THREE.BoxGeometry(l * 0.3, h * 0.85, w);
        var cab = new THREE.Mesh(cabGeo, mat);
        cab.position.set(l * 0.3, h / 2, 0);
        group.add(cab);
    }

    // Wheels — 4 cylinders (or 6 for truck)
    var wheelGeo = new THREE.CylinderGeometry(0.5, 0.5, 0.4, 10);
    var wheelMat = new THREE.MeshPhongMaterial({ color: 0x1a1a1a });
    var wheelPositions = vc.category === 'truck'
        ? [[l*0.3, 0, w/2], [l*0.3, 0, -w/2], [-l*0.2, 0, w/2], [-l*0.2, 0, -w/2], [-l*0.4, 0, w/2], [-l*0.4, 0, -w/2]]
        : [[l*0.3, 0, w/2], [l*0.3, 0, -w/2], [-l*0.3, 0, w/2], [-l*0.3, 0, -w/2]];
    if (vc.category === 'motorcycle') {
        wheelPositions = [[l*0.35, 0, 0], [-l*0.35, 0, 0]];
        wheelGeo = new THREE.CylinderGeometry(0.5, 0.5, 0.3, 10);
    }
    wheelPositions.forEach(function(wp) {
        var wheel = new THREE.Mesh(wheelGeo, wheelMat);
        wheel.rotation.x = Math.PI / 2;
        wheel.position.set(wp[0], 0.5, wp[2]);
        group.add(wheel);
    });

    // Side-view logo texture on both sides (left and right)
    var sideTex = _getSideTexture(make);
    if (sideTex) {
        var sideGeo = new THREE.PlaneGeometry(l * 0.9, h * 0.7);
        var sideMat = new THREE.MeshBasicMaterial({ map: sideTex, transparent: true });
        var sideL = new THREE.Mesh(sideGeo, sideMat);
        sideL.position.set(0, h / 2, w / 2 + 0.01);
        group.add(sideL);
        var sideR = new THREE.Mesh(sideGeo.clone(), sideMat);
        sideR.position.set(0, h / 2, -w / 2 - 0.01);
        sideR.rotation.y = Math.PI;
        group.add(sideR);
    }

    // Headlights (front) + taillights (rear)
    var hlGeo = new THREE.SphereGeometry(0.3, 6, 4);
    var hlMat = new THREE.MeshPhongMaterial({ color: 0xffffe0, emissive: 0xffffaa, emissiveIntensity: 0.5 });
    var tlMat = new THREE.MeshPhongMaterial({ color: 0xff0000, emissive: 0xff0000, emissiveIntensity: 0.3 });
    [[w/2+0.01, h*0.6], [-w/2-0.01, h*0.6]].forEach(function(pos) {
        var isFront = pos[0] > 0;
        [-w*0.25, w*0.25].forEach(function(zoff) {
            var light = new THREE.Mesh(hlGeo, isFront ? hlMat : tlMat);
            light.position.set(pos[0] * (isFront ? 1 : -1) + (isFront ? l/2 : -l/2), pos[1] * 0.5, zoff);
            group.add(light);
        });
