    _airAddGroundGrid();
    console.log('[AirScene] Fallback: ' + idx + ' road-local buildings');
}

function _airAddGroundGrid() {
    var mat = new THREE.LineBasicMaterial({ color: 0x3a6080, opacity: 0.08, transparent: true });
    var pts = [];
    // Grid in road-local space: X=along road, Z=perpendicular
    for (var gx = -950; gx <= 950; gx += 60) {
        pts.push(new THREE.Vector3(gx, 0.1, -250)); pts.push(new THREE.Vector3(gx, 0.1, 250));
