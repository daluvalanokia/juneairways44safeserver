}

// ── _airRenderBuilding ──────────────────────────────────────────────────
// Adds a building to airRoadGroup3 (same group as the road/bridge), using
// ROAD-LOCAL coordinates so it always aligns with the highway regardless of bearing.
//
// Road-local space:
//   X-axis = ALONG the highway (road runs from -900 to +900 in X)
//   Z-axis = PERPENDICULAR to highway (negative Z = "behind" the road = buildings side)
//   Y-axis = vertical (up)
//
// roadX: position along highway (-900..+900)
// roadZ: perpendicular offset from road centre (negative = one side, positive = other)
// widthM, depthM: real-world metres → scaled to 3D units via (XZ_SCALE/111000)
function _airRenderBuilding(roadX, roadZ, widthM, depthM, heightM, name, idx) {
    var hScale = _airHeightScale();
    var hUnits = Math.max(4, heightM * hScale);
    var mpu    = XZ_SCALE / 111000;
    var wUnits = Math.max(6, widthM  * mpu);
    var dUnits = Math.max(6, depthM  * mpu);
    var col    = _airBldColors[idx % _airBldColors.length];

    // Main building body
    var geo  = new THREE.BoxGeometry(wUnits, hUnits, dUnits);
    var mat  = new THREE.MeshPhongMaterial({
        color: col, transparent: true, opacity: 0.75, shininess: 60, flatShading: false
    });
    var mesh = new THREE.Mesh(geo, mat);
    mesh.position.set(roadX, hUnits / 2, roadZ);
    airRoadGroup3.add(mesh); _airStructures3D.push(mesh);

    // Blue nav-map edge outline
    var edges = new THREE.LineSegments(
        new THREE.EdgesGeometry(geo),
        new THREE.LineBasicMaterial({ color: 0x93c5fd, opacity: 0.55, transparent: true })
    );
    edges.position.copy(mesh.position);
    airRoadGroup3.add(edges); _airStructures3D.push(edges);

    // Flat roof cap (slightly lighter, full opacity)
    var roofGeo = new THREE.BoxGeometry(wUnits + 1, 1.2, dUnits + 1);
    var roofMat = new THREE.MeshPhongMaterial({ color: col + 0x101010, transparent: true, opacity: 0.88 });
    var roof    = new THREE.Mesh(roofGeo, roofMat);
    roof.position.set(roadX, hUnits + 0.6, roadZ);
    airRoadGroup3.add(roof); _airStructures3D.push(roof);

    // Name label (only for named OSM buildings)
    if (name) _airMakeLabel3D(name, roadX, hUnits, roadZ);
}

// Parse Overpass elements → render buildings in road-local coordinates
// airRoadGroup3 is rotated by (bearing-90)*PI/180.
// To place a building at its real GPS position within the group,
// we apply the inverse rotation to convert world-space → road-local space.
function _airRenderOSMStructures(elements) {
    _airClearStructures3D();
    // Rotation applied to airRoadGroup3
    var rot    = ((_airHwBearingDeg || 90) - 90) * Math.PI / 180;
    var cosR   = Math.cos(-rot);
    var sinR   = Math.sin(-rot);

    var count  = 0;
    elements.forEach(function(el, idx) {
        if (el.type !== 'way' || !el.geometry || el.geometry.length < 3) return;

        // Footprint centroid + bounding box
        var sumLat = 0, sumLon = 0;
        var minLat = 90, maxLat = -90, minLon = 180, maxLon = -180;
        el.geometry.forEach(function(pt) {
            sumLat += pt.lat; sumLon += pt.lon;
            if (pt.lat < minLat) minLat = pt.lat; if (pt.lat > maxLat) maxLat = pt.lat;
            if (pt.lon < minLon) minLon = pt.lon; if (pt.lon > maxLon) maxLon = pt.lon;
        });
        var n    = el.geometry.length;
        var cLat = sumLat / n, cLon = sumLon / n;

        // World-space position via norm()
        var pw = norm(cLat, cLon);
        // Skip if far from road centre in world space
        if (Math.abs(pw.x) > 1400 || Math.abs(pw.z) > 1400) return;

        // Convert to road-local space (inverse rotation of airRoadGroup3)
        var roadX = pw.x * cosR - pw.z * sinR;
        var roadZ = pw.x * sinR + pw.z * cosR;

        // Footprint dimensions in metres
        var widthM = Math.abs(maxLon - minLon) * 111000 * Math.cos(cLat * Math.PI / 180);
        var depthM = Math.abs(maxLat - minLat) * 111000;
        if (widthM < 3 || depthM < 3) return;

        // Height from OSM tags
        var heightM = 0;
        if (el.tags) {
            heightM = parseFloat(el.tags.height) || 0;
            if (!heightM && el.tags['building:levels'])
                heightM = (parseInt(el.tags['building:levels']) || 1) * 3.5;
        }
        if (!heightM || heightM < 3) heightM = 8 + Math.random() * 18;

        var name = (el.tags && el.tags.name) ? el.tags.name : null;
        _airRenderBuilding(roadX, roadZ, widthM, depthM, heightM, name, idx);
        count++;
    });
    _airAddGroundGrid();
    console.log('[AirScene] OSM: ' + count + ' buildings in road-local space');
}

// Fallback: synthetic buildings distributed ALONG the bridge path via norm()
function _airBuildFallbackStructures() {
    _airClearStructures3D();
    // Road runs from X=-900 to X=+900 in road-local space (airRoadGroup3).
    // Buildings are placed at perpendicular offsets (Z-axis in road-local space).
    // Negative Z = one side of highway, Positive Z = other side.
    // Both sides are "behind" the road relative to the side-view camera.
    var idx = 0;
    var roadLen = 1800;
    var cols = 10;     // clusters along the road
    var step = roadLen / cols;

    for (var c = 0; c < cols; c++) {
        var roadX = -900 + step * c + step * 0.5 + (Math.random() - 0.5) * 40;

        // Side A: Z=-80..-160 (one side of highway)
        [ -85, -130, -175 ].forEach(function(rz) {
            var hM = 10 + Math.random() * 35;
            var wM = 25 + Math.random() * 45;
            var dM = 20 + Math.random() * 35;
            _airRenderBuilding(roadX + (Math.random()-0.5)*30, rz + (Math.random()-0.5)*20, wM, dM, hM, null, idx++);
        });

        // Side B: Z=+80..+160 (other side of highway)
        [ 85, 130, 175 ].forEach(function(rz) {
            var hM = 10 + Math.random() * 35;
            var wM = 25 + Math.random() * 45;
            var dM = 20 + Math.random() * 35;
            _airRenderBuilding(roadX + (Math.random()-0.5)*30, rz + (Math.random()-0.5)*20, wM, dM, hM, null, idx++);
        });
