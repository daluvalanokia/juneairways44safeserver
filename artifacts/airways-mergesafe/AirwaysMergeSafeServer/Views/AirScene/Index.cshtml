        _airPhi = Math.max(0.08, Math.min(Math.PI/2 - 0.05, _airPhi - dy * 0.005));
    });
    _air3dCanvas.addEventListener('mouseup', function() { drag.on = false; });
    _air3dCanvas.addEventListener('mouseleave', function() { drag.on = false; });
    _air3dCanvas.addEventListener('wheel', function(e) {
        e.preventDefault(); e.stopPropagation();
        _airRadius = Math.max(40, Math.min(800, _airRadius + e.deltaY * 0.35));
        _airSyncZoom();
    }, { passive: false });

    // Leaflet map event — keep map+3D in sync
    if (typeof _airMap !== 'undefined' && _airMap) {
        _airMap.on('zoomend moveend', function() {
            var zoom = _airMap.getZoom();
            _airRadius = Math.max(40, Math.min(800, 600 / Math.pow(2, zoom - 10)));
