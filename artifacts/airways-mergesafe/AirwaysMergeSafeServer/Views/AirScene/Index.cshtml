// ══════════════════════════════════════════════════════════════════════════════
// REAL 3D STRUCTURES — fetched via .NET proxy → Overpass OSM API
// All buildings positioned with norm() — aligned to the bridge coordinate system
// ══════════════════════════════════════════════════════════════════════════════
var _airStructures3D    = [];
var _airStructureLabels = [];
var _airOSMLoaded       = false;

function _airClearStructures3D() {
    _airStructures3D.forEach(function(m) { airScene3.remove(m); });
    _airStructures3D = [];
    _airStructureLabels.forEach(function(s) { airScene3.remove(s); });
    _airStructureLabels = [];
}

var _airBldColors = [0x4a7a9b, 0x5b8fa8, 0x3d6b8a, 0x6a9ab0, 0x476d84, 0x527d94, 0x3f6070, 0x648ba0];

function _airHeightScale() {
    var unitsPerMeter = XZ_SCALE / 111000;
    return Math.max(0.08, unitsPerMeter * 6);
}

function _airMakeLabel3D(text, x, topY, z) {
    var lc = document.createElement('canvas');
    lc.width = 256; lc.height = 56;
    var lctx = lc.getContext('2d');
    lctx.fillStyle = 'rgba(10,20,40,0.82)';
    lctx.beginPath(); lctx.roundRect(2, 2, 252, 52, 8); lctx.fill();
    lctx.strokeStyle = 'rgba(96,165,250,0.7)';
    lctx.lineWidth = 1.5;
    lctx.beginPath(); lctx.roundRect(2, 2, 252, 52, 8); lctx.stroke();
    lctx.font = 'bold 20px Arial';
    lctx.fillStyle = '#93c5fd';
    lctx.textAlign = 'center'; lctx.textBaseline = 'middle';
