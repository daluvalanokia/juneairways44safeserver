    // ── Vehicle ID + maker logo label sprite ──
    // Floating canvas-textured sprite above the vehicle. NOT added to the
    // vehicle group — it's added to the scene directly so it doesn't rotate
    // with the vehicle and always stays above it. Positioned in _animateAir3D.
    var vidShort = (vd && vd.vid) ? vd.vid.slice(0, 14) : '';
    var makeName = (vd && vd.make) ? vd.make : '';
    var badge = AIR_BRAND_BADGES[makeName];
    var logoImg = AIR_BRAND_LOGO_IMAGES[makeName];

    // High-res canvas for crisp text at distance
    var labelCanvas = document.createElement('canvas');
    labelCanvas.width = 512; labelCanvas.height = 128;
    var lx = labelCanvas.getContext('2d');

    // Background pill (darker for readability)
    lx.fillStyle = 'rgba(15, 20, 35, 0.92)';
    lx.beginPath();
    lx.roundRect(6, 12, 500, 104, 16);
    lx.fill();
    lx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
    lx.lineWidth = 2.5;
    lx.stroke();

    // Maker logo on the left (larger)
    if (logoImg && logoImg.complete && logoImg.naturalWidth > 0) {
        lx.save();
        lx.beginPath();
        lx.arc(56, 64, 38, 0, Math.PI * 2);
        lx.clip();
        lx.drawImage(logoImg, 18, 26, 76, 76);
        lx.restore();
        lx.beginPath();
        lx.arc(56, 64, 40, 0, Math.PI * 2);
        lx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
        lx.lineWidth = 2;
        lx.stroke();
    } else if (badge) {
        lx.beginPath();
        lx.arc(56, 64, 35, 0, Math.PI * 2);
        lx.fillStyle = badge.color;
        lx.fill();
        lx.strokeStyle = 'rgba(255, 255, 255, 0.6)';
        lx.lineWidth = 2.5;
        lx.stroke();
        lx.fillStyle = '#fff';
        lx.font = 'bold 28px Arial';
        lx.textAlign = 'center';
        lx.textBaseline = 'middle';
        lx.fillText(badge.initials.slice(0, 3), 56, 66);
    }

    // Vehicle ID text (bold, white, larger)
    lx.fillStyle = '#ffffff';
    lx.font = 'bold 30px monospace';
    lx.textAlign = 'left';
    lx.textBaseline = 'middle';
    lx.fillText(vidShort, 110, 42);

    // Make name + category (light grey)
    var catName = vc ? vc.category : '';
    var subText = makeName + (makeName && catName ? ' · ' : '') + catName;
    lx.fillStyle = 'rgba(210, 220, 235, 0.95)';
    lx.font = '22px Arial';
    lx.fillText(subText.slice(0, 26), 110, 84);

    // Speed badge (amber, right side)
    if (vd && vd.speedMph) {
        var spdText = Math.round(vd.speedMph) + ' mph';
        lx.fillStyle = 'rgba(253, 224, 71, 1.0)';
        lx.font = 'bold 22px monospace';
        lx.textAlign = 'right';
        lx.fillText(spdText, 494, 64);
    }

    var labelTex = new THREE.CanvasTexture(labelCanvas);
    labelTex.needsUpdate = true;
    labelTex.minFilter = THREE.LinearFilter;
    labelTex.magFilter = THREE.LinearFilter;
    var labelMat = new THREE.SpriteMaterial({
        map: labelTex, transparent: true, depthTest: false,
        depthWrite: false, sizeAttenuation: true
    });
    var labelSprite = new THREE.Sprite(labelMat);
    labelSprite.scale.set(50, 12.5, 1);
    labelSprite.renderOrder = 999;
    // Do NOT add to group — add to scene directly so it doesn't rotate
    // with the vehicle. Position is updated in _animateAir3D.
    group.userData.labelSprite = labelSprite;
    group.userData.labelHeight = h + 6;

    return group;
}

// Build or update 3D mesh from vehicleData
// ── Compute 3D bounds of the bridge path for vehicle containment ──
// Returns { minX, maxX, minZ, maxZ } in 3D scene coordinates using norm().
var _3DBridgeBoundsCache = null;
function _airGetBridgeBounds() {
    if (_3DBridgeBoundsCache) return _3DBridgeBoundsCache;
    var r = { minX: -900, maxX: 900, minZ: -900, maxZ: 900 };
    if (!_airBridgePathCoords || _airBridgePathCoords.length < 2) return r;
    var minX = Infinity, maxX = -Infinity, minZ = Infinity, maxZ = -Infinity;
    for (var i = 0; i < _airBridgePathCoords.length; i++) {
        var p = norm(_airBridgePathCoords[i].lat, _airBridgePathCoords[i].lon);
        if (p.x < minX) minX = p.x;
        if (p.x > maxX) maxX = p.x;
        if (p.z < minZ) minZ = p.z;
        if (p.z > maxZ) maxZ = p.z;
    }
    r = { minX: minX, maxX: maxX, minZ: minZ, maxZ: maxZ };
    _3DBridgeBoundsCache = r;
    return r;
}

function _syncAirMeshes() {
    // Remove stale meshes (vehicle no longer in vehicleData)
    airVehicleMeshes3 = airVehicleMeshes3.filter(function(m) {
        if (!vehicleData.has(m.userData.vid)) {
            if (m.userData.labelSprite) airScene3.remove(m.userData.labelSprite);
            airScene3.remove(m);
            return false;
        }
        return true;
    });
    // Add new meshes for vehicles not yet in the 3D scene
    vehicleData.forEach(function(vd, vid) {
        var exists = airVehicleMeshes3.find(function(m){ return m.userData.vid === vid; });
        if (!exists) {
            var mesh = _makeAir3DVehicle(vd.ev, vd.vc, vd);

            // ── Position vehicle along the 3D road based on its relative ──
            // ── position along the highway bridge path ───────────────────
            // The 3D road spans -850 to +850 units. Map the vehicle's GPS
            // position to a fraction (0..1) along the bridge path, then
            // scale to the 3D road range.
            // ── Position vehicle using norm() — maps GPS to 3D coords ──
            // norm() uses midLat/midLon (zone/server GPS) as origin and
            // XZ_SCALE (fits bridge path to ±900). This places the vehicle
            // at the correct 3D coordinate matching its GPS on the map.
            var p3 = norm(vd.lat, vd.lon);

            // Lane offset: perpendicular to road direction
            var spd3 = vd.speedMph || 30;
            var dir3v = vd.direction || _airHwBearingDeg || 0;
            if (dir3v < 0 || isNaN(dir3v)) dir3v = _airHwBearingDeg || 90;
            var rad3 = dir3v * Math.PI / 180;

            // ── Bearing-based velocity decomposition (matches 2D overlay) ──
            // bearing 0°=N → +Z, 90°=E → +X, 180°=S → -Z, 270°=W → -X
            var vx3 = spd3 * 0.025 * Math.sin(rad3);
            var vz3 = spd3 * 0.025 * Math.cos(rad3);

            // Perpendicular lane offset (perpendicular to bearing)
            var perpRad = rad3 + Math.PI / 2;
            var laneOff = (Math.random() - 0.5) * _airRoadWidth3D * 0.7;
            var laneX = Math.cos(perpRad) * laneOff;
            var laneZ = -Math.sin(perpRad) * laneOff;

            // Clamp initial position to bridge path bounds
            var bp3 = _airGetBridgeBounds();
            var px = Math.max(bp3.minX, Math.min(bp3.maxX, p3.x + laneX));
            var pz = Math.max(bp3.minZ, Math.min(bp3.maxZ, p3.z + laneZ));

            mesh.position.set(px, 0, pz);
            mesh.rotation.y = -(dir3v - 90) * Math.PI / 180;
            mesh.userData = { vid: vid, vx: vx3, vz: vz3,
                              laneX: laneX, laneZ: laneZ,
                              baseY: 0, phase: Math.random() * Math.PI * 2,
                              spd: spd3, dir: dir3v };
            airScene3.add(mesh);
            airVehicleMeshes3.push(mesh);
        }
    });
}

// 3D animate loop
var _3dAnimRunning = false;
var _tick3 = 0;
function _animateAir3D() {
    if (!_3dAnimRunning) return;
    requestAnimationFrame(_animateAir3D); _tick3++;

    // ── Periodically sync new vehicles from vehicleData into 3D meshes ──
    // This picks up simulation vehicles that arrived via loadEvents after
    // the 3D view was activated. Throttled to every ~0.5s (30 frames).
    if (_tick3 % 30 === 0) {
        _syncAirMeshes();
    }

    // Fixed camera angle — aligned to highway bearing, gentle tilt
    // No orbit: camera stays at a constant angle to maintain alignment
    _updateCamera3D();

    // ── Velocity-driven vehicle movement (3D scene scale) ──
    // The 3D road is 1800 units long. Vehicles move at speed * 0.025
    // units/frame, so 60mph → 1.5 units/frame → ~90 units/sec.
    // This gives visible, smooth movement across the 3D road.
    // Live speed/direction from sim data is read back each frame.
    airVehicleMeshes3.forEach(function(m) {
        var ud = m.userData;
        var vd = vehicleData.get(ud.vid);

        // ── Update velocity from live sim data using bearing decomposition ──
        if (vd) {
            var spd = vd.speedMph || 0;
            var dir = vd.direction || _airHwBearingDeg || 0;
            if (dir < 0 || isNaN(dir)) dir = _airHwBearingDeg || 90;
            ud.spd = spd;
            ud.dir = dir;
            // Bearing 0°=N→+Z, 90°=E→+X, 180°=S→-Z, 270°=W→-X
            var rad = dir * Math.PI / 180;
            ud.vx = spd * 0.025 * Math.sin(rad);
            ud.vz = spd * 0.025 * Math.cos(rad);
            // Update rotation to match direction from input data
            m.rotation.y = -(dir - 90) * Math.PI / 180;
        }

        // Move vehicle in 3D scene coordinates — both X and Z from bearing
        m.position.x += ud.vx;
        m.position.z += ud.vz;
        // Gentle lane keeping — nudge toward lane offset
        m.position.x += (ud.laneX - (m.position.x - ud.vx)) * 0.02;
        m.position.z += (ud.laneZ - (m.position.z - ud.vz)) * 0.02;

        // Gentle bob for visual life
        m.position.y = (ud.baseY || 0) + Math.sin(_tick3 * 0.15 + ud.phase) * 0.15;

        // ── Remove vehicles that exit bridge path coordinate bounds ──
        // Uses actual bridge path extent in 3D coordinates, not hardcoded ±880
        var bp = _airGetBridgeBounds();
        var margin = 30;  // small margin beyond path endpoints
        if (m.position.x > bp.maxX + margin || m.position.x < bp.minX - margin ||
            m.position.z > bp.maxZ + margin || m.position.z < bp.minZ - margin) {
            if (m.userData.labelSprite) airScene3.remove(m.userData.labelSprite);
            airScene3.remove(m);
            airVehicleMeshes3 = airVehicleMeshes3.filter(function(x){ return x !== m; });
        }
    });

    // Street light flicker
    if (_tick3 % 180 === 0) {
        airScene3.children.forEach(function(c) {
            if (c.userData && c.userData.isLamp) c.material.emissiveIntensity = 0.2 + Math.random() * 0.2;
        });
    }

    // ── Position and scale label sprites in scene coordinates ──
    // Labels are NOT children of the vehicle group (so they don't rotate).
    // We update their world position to follow the vehicle each frame.
    airVehicleMeshes3.forEach(function(m) {
        if (m.userData.labelSprite) {
            var spr = m.userData.labelSprite;
            // Only add to scene once
            if (!spr.parent) airScene3.add(spr);
            // Position above the vehicle in world coords
            spr.position.set(m.position.x, m.position.y + (m.userData.labelHeight || 6), m.position.z);
            // Scale based on camera distance for consistent readability
            var dist = airCamP.position.distanceTo(m.position);
            var w = Math.max(30, Math.min(80, dist * 0.22));
            spr.scale.set(w, w * 0.25, 1);
        }
    });

    // Use sceneWrap for size — canvas clientWidth always matches even at opacity:0
    var _wrap3 = document.getElementById('sceneWrap');
    var cw = _wrap3 ? _wrap3.clientWidth  : (_air3dCanvas.clientWidth  || 900);
    var ch = _wrap3 ? _wrap3.clientHeight : (_air3dCanvas.clientHeight || 520);
    if (cw > 0 && ch > 0) renderer.setSize(cw, ch, false);
    var cam = airCurrentView === 'side' ? airCamS : airCamP;
    // Update perspective camera every frame (tracks zoom/pan)
    if (airCurrentView !== 'side') _updateCamera3D();
    // Side camera: update aspect each frame, position set on view entry
    if (cam.isPerspectiveCamera) { cam.aspect = cw / Math.max(1, ch); cam.updateProjectionMatrix(); }
    renderer.render(airScene3, cam);
}

// ── 3D view: pan + proportional zoom (camera angle is FIXED) ──────────
// The camera is locked to a near-top-down angle aligned with the highway
// bearing. This keeps the 3D road, pins, and map highway aligned at all
// times because the projection never changes.
// Drag = pan the map (midLat/midLon update → norm() repositions all 3D objects)
// Zoom = adjust airRadius3 + XZ_SCALE together → proportional scaling
var _isDrag3 = false, _prevM3 = {x:0,y:0};

// Camera angle is fixed: airTheta3 aligned to highway bearing, airPhi3 = gentle tilt
var _camPhiFixed = 0.35;   // ~20° tilt from top-down — enough 3D depth, stable alignment

function _updateCamera3D() {
    var brg = (_airHwBearingDeg || 90) * Math.PI / 180;

    // ── Perspective camera (⬡ 3D view) — top-down angled along highway ──
    var camHeight = Math.max(15, airRadius3 * Math.sin(_camPhiFixed));
    var camHoriz  = airRadius3 * Math.cos(_camPhiFixed);
    airCamP.position.x = -camHoriz * Math.sin(brg - Math.PI / 2);
    airCamP.position.y = camHeight;
    airCamP.position.z = -camHoriz * Math.cos(brg - Math.PI / 2);
    airCamP.lookAt(0, 0, 0);
}

// ── Side view camera setup — called once when entering side view ──────────
// Navigation-map style: camera south of highway, low angle, looking north
// so the highway bridge is at the bottom-front of frame and OSM buildings
// recede into the background behind the highway.
// ── _setSideCameraForView ────────────────────────────────────────────────
// Side / navigation-map camera:
//   • Highway bridge runs along the bottom of the frame (road-local X-axis)
//   • Structures appear behind the highway (road-local -Z direction = "north" of road)
//   • Camera sits at road-local +Z (south of road) at a low elevation angle
//
// airRoadGroup3 is rotated by (bearing-90)*PI/180 so its local X-axis
// aligns with the highway bearing in world space.
// Camera position in world space:
//   perpendicular to bearing = bearing + 90° = bearing - 90° + 180°
//   We use (bearing + PI/2) as the camera azimuth.
function _setSideCameraForView() {
    var brg    = (_airHwBearingDeg || 90) * Math.PI / 180;
    var camAz  = brg + Math.PI / 2;    // 90° offset = perpendicular to highway, camera side

    var dist   = Math.max(220, airRadius3 * 1.0);
    var height = Math.max(55, airRadius3 * 0.28);

    // Camera world position: perpendicular to highway, at height
    airCamS.position.x = dist * Math.sin(camAz);
    airCamS.position.y = height;
    airCamS.position.z = dist * Math.cos(camAz);

    // Look toward the road centre, angled slightly downward
    // Target is slightly on the building side (negative perpendicular) so
    // the road appears at the bottom and buildings fill the upper frame
    var tgtAz  = camAz + Math.PI;     // opposite side = toward buildings
    var tgtDist = 40;
    airCamS.lookAt(
        tgtDist * Math.sin(tgtAz),
        6,
        tgtDist * Math.cos(tgtAz)
    );

    airCamS.fov    = 55;
    airCamS.near   = 0.5;
    airCamS.far    = 5000;
    airCamS.aspect = _air3dCanvas.clientWidth / Math.max(1, _air3dCanvas.clientHeight);
    airCamS.updateProjectionMatrix();
    console.log('[AirScene] Side cam: dist=' + dist.toFixed(0) + ' h=' + height.toFixed(0)
              + ' az=' + (camAz * 180/Math.PI).toFixed(1) + '° brg=' + (_airHwBearingDeg||90).toFixed(1) + '°');
}

_air3dCanvas.addEventListener('mousedown', function(e) {
    e.preventDefault();
    e.stopPropagation();
    _isDrag3 = true;
    _prevM3 = {x:e.clientX, y:e.clientY};
    _air3dCanvas.style.cursor = 'grabbing';
}, { passive: false });
window.addEventListener('mouseup', function() {
    if (_isDrag3) { _isDrag3 = false; _air3dCanvas.style.cursor = 'grab'; }
});
window.addEventListener('mousemove', function(e) {
    if (!_isDrag3) return;
    e.preventDefault();
    // ── Drag = PAN the map (not orbit) ──
    // Convert screen pixel delta to GPS degrees and update center.
    // All 3D objects use norm() with midLat/midLon, so they follow.
    var dx = e.clientX - _prevM3.x;
    var dy = e.clientY - _prevM3.y;
    _prevM3 = {x:e.clientX, y:e.clientY};
    if (!_map) return;
    var zoom = _map.getZoom();
    var metersPerPixel = 156543.03392 * Math.cos(_airMapCtrLat * Math.PI / 180) / Math.pow(2, zoom);
    var dLat = -(dy * metersPerPixel) / 111000;
    var dLon = -(dx * metersPerPixel) / (111000 * Math.cos(_airMapCtrLat * Math.PI / 180));
    _airMapCtrLat += dLat; _airMapCtrLon += dLon;
    midLat = _airMapCtrLat; midLon = _airMapCtrLon;
    _map.setView([_airMapCtrLat, _airMapCtrLon], zoom, { animate: false });
    // Reposition pins to follow the pan
    _update3DZoneMarkers();
    // Invalidate bridge bounds cache (positions changed via norm())
    _3DBridgeBoundsCache = null;
});
_air3dCanvas.addEventListener('wheel', function(e) {
    e.preventDefault();
    e.stopPropagation();
    // ── Zoom = proportional scaling of 3D scene + map ──
    var oldR = airRadius3;
    airRadius3 = Math.max(40, Math.min(700, airRadius3 + e.deltaY * 0.3));
    if (airRadius3 === oldR) return;
    // Adjust XZ_SCALE proportionally so the 3D road geographic extent
    // matches the map's visible area at the new zoom level
    _syncZoomAndScale3D();
}, { passive: false });
// Touch support
var _touchPrev = null, _touchDist = null;
_air3dCanvas.addEventListener('touchstart', function(e) {
    if (e.touches.length === 1) {
        _touchPrev = {x: e.touches[0].clientX, y: e.touches[0].clientY};
        _isDrag3 = true;
    } else if (e.touches.length === 2) {
        _isDrag3 = false;
        var dx = e.touches[0].clientX - e.touches[1].clientX;
        var dy = e.touches[0].clientY - e.touches[1].clientY;
        _touchDist = Math.sqrt(dx*dx + dy*dy);
    }
    e.preventDefault();
}, { passive: false });
_air3dCanvas.addEventListener('touchmove', function(e) {
    if (e.touches.length === 1 && _isDrag3) {
        var dx = e.touches[0].clientX - _touchPrev.x;
        var dy = e.touches[0].clientY - _touchPrev.y;
        _touchPrev = {x: e.touches[0].clientX, y: e.touches[0].clientY};
        if (!_map) return;
        var zoom = _map.getZoom();
        var mpp = 156543.03392 * Math.cos(_airMapCtrLat * Math.PI / 180) / Math.pow(2, zoom);
        _airMapCtrLat += -(dy * mpp) / 111000;
        _airMapCtrLon += -(dx * mpp) / (111000 * Math.cos(_airMapCtrLat * Math.PI / 180));
        midLat = _airMapCtrLat; midLon = _airMapCtrLon;
        _map.setView([_airMapCtrLat, _airMapCtrLon], zoom, { animate: false });
        _update3DZoneMarkers();
        _3DBridgeBoundsCache = null;
    } else if (e.touches.length === 2 && _touchDist) {
        var dx = e.touches[0].clientX - e.touches[1].clientX;
        var dy = e.touches[0].clientY - e.touches[1].clientY;
        var d = Math.sqrt(dx*dx + dy*dy);
        airRadius3 = Math.max(40, Math.min(700, airRadius3 + (_touchDist - d) * 0.5));
        _touchDist = d;
        _syncZoomAndScale3D();
    }
    e.preventDefault();
}, { passive: false });
_air3dCanvas.addEventListener('touchend', function() {
    _isDrag3 = false; _touchPrev = null; _touchDist = null;
});
_air3dCanvas.style.cursor = 'grab';

// ── Unified zoom+scale sync: adjusts XZ_SCALE + map zoom together ──
function _syncZoomAndScale3D() {
    if (!_map || !_airBridgePathCoords || _airBridgePathCoords.length < 2) {
        _syncMapZoom3D();
        return;
    }
    // Compute the map zoom from airRadius3
    var r = (airRadius3 - 40) / (700 - 40);
    var baseZoom = 18 - r * 9;
    var scaleAdj = Math.log(XZ_SCALE / 800) / Math.LN2 * 0.6;
    var z = Math.round(baseZoom - scaleAdj);
    z = Math.max(8, Math.min(18, z));
    if (z !== _map.getZoom()) {
        _map.setZoom(z, { animate: false });
    }
    // Recompute XZ_SCALE so the 3D road matches the map's visible area
    var ctrLat = midLat, ctrLon = midLon;
    var maxAbs = 0;
    for (var i = 0; i < _airBridgePathCoords.length; i++) {
        var dLat = Math.abs(_airBridgePathCoords[i].lat - ctrLat);
        var dLon = Math.abs(_airBridgePathCoords[i].lon - ctrLon);
        if (dLat > maxAbs) maxAbs = dLat;
        if (dLon > maxAbs) maxAbs = dLon;
    }
    if (maxAbs > 0.0001) {
        XZ_SCALE = 900 / maxAbs;
    }
    // Rebuild road + reposition pins + invalidate bounds
    _airBuildRoad3D();
    _3DBridgeBoundsCache = null;
    _update3DZoneMarkers();
    // Reposition vehicles
    airVehicleMeshes3.forEach(function(m) {
        var vd = vehicleData.get(m.userData.vid);
        if (vd) {
            var p = norm(vd.lat, vd.lon);
            var bp = _airGetBridgeBounds();
            m.position.x = Math.max(bp.minX, Math.min(bp.maxX, p.x));
            m.position.z = Math.max(bp.minZ, Math.min(bp.maxZ, p.z));
        }
    });
    // Update road rotation to match bearing
    airRoadGroup3.rotation.y = ((_airHwBearingDeg || 90) - 90) * Math.PI / 180;
    _updateLocationBadge();
}


// ── View toggle ───────────────────────────────────────────────────────
function setViewport(view) {
    airCurrentView = view;
    var is2D = (view === 'top');

    // ── Canvas visibility ─────────────────────────────────────────────────
    // NEVER use display:none on _air3dCanvas — it zeroes clientWidth/clientHeight
    // and breaks WebGL. Use opacity + pointerEvents instead.
    // Top view  : 3D canvas invisible (opacity:0), 2D overlay shown
    // 3D views  : 3D canvas fully visible, 2D overlay hidden
    _air3dCanvas.style.opacity        = is2D ? '0'    : '1';
    _air3dCanvas.style.pointerEvents  = is2D ? 'none' : 'auto';
    _oc.style.display                 = is2D ? 'block' : 'none';

    // ── Map opacity — let OSM tiles show through at calibrated level ──────
    // Top view:         full opacity  (map IS the view)
    // Side view:        45% — buildings render over it, map provides geo context
    // Perspective/3D:   30% — subtle geo reference only
    // Split:            40% — balanced
    var mapOpacity = is2D ? '1.0'
        : view === 'side'        ? '0.45'
        : view === 'perspective' ? '0.30'
        : /* split */              '0.40';
    var mapEl = document.getElementById('airMiniMap');
    if (mapEl) { mapEl.style.visibility = 'visible'; mapEl.style.opacity = mapOpacity; }

    // ── THREE.js render loop ──────────────────────────────────────────────
    if (!is2D && !_3dAnimRunning) {
        // Resize canvas to container size (clientWidth reliable even at opacity:0)
        var _sw = document.getElementById('sceneWrap');
        var _rw = _sw ? _sw.clientWidth  : 900;
        var _rh = _sw ? _sw.clientHeight : 520;
        _air3dCanvas.width  = _rw;
        _air3dCanvas.height = _rh;
        renderer.setSize(_rw, _rh, false);
        _3dAnimRunning = true;
        _syncAirMeshes();
        _animateAir3D();
    } else if (is2D && _3dAnimRunning) {
        _3dAnimRunning = false;
        renderer.clear();
    }

    // ── Map interaction ───────────────────────────────────────────────────
    if (_map) {
        if (is2D) {
            _map.dragging.enable();
            _map.getContainer().style.pointerEvents = 'auto';
        } else {
            _map.dragging.disable();
            _map.getContainer().style.pointerEvents = 'none';
            _centerMapOnHighway();
            _syncMapZoom3D();
        }
    }

    // ── Sky dome — hide in side view so OSM map shows as true background ──
    var skyDomeObj = airScene3.getObjectByName('airSkyDome');
    if (skyDomeObj) skyDomeObj.visible = (view !== 'side');

    // ── Side-view specific: set camera for nav-map look ───────────────────
    if (view === 'side') {
        _setSideCameraForView();
        // Fetch/refresh OSM structures when entering side view
        if (!_airOSMLoaded || view !== window._prevAirView) _airRebuildStructures();
    }
    window._prevAirView = view;   // module-level tracking for OSM reload guard

    // ── Location badge ────────────────────────────────────────────────────
    var locBadge = document.getElementById('airLocationBadge');
    if (locBadge) {
        locBadge.style.display = is2D ? 'none' : '';
        _updateLocationBadge();
    }

    // ── Split labels ──────────────────────────────────────────────────────
    ['labelA','labelB','labelC'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = view === 'split' ? '' : 'none';
    });

    _bridgeDirty = true;
    if (_map) _map.invalidateSize();
    console.log('[AirScene] Viewport set: ' + view);
}

// ── Center the Leaflet map on the selected zone/server GPS ──
// The 3D scene origin (0,0,0) represents the zone/server coordinate.
// The bridge path extends in both directions from this center point.
// XZ_SCALE is adjusted so the full bridge path fits within the 3D road
// (±900 units), making the 3D animation align with the map highway.
function _centerMapOnHighway() {
    if (!_map) return;

    // ── 1. Find the selected zone/server GPS as the center ──
    var ctrLat = _airMapCtrLat, ctrLon = _airMapCtrLon;
    if (selectedZoneId && AIR_ZONES && AIR_ZONES.length) {
        var z = AIR_ZONES.find(function(zz){ return zz.zoneId === selectedZoneId; });
        if (z && z.lat && z.lon) { ctrLat = z.lat; ctrLon = z.lon; }
    }

    // ── 2. Compute bridge path span from center and set XZ_SCALE ──
    // XZ_SCALE maps GPS degrees → 3D units. We want the furthest bridge
    // path point from center to map to ±900 (the 3D road half-length).
    if (_airBridgePathCoords && _airBridgePathCoords.length >= 2) {
        var maxAbs = 0;
        for (var i = 0; i < _airBridgePathCoords.length; i++) {
            var dLat = Math.abs(_airBridgePathCoords[i].lat - ctrLat);
            var dLon = Math.abs(_airBridgePathCoords[i].lon - ctrLon);
            if (dLat > maxAbs) maxAbs = dLat;
            if (dLon > maxAbs) maxAbs = dLon;
        }
        if (maxAbs > 0.0001) {
            XZ_SCALE = 900 / maxAbs;
        }
    }

    // ── 3. Update all coordinate globals ──
    _airMapCtrLat = ctrLat; _airMapCtrLon = ctrLon;
    midLat = ctrLat; midLon = ctrLon;

    _map.setView([ctrLat, ctrLon], _map.getZoom(), { animate: false });
    console.log('[T3D] Aligned: center=(' + ctrLat.toFixed(4) + ',' + ctrLon.toFixed(4) +
                ') XZ_SCALE=' + XZ_SCALE.toFixed(1) + ' bridgePts=' + (_airBridgePathCoords||[]).length);

    // ── 4. Rebuild road + draw highway polyline + update pins ──
    if (typeof _airBuildRoad3D === 'function') _airBuildRoad3D();
    if (typeof _drawHwyPolyline === 'function') _drawHwyPolyline();
    _3DBridgeBoundsCache = null;
    _update3DZoneMarkers();
    // Update road rotation to match bearing
    airRoadGroup3.rotation.y = ((_airHwBearingDeg || 90) - 90) * Math.PI / 180;

    // ── 5. Sync map zoom to current 3D camera distance ──
    _syncMapZoom3D();
}

// ── 3D zone marker pins ──
// Places a visible marker (pole + sphere) at each bridge path coordinate
// projected onto the 3D road, showing where each highway zone is located.
var _zoneMarkers3D = [];
function _update3DZoneMarkers() {
    // Remove old markers from airScene3 (NOT airRoadGroup3 — pins are in world coords)
    _zoneMarkers3D.forEach(function(m) { airScene3.remove(m); });
    _zoneMarkers3D = [];
    if (!_airBridgePathCoords || _airBridgePathCoords.length < 2) return;

    // Center pin: green pole+sphere at origin (zone/server GPS = 3D origin)
    var ctrPole = new THREE.Mesh(
        new THREE.CylinderGeometry(0.5, 0.5, 12, 8),
        new THREE.MeshPhongMaterial({ color: 0x00ff88, emissive: 0x004422, emissiveIntensity: 0.4 }));
    ctrPole.position.set(0, 6, 0);
    airScene3.add(ctrPole); _zoneMarkers3D.push(ctrPole);
    var ctrSph = new THREE.Mesh(
        new THREE.SphereGeometry(2, 10, 8),
        new THREE.MeshPhongMaterial({ color: 0x00ff88, emissive: 0x008844, emissiveIntensity: 0.5 }));
    ctrSph.position.set(0, 13, 0);
    airScene3.add(ctrSph); _zoneMarkers3D.push(ctrSph);

    // Bridge path pins at world coords via norm() — added to airScene3
    // so they stay at correct GPS positions regardless of road rotation
    for (var i = 0; i < _airBridgePathCoords.length; i++) {
        var bp = _airBridgePathCoords[i];
        var p = norm(bp.lat, bp.lon);
        if (i > 0 && i < _airBridgePathCoords.length - 1 && i % 5 !== 0) continue;
        var pole = new THREE.Mesh(
            new THREE.CylinderGeometry(0.3, 0.3, 8, 6),
            new THREE.MeshPhongMaterial({ color: 0xffd700 }));
        pole.position.set(p.x, 4, p.z);
        airScene3.add(pole); _zoneMarkers3D.push(pole);
        var sph = new THREE.Mesh(
            new THREE.SphereGeometry(1.2, 8, 6),
            new THREE.MeshPhongMaterial({ color: 0xffd700, emissive: 0x442200, emissiveIntensity: 0.3 }));
        sph.position.set(p.x, 9, p.z);
        airScene3.add(sph); _zoneMarkers3D.push(sph);
    }

    // Endpoint pins: red=start, green=end of highway bridge
    var p0 = norm(_airBridgePathCoords[0].lat, _airBridgePathCoords[0].lon);
    var pN = norm(_airBridgePathCoords[_airBridgePathCoords.length-1].lat, _airBridgePathCoords[_airBridgePathCoords.length-1].lon);
    [{p: p0, c: 0xff4444}, {p: pN, c: 0x44ff44}].forEach(function(ep) {
        var eMesh = new THREE.Mesh(
            new THREE.CylinderGeometry(0.6, 0.6, 10, 8),
            new THREE.MeshPhongMaterial({ color: ep.c, emissive: ep.c, emissiveIntensity: 0.2 }));
        eMesh.position.set(ep.p.x, 5, ep.p.z);
        airScene3.add(eMesh); _zoneMarkers3D.push(eMesh);
    });
    console.log('[T3D] Zone markers: ' + _zoneMarkers3D.length + ' placed (center+path+endpoints)');
}

// ── Sync Leaflet map zoom with 3D camera distance (airRadius3) ──
// Maps airRadius3 range (40-700) to Leaflet zoom (18-11) so zooming
// in/out the 3D scene also zooms the map proportionally.
// _syncMapZoom3D is now handled by _syncZoomAndScale3D (unified zoom+scale)
function _syncMapZoom3D() { _syncZoomAndScale3D(); }

function _updateLocationBadge() {
    var hwyEl = document.getElementById('airLocHwy');
    var zoneEl = document.getElementById('airLocZone');
    var coordsEl = document.getElementById('airLocCoords');
    if (!hwyEl || !zoneEl || !coordsEl) return;
    var hwSelect = document.getElementById('t3dHighway');
    var hwName = '-';
    if (hwSelect && hwSelect.selectedIndex >= 0) {
        hwName = hwSelect.options[hwSelect.selectedIndex].text.trim();
    }
    if (HW) hwName = HW;
    var zoneName = '-';
    if (selectedZoneId && AIR_ZONES && AIR_ZONES.length) {
        var z = AIR_ZONES.find(function(zz){ return zz.zoneId === selectedZoneId; });
        if (z) zoneName = z.zoneName || z.zoneId || '-';
    }
    hwyEl.textContent = hwName;
    zoneEl.textContent = zoneName !== '-' ? ('Zone: ' + zoneName) : '';
    coordsEl.textContent = _airMapCtrLat.toFixed(4) + 'N, ' + _airMapCtrLon.toFixed(4) + 'W';
}

