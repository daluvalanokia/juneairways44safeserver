    });

    // ── Cameras — perspective + side (same as T3D) ────────────────────────
    _airCam  = new THREE.PerspectiveCamera(50, _air3dCanvas.clientWidth / _air3dCanvas.clientHeight, 0.1, 4000);
    _airCam.position.set(-180, 60, 110);
    _airCam.lookAt(60, 20, 0);

    _airCamSide = new THREE.OrthographicCamera(-300, 300, 100, -100, 0.1, 3000);
    _airCamSide.position.set(0, 50, 450);
    _airCamSide.lookAt(0, 20, 0);

    _airCamTop = new THREE.OrthographicCamera(-300, 300, 150, -150, 0.1, 3000);
    _airCamTop.position.set(0, 600, 0);
    _airCamTop.lookAt(0, 0, 0);

    // ── Mouse orbit (same drag behaviour as T3D) ──────────────────────────
    var drag = { on: false, x: 0, y: 0 };
    _air3dCanvas.addEventListener('mousedown', function(e) { drag.on = true; drag.x = e.clientX; drag.y = e.clientY; });
    _air3dCanvas.addEventListener('mousemove', function(e) {
        if (!drag.on) return;
        var dx = e.clientX - drag.x; var dy = e.clientY - drag.y;
        drag.x = e.clientX; drag.y = e.clientY;
