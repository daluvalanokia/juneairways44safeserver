}

// Fetch via .NET proxy (same-origin, no CORS/mixed-content issues)
async function _airFetchOSMStructures() {
    if (!midLat || !midLon) { _airBuildFallbackStructures(); return; }
    var url = '/AirScene/GetOSMBuildings?lat=' + midLat.toFixed(6) + '&lon=' + midLon.toFixed(6) + '&radius=1500';
    console.log('[AirScene] Fetching OSM via proxy: ' + url);
    try {
        var r = await fetch(url);
        if (!r.ok) throw new Error('HTTP ' + r.status);
        var data = await r.json();
        if (data.elements && data.elements.length > 0) {
            _airOSMLoaded = true;
            _airRenderOSMStructures(data.elements);
        } else {
            console.warn('[AirScene] 0 OSM buildings — fallback');
            _airBuildFallbackStructures();
        }
    } catch(e) {
        console.warn('[AirScene] Proxy failed (' + e.message + ') — fallback');
        _airBuildFallbackStructures();
    }
}

